# Node / Astro
node_modules/
dist/
.astro/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated artifacts — never hand-edited, never committed (built in CI)
site/public/data/
# Copie COMPLÈTE des geojson de carte, empaquetée dans les fonctions au build (prune_public_json.py).
site/functions/_data/

# OS
.DS_Store

# Local agent tooling (installed via: npx skills add Leonxlnx/taste-skill)
.agents/

# local Claude Code dev configs (launch.json etc.)
.claude/
**/.claude/

# pipeline HTTP cache (local runs)
.cache/
.media-sat/

# Paid-API Worker — private plumbing, never in the public repo (Franck 2026-07-23).
# On disk (the Makefile sync-api-r2 hook references it by path), but its own
# private repo; the public site repo must never track it.
/api/
.lastmod.json

# Variables locales de `wrangler dev` / `wrangler pages dev` (valeurs factices, jamais de secret).
.dev.vars
# Sortie de scripts/compare_pages_worker.py (60 000 réponses comparées, régénérable).
site/.compare-pages-worker/
