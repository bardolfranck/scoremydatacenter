---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// EN full-screen living map — twin of /fr/carte (i18n §13: shared MapIsland, per-language labels).
import Base from "../layouts/Base.astro";
import MapIsland from "../components/MapIsland.astro";

import { EN_NAV } from "../config/nav";
---

<Base
  lang="en"
  {/* "data center map" and "data center near me" are the two measurable US intents
      (Trends, 12 months to 2026-10-26: 14 and 26). The old title carried neither — it did
      not even contain "data center". This one carries both in six words. See fr/carte.astro
      for why the brand suffix is gone. */}
  title="Data center map — find the one near you"
  description="Every data center we have graded, on one map: zoom to your town, open a site and read its A–E acceptability grade — energy, water, land, local impact, with its sources."
  tagline="Independent observatory"
  altHref="/fr/carte"
  altLabel="FR"
  nav={EN_NAV}
>
  <MapIsland
    variant="full"
    labels={{
      site: "Site",
      operator: "Operator",
      confidence: { high: "confidence: high", medium: "confidence: medium", low: "confidence: low" },
      insufficient: "insufficient data",
      fixture: "Fictional test fixture",
      reserved: "· A reserved",
      probable: "probable",
      range: "range",
      ficheBase: "/dc",
      mapPath: "/map",
      // La bulle mène au PORTRAIT, pas à la fiche : un pin est un lieu, et un
      // lieu est là où quelqu'un habite. La fiche reste à un clic depuis le portrait.
      // DOUBLE ENTRÉE. Le portrait d'abord — un pin est un lieu — mais la fiche reste
      // offerte : elle est indexée par Google depuis des mois, et retirer son seul lien
      // depuis la carte reviendrait à démailler ce qui marche déjà.
      viewPortrait: "View the portrait →",
      viewFiche: "View the technical sheet →",
      powerUnknown: "power not disclosed",
      search: {
        label: "Search a town or a project on the map",
        placeholder: "Town, project, operator…",
        project: "project",
        town: "town",
        none: "No town or project by that name.",
      },
      legendGraded: "site grades",
      legendDonut: "ring = grade mix · centre = number of sites",
      legendPower: "size = power (MW) · small dot = not disclosed",
      legendWatch: "On watch — tracked, not yet graded",
      legendWatchOpp: "Local citizen opposition",
      legendWatchMor: "Moratorium (official act 🏛️)",
      watch: {
        badge: "On watch",
        note: "Tracked project; not yet graded.",
        source: "Source:",
        press: "Press: ",
        selfReported: "self-reported",
        aria: "Tracked project — contestation",
        title: "Tracked project; not yet graded",
        lang: "en",
        typeOpposition: "Local opposition",
        typeMoratorium: "Moratorium",
        filterLabel: "On watch:",
        filterAll: "All",
        filterOppositions: "Oppositions",
        filterMoratoria: "Moratoria",
        filterAria: "Filter the watch layer",
        viewWorld: "🌍 World",
        viewEurope: "🇪🇺 Europe",
        watchlistNote: "“On watch” projects are not graded. This section only describes public facts from identified sources.",
        extSourceNote: "External source cited for documentation.",
        status: { announced: "Announced", permitting: "Permitting", under_construction: "Under construction", operational: "Operational", unknown: "Status not established" },
      },
    }}
  />
</Base>
