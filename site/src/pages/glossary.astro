const t = {
  title: "Data center glossary — ScoreMyDataCenter",
  metaDescription: "The vocabulary of data centers, explained simply: PUE, ISO 30134, water stress, land artificialization, acceptability, opposition… The industry's words, and those of our territorial lens.",
  tagline: "Independent observatory",
  h1: "Glossary",
  intro:
    "<p>The words you need to read a data center. The <strong>industry's</strong> (what it already measures) and those of our <strong>territorial lens</strong> (what we alone aggregate). Each definition is short; technical terms link to the page that details them.</p>",
  legendAria: "Term families",
  fam: { filiere: "🏭 Industry", territoire: "🌍 Territory", secteur: "📖 Sector" },
  backHref: "/",
  backLabel: "← Back to the home page",
  entries: [
    { term: "Acceptability", slug: "acceptability", fam: "territoire",
      def: "<p>A project's ability to fit into its territory without major friction — water, land, residents, governance. This is what we grade, from A to E. The industry measures the machine's efficiency; we measure its acceptability.</p>",
      more: { href: "/methodology", label: "Our method" } },
    { term: "Chilled-water / heat reuse (waste heat)", slug: "waste-heat", fam: "filiere",
      def: "<p>The heat given off by servers. Wasted if vented, valued if recovered to warm buildings or district heating networks. The industry tracks it via the ERF indicator.</p>",
      more: { href: "/standards", label: "The standards" } },
    { term: "Colocation (colo)", slug: "colocation", fam: "secteur",
      def: "<p>A data center that hosts the servers of multiple clients, as opposed to the « captive » data center of a single company. Most of the European fleet is colocation.</p>" },
    { term: "Documentation confidence", slug: "documentation-confidence", fam: "territoire",
      def: "<p>Our reliability index for the sources behind a grade. A grade never appears without it; below 40 % coverage we write « insufficient data ». We do not grade the unknown.</p>",
      more: { href: "/methodology", label: "Our method" } },
    { term: "DCp", slug: "dcp", fam: "filiere",
      def: "<p>Data Center Performance (ETSI standard). A label from <strong>A to I</strong>, like the energy label on a fridge — but it grades the machine's efficiency, not the site's acceptability.</p>",
      more: { href: "/standards", label: "The standards" } },
    { term: "ENAF (natural / farm / forest land)", slug: "enaf", fam: "territoire",
      def: "<p>Natural, Agricultural and Forest areas — the land that artificialization consumes. Preserving it is a public goal (« no net land take »).</p>" },
    { term: "Hyperscaler", slug: "hyperscaler", fam: "secteur",
      def: "<p>An operator of very large data centers, typically the cloud and digital giants. Their sites concentrate electrical loads comparable to those of a city.</p>" },
    { term: "ICPE (classified installation)", slug: "icpe", fam: "territoire",
      def: "<p>The French permitting regime for facilities with an environmental impact, which governs large data centers. Its file is a first-rank public source.</p>" },
    { term: "ISO/IEC 30134", slug: "iso-30134", fam: "filiere",
      def: "<p>The series of international standards that defines the official data center indicators (PUE, REF…). The authoritative language — the one our energy pillar leans on.</p>",
      more: { href: "/standards", label: "The standards" } },
    { term: "Land artificialization", slug: "land-artificialization", fam: "territoire",
      def: "<p>The conversion of natural or farm land into sealed surface (buildings, parking, roads). A data center on virgin soil weighs more heavily in the land grade than one on an already-artificialized brownfield.</p>" },
    { term: "Moratorium", slug: "moratorium", fam: "territoire",
      def: "<p>A temporary suspension of projects decided by a local authority while it sets a framework. A strong signal of local tension around data center siting.</p>" },
    { term: "Natura 2000 · ZNIEFF", slug: "natura-2000", fam: "territoire",
      def: "<p>Protected natural areas (Natura 2000) or areas inventoried for their ecological value (ZNIEFF). A project's proximity to them weighs in the land &amp; biodiversity grade.</p>" },
    { term: "Opposition", slug: "opposition", fam: "territoire",
      def: "<p>The observable public opposition to a project: petitions, citizen groups, legal appeals, moratoriums. We grade the documented <em>fact</em> that it exists — never an intent ascribed to anyone.</p>" },
    { term: "PPA", slug: "ppa", fam: "filiere",
      def: "<p>Power Purchase Agreement: a direct electricity-supply contract, often renewable, between an operator and a producer. A real lever — but announced ≠ measured until proven.</p>",
      more: { href: "/standards", label: "The standards" } },
    { term: "PUE", slug: "pue", fam: "filiere",
      def: "<p>Power Usage Effectiveness: the energy efficiency of the infrastructure. Close to 1 = very efficient; 2.0 = the French average; 1.28 = the most recent sites. The industry's flagship metric (ISO/IEC 30134-2).</p>",
      more: { href: "/standards", label: "The standards" } },
    { term: "Public inquiry", slug: "public-inquiry", fam: "territoire",
      def: "<p>The regulatory procedure by which residents are consulted on a project before authorization. Its holding, quality and follow-up feed the governance pillar.</p>" },
    { term: "REF", slug: "ref", fam: "filiere",
      def: "<p>Renewable Energy Factor (ISO/IEC 30134-3): the share of renewable energy consumed by the data center, between 0 and 1.</p>",
      more: { href: "/standards", label: "The standards" } },
    { term: "Seveso", slug: "seveso", fam: "territoire",
      def: "<p>The classification of sites posing a major industrial hazard. The presence of a Seveso site around a project nuances its local-impact grade.</p>" },
    { term: "Site grade · project grade", slug: "site-project-grade", fam: "territoire",
      def: "<p>Our two grades. The <strong>site grade</strong> assesses the context the project <em>endures</em> (water, grid, land); the <strong>project &amp; process grade</strong> assesses what the operator <em>chooses</em>. Proof lifts the second, never the first.</p>",
      more: { href: "/methodology", label: "Our method" } },
    { term: "Tier (Uptime)", slug: "tier", fam: "secteur",
      def: "<p>A classification (I to IV) of a data center's reliability and redundancy. It speaks to operational robustness, not environmental impact.</p>" },
    { term: "TVB (green &amp; blue network)", slug: "tvb", fam: "territoire",
      def: "<p>The network of ecological corridors and biodiversity reservoirs that development must not sever.</p>" },
    { term: "Water stress", slug: "water-stress", fam: "territoire",
      def: "<p>The strain on a territory's water resource. Not to be confused with the machine's water consumption (WUE): we measure the <em>pressure on the local resource</em>, not just the site's appetite.</p>" },
    { term: "WUE", slug: "wue", fam: "filiere",
      def: "<p>Water Usage Effectiveness: the water consumed by the data center per unit of IT energy. A machine-side measure — which we complete with the territory's water stress.</p>",
      more: { href: "/standards", label: "The standards" } },
    { term: "ZRE (water allocation zone)", slug: "zre", fam: "territoire",
      def: "<p>An area where the water resource is already in chronic deficit and subject to reinforced sharing rules. A project sited there starts with a handicap on the water pillar.</p>" },
  ],
};
