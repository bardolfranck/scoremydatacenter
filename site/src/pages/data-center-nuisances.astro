// https://scoremydatacenter.org · independent data center acceptability-risk score
// EN concept page — mirror of /fr/nuisances-data-center/ ; template in PagePilier.astro.
//
// 🔴 Same two rules as the FR page: EVERY SENTENCE CARRIES ITS SCOPE (the counts come from
// the 41 environmental opinions we reviewed, not from the 1,565-site corpus), and FINE-GRAINED
// COUNTS STAY OUT OF THE PROSE — they age with every new opinion reviewed and teach the reader
// nothing the ordering does not. The ranking is published in words; the numbers live in the data.
// 🔴 And one EN-specific duty: the regulatory figures are FRENCH. Say so — an English reader
// must not take an émergence limit for a universal rule.
import PagePilier from "../components/PagePilier.astro";
import { EN_NAV } from "../config/nav";
// Both published counts are DERIVED, never retyped — see the French page for the incident.
// 🔴 And a MISSING count is never replaced: `monde` is only emitted when it differs from
// Europe, and a corpus-less build emits no perimeter at all — the page then broke the build
// (CI red since 2026-10-23). The accessors return `null`, not 0, and the sentence reads
// WITHOUT a figure: printing "0 sites" would turn a failed read into a measurement.
import { perimeterSites, derivedCount } from "../config/stats";
import { nuisances } from "../content/nuisances";
const nSites = perimeterSites("monde");
const nDistance = derivedCount("n_nearest_dwelling");
const t = nuisances("en", nSites, nDistance);

---

<PagePilier lang="en" t={t} nav={EN_NAV} altHref="/fr/nuisances-data-center" altLabel="FR" />
