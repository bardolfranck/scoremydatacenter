// FR fiche: thin page — the template lives in DcFiche.astro (shared FR/EN, i18n §13),
// this file only carries the route. The copy used to live here as a 127-key `t` literal,
// with its English twin in the EN page: two hand-held copies of one list. It now lives once,
// in content/fiche.ts, where a test checks the parity instead of hoping for it.
import DcFiche from "../../../components/DcFiche.astro";
import { FICHE } from "../../../content/fiche";
import { FR_NAV } from "../../../config/nav";
import { toLite, buildRelated, coordsFromGeojson, type Related } from "../../../config/related";
import fs from "node:fs";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../../../public/data/dc/*.json", { eager: true });
  const dcs = Object.values(modules).map((m: any) => m.default);
  // map.geojson est lu au build (JSON brut, pas un module) — coords publiques arrondies ~1 km
  const coords = coordsFromGeojson(JSON.parse(fs.readFileSync("public/data/map.geojson", "utf-8")));
  const lite = dcs.map((d: any) => toLite(d, coords));
  return dcs.map((dc: any) => ({
    params: { id: dc.id },
    // La coordonnée PUBLIQUE (déjà arrondie ~1 km dans map.geojson) voyage jusqu'à la
    // fiche pour le balisage `geo`. 🔴 Surtout pas celle du corpus : l'arrondi est une
    // décision d'exposition, et republier la position exacte dans les données structurées
    // la défairait en silence — la machine lirait ce que la carte refuse de montrer.
    props: { dc, related: buildRelated(lite, toLite(dc, coords)), geo: coords[dc.id] ?? null },
  }));
}

const { dc, related, geo } = Astro.props as { dc: any; related: Related[]; geo: [number, number] | null };

const t = FICHE.fr;
---

<DcFiche geo={geo} dc={dc} related={related} lang="fr" t={t} nav={FR_NAV} altHref={`/dc/${dc.id}/`} altLabel="EN" />
