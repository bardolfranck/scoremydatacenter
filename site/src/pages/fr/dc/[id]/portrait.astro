import SitePortrait from "../../../../components/SitePortrait.astro";
import { FR_NAV } from "../../../../config/nav";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../../../../public/data/dc/*.json", { eager: true });
  return Object.values(modules).map((m: any) => ({ params: { id: m.default.id }, props: { dc: m.default } }));
}
const { dc } = Astro.props as { dc: any };

const t = {
  tagline: "Observatoire indépendant",
  kicker: "Portrait du site",
  metaDescription: "{name} ({place}) : ce que le projet change pour la commune, ce qui reste à demander, et jusqu'à quand — portrait lisible du site.",
  status: { announced: "annoncé", permitting: "en instruction", under_construction: "en chantier", operational: "en service" },
  siteGrade: "Note du site",
  probable: "note probable",
