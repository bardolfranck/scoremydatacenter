---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// Full-screen living map — target of the whereismydatacenter.org redirect.
import Base from "../../layouts/Base.astro";
import MapIsland from "../../components/MapIsland.astro";

import { FR_NAV } from "../../config/nav";

const nav = FR_NAV;
---

<Base
  lang="fr"
  {/* « Projets notés » est notre mot, pas celui du lecteur : mesuré le 2026-10-26, la
      demande française se compose de noms de communes (dardilly, blyes, valence,
      rovaltain…), et « carte » est le mot qui les accompagne. Le titre porte donc les
      deux termes qu'on peut gagner — « data centers » et « carte » — puis la question
      locale, qui est la seule intention mesurable qui reste. Pas de suffixe de marque :
      Google affiche déjà le nom du site sous le titre, et ces 20 caractères valent mieux
      en promesse. */}
  title="Carte des data centers : lequel est près de chez vous ?"
  description="Chaque data center recensé sur une carte : zoomez sur votre commune, ouvrez le site et lisez sa note d'acceptabilité A–E — énergie, eau, sol, impact local, avec ses sources."
  tagline="Observatoire indépendant"
  altHref="/map"
  altLabel="EN"
  nav={nav}
>
  <MapIsland
    variant="full"
    labels={{
      site: "Site",
      operator: "Opérateur",
      confidence: { high: "confiance : haute", medium: "confiance : moyenne", low: "confiance : faible" },
      insufficient: "données insuffisantes",
      fixture: "Fixture de test fictive",
      reserved: "· A réservé",
      probable: "probable",
      range: "plage",
      ficheBase: "/fr/dc",
      mapPath: "/fr/carte",
      // La bulle mène au PORTRAIT, pas à la fiche : un pin est un lieu, et un
      // lieu est là où quelqu'un habite. La fiche reste à un clic depuis le portrait.
      // DOUBLE ENTRÉE. Le portrait d'abord — un pin est un lieu — mais la fiche reste
      // offerte : elle est indexée par Google depuis des mois, et retirer son seul lien
      // depuis la carte reviendrait à démailler ce qui marche déjà.
      viewPortrait: "Voir le portrait →",
      viewFiche: "Voir la fiche technique →",
      powerUnknown: "puissance non communiquée",
      // La carte n'avait aucune recherche : le champ de l'en-tête EMMÈNE le lecteur vers le
      // classement, ce qui est à l'envers pour une question géographique.
      search: {
        label: "Rechercher une commune ou un projet sur la carte",
        placeholder: "Commune, projet, opérateur…",
        project: "projet",
        town: "commune",
        none: "Aucune commune ni projet de ce nom.",
      },
      legendGraded: "notes du site",
      legendDonut: "anneau = composition des notes · centre = nombre de sites",
      legendPower: "taille = puissance (MW) · petit point = non communiquée",
      legendWatch: "En veille — suivi, pas encore noté",
    }}
  />
</Base>
