import Glossaire from "../../components/Glossaire.astro";
import { FR_NAV } from "../../config/nav";

const t = {
  title: "Glossaire des data centers — ScoreMyDataCenter",
  metaDescription: "Le vocabulaire des data centers expliqué simplement : PUE, ISO 30134, stress hydrique, artificialisation, acceptabilité, contestation… Les mots de la filière et ceux de notre lentille territoriale.",
  tagline: "Observatoire indépendant",
  h1: "Glossaire",
  intro:
    "<p>Les mots qu'il faut pour lire un data center. Ceux de la <strong>filière</strong> (ce qu'elle mesure déjà) et ceux de notre <strong>lentille territoriale</strong> (ce que nous sommes seuls à agréger). Chaque définition est courte ; les termes techniques renvoient vers la page qui les détaille.</p>",
  legendAria: "Familles de termes",
  fam: { filiere: "🏭 Filière", territoire: "🌍 Territoire", secteur: "📖 Secteur" },
  dir: { lower: "↓ plus bas = mieux", higher: "↑ plus haut = mieux" },
  backHref: "/fr/",
  backLabel: "← Retour à l'accueil",
  entries: [
    { term: "Acceptabilité", slug: "acceptabilite", fam: "territoire",
      def: "<p>La capacité d'un projet à s'insérer dans son territoire sans heurt majeur — eau, sol, riverains, gouvernance. C'est ce que nous notons, de A à E. La filière mesure l'efficacité de la machine ; nous mesurons son acceptabilité.</p>",
      more: { href: "/fr/methodologie", label: "Notre méthode" } },
    { term: "Artificialisation des sols", slug: "artificialisation", fam: "territoire",
      def: "<p>La transformation d'un sol naturel ou agricole en surface imperméabilisée (bâti, parking, voirie). Un data center posé sur un sol vierge pèse plus lourd dans la note foncier qu'un projet installé sur une friche déjà artificialisée.</p>" },
    { term: "Chaleur fatale", slug: "chaleur-fatale", fam: "filiere",
      def: "<p>La chaleur dégagée par les serveurs. Perdue si on l'évacue, valorisée si on la récupère pour chauffer bâtiments ou réseaux de chaleur. La filière la suit via l'indicateur ERF.</p>",
      more: { href: "/fr/normes", label: "Les normes" } },
    { term: "Colocation (colo)", slug: "colocation", fam: "secteur",
      def: "<p>Un data center qui héberge les serveurs de multiples clients, par opposition au data center « captif » d'une seule entreprise. La majorité du parc européen est en colocation.</p>" },
    { term: "Confiance documentaire", slug: "confiance-documentaire", fam: "territoire",
      def: "<p>Notre indice de fiabilité des sources derrière une note. Une note ne s'affiche jamais sans lui ; sous 40 % de couverture, nous écrivons « données insuffisantes ». On ne note pas l'inconnu.</p>",
      more: { href: "/fr/methodologie", label: "Notre méthode" } },
    { term: "Contestation", slug: "contestation", fam: "territoire",
      def: "<p>L'opposition publique observable à un projet : pétitions, collectifs, recours, moratoires. Nous notons le <em>fait</em> qu'elle existe et qu'elle est documentée — jamais une intention prêtée à quiconque.</p>" },
    { term: "DCp", slug: "dcp", fam: "filiere",
      def: "<p>Data Center Performance (norme ETSI). Une étiquette de <strong>A à I</strong>, comme l'étiquette énergie d'un réfrigérateur — mais elle note l'efficacité de la machine, pas l'acceptabilité du site.</p>",
      more: { href: "/fr/normes", label: "Les normes" } },
    { term: "ENAF", slug: "enaf", fam: "territoire",
      def: "<p>Espaces Naturels, Agricoles et Forestiers. Ce sont les sols que l'artificialisation consomme ; leur préservation est un objectif public (« zéro artificialisation nette »).</p>" },
    { term: "Enquête publique", slug: "enquete-publique", fam: "territoire",
      def: "<p>La procédure réglementaire par laquelle les riverains sont consultés sur un projet avant autorisation. Sa tenue, sa qualité et ses suites nourrissent le pilier gouvernance.</p>" },
    { term: "Hyperscaler", slug: "hyperscaler", fam: "secteur",
      def: "<p>Un exploitant de très grands data centers, généralement les géants du cloud et du numérique. Leurs sites concentrent des puissances électriques équivalentes à celles d'une ville.</p>" },
    { term: "ICPE", slug: "icpe", fam: "territoire",
      def: "<p>Installation Classée pour la Protection de l'Environnement. Le régime d'autorisation qui encadre les grands data centers en France ; son dossier est une source publique de premier plan.</p>" },
    { term: "ISO/IEC 30134", slug: "iso-30134", fam: "filiere",
      def: "<p>La série de normes internationales qui définit les indicateurs officiels du data center (PUE, REF…). C'est le langage qui fait autorité — celui sur lequel nous adossons notre pilier énergie.</p>",
      more: { href: "/fr/normes", label: "Les normes" } },
    { term: "Moratoire", slug: "moratoire", fam: "territoire",
      def: "<p>La suspension temporaire des projets décidée par une collectivité, le temps de poser un cadre. C'est un signal fort de tension locale autour de l'implantation de data centers.</p>" },
    { term: "Natura 2000 · ZNIEFF", slug: "natura-2000", fam: "territoire",
      def: "<p>Des zones naturelles protégées (Natura 2000) ou inventoriées pour leur intérêt écologique (ZNIEFF). La proximité d'un projet avec ces zones pèse dans la note foncier &amp; biodiversité.</p>" },
    { term: "PPA", slug: "ppa", fam: "filiere",
      def: "<p>Power Purchase Agreement : un contrat d'achat direct d'électricité, souvent renouvelable, entre un exploitant et un producteur. Un levier réel — mais annoncé ≠ mesuré tant qu'il n'est pas prouvé.</p>",
      more: { href: "/fr/normes", label: "Les normes" } },
    { term: "PUE", slug: "pue", fam: "filiere", dir: "lower",
      def: "<p>Power Usage Effectiveness : le rendement énergétique de l'infrastructure. Proche de 1 = très efficace ; 2,0 = la moyenne du parc français ; 1,28 = les sites les plus récents. L'indicateur roi de la filière (norme ISO/IEC 30134-2).</p>",
      more: { href: "/fr/normes", label: "Les normes" } },
    { term: "REF", slug: "ref", fam: "filiere", dir: "higher",
      def: "<p>Renewable Energy Factor (norme ISO/IEC 30134-3) : la part d'énergie renouvelable consommée par le data center, entre 0 et 1.</p>",
      more: { href: "/fr/normes", label: "Les normes" } },
    { term: "Score site · score projet", slug: "score-site-projet", fam: "territoire",
      def: "<p>Nos deux notes. Le <strong>score site</strong> évalue le contexte que le projet <em>subit</em> (eau, réseau, sol) ; le <strong>score projet &amp; processus</strong> évalue ce que l'opérateur <em>choisit</em>. La preuve fait monter le second, jamais le premier.</p>",
      more: { href: "/fr/methodologie", label: "Notre méthode" } },
    { term: "Seveso", slug: "seveso", fam: "territoire",
      def: "<p>Le classement des sites présentant un risque industriel majeur. La présence d'un site Seveso autour d'un projet nuance sa note d'impact local.</p>" },
    { term: "Stress hydrique", slug: "stress-hydrique", fam: "territoire",
      def: "<p>La tension sur la ressource en eau d'un territoire. À ne pas confondre avec la consommation d'eau de la machine (le WUE) : nous mesurons la <em>pression sur la ressource locale</em>, pas seulement l'appétit du site.</p>" },
    { term: "Tier (Uptime)", slug: "tier", fam: "secteur",
      def: "<p>Une classification (I à IV) de la fiabilité et de la redondance d'un data center. Elle renseigne sur la robustesse d'exploitation, pas sur l'impact environnemental.</p>" },
    { term: "TVB", slug: "tvb", fam: "territoire",
      def: "<p>Trame Verte et Bleue : le réseau des continuités écologiques (corridors, réservoirs de biodiversité) qu'un aménagement ne doit pas rompre.</p>" },
    { term: "WUE", slug: "wue", fam: "filiere", dir: "lower",
      def: "<p>Water Usage Effectiveness : l'eau consommée par le data center par unité d'énergie informatique. Une mesure côté machine — que nous complétons par le stress hydrique du territoire.</p>",
      more: { href: "/fr/normes", label: "Les normes" } },
    { term: "ZRE", slug: "zre", fam: "territoire",
      def: "<p>Zone de Répartition des Eaux : un secteur où la ressource en eau est déjà en déficit chronique et fait l'objet de règles de partage renforcées. Un projet qui s'y implante part avec un handicap sur le pilier eau.</p>" },
  ],
};
---

