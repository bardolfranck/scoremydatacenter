// Site portrait, EN: thin page — the template lives in SitePortrait.astro.
import SitePortrait from "../../../components/SitePortrait.astro";
import { EN_NAV } from "../../../config/nav";
import { PORTRAIT } from "../../../content/portrait";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../../../public/data/dc/*.json", { eager: true });
  return Object.values(modules).map((m: any) => ({ params: { id: m.default.id }, props: { dc: m.default } }));
}
const { dc } = Astro.props as { dc: any };

const t = PORTRAIT.en;
---
<SitePortrait dc={dc} lang="en" t={t} nav={EN_NAV} altHref={`/fr/dc/${dc.id}/portrait/`} altLabel="FR" />
