---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
import "../styles/global.css";
import { isGroup, type NavNode } from "../config/nav";
import { CHROME } from "../content/chrome";

interface Props {
  lang: "en" | "fr";
  title: string;
  description: string;
  tagline: string;
  altHref: string; // path of the same page in the other language
  altLabel: string;
  nav: NavNode[];
  ogImage?: string; // absolute URL of the social card
}
const { lang, title, description, tagline, altHref, altLabel, nav, ogImage } = Astro.props;
// Le chrome est sur TOUTES les pages — donc sur chaque page d'une langue nouvelle. Ses mots
// vivent dans `content/chrome.ts`, une fois par langue, et non en ternaires dispersés : un
// lecteur néerlandais verrait sinon « Refuser » et « Accepter » sous une fiche néerlandaise.
// Les colonnes du pied de page y portent libellés ET slugs ensemble — un libellé traduit sans
// son slug laisserait un menu néerlandais pointer vers des URL françaises.
// ⚠️ Ne pas expliquer tout ceci en commentaire JSX dans le corps : un `{/* … */}` devant le
// `.map()` du pied de page décale l'indentation rendue d'un espace sur les 13 168 pages, et
// un diff de non-régression se met alors à mentir sur ce qu'il a vraiment vérifié.
const c = CHROME[lang];
const altLang = lang === "en" ? "fr" : "en";
const home = lang === "en" ? "/" : "/fr/";

// Canonical + hreflang cluster. Canonical points at the served path WITHOUT query
// (?q=, ?dc=, ?veille=… would otherwise let Google index dozens of duplicates of
// the same page). hreflang lists BOTH languages, self included, plus x-default
// (the EN version = the default the search engine serves when no language fits).
// Trailing slash matches the built canonical (…/press/), so the whole hreflang
// cluster points at the exact canonical URLs — no redirect hop, fully reciprocal.
const withSlash = (p: string) => (p.endsWith("/") ? p : p + "/");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const altAbs = new URL(withSlash(altHref), Astro.site).href;
const enAbs = lang === "en" ? canonical : altAbs;

// Social card: pages may pass their own ogImage; otherwise a single on-brand
// default so EVERY shared link (LinkedIn, X, Slack, press) carries a visual.
const ogImageResolved = ogImage ?? new URL("/assets/hero-datacenter.png", Astro.site).href;

// Sitewide identity graph — IDENTITY ONLY (name, url, logo, founder). Deliberately
// NO Dataset/distribution node: exposing the data or its download endpoints to
// scrapers is exactly what we don't want (anti-pillage doctrine).
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://scoremydatacenter.org/#org",
  name: "ScoreMyDataCenter",
  url: "https://scoremydatacenter.org",
  logo: "https://scoremydatacenter.org/assets/smdc-logo.svg",
  description: c.baseline,
  founder: { "@type": "Person", name: "Franck Bardol" },
};

// Mark the current section so the header shows where you are. Anchor links
// (/#faq…) point back to a homepage section, never a standalone page, so they
// never light up. Compare on the path only, trailing slash normalised.
// UNE ADRESSE INTERNE SE TERMINE PAR UNE BARRE. Le site sert ses pages en dossiers :
// /fr/classement redirige vers /fr/classement/. Comme le menu et le pied de page sont sur
// les 6 660 pages, un href incomplet produit 6 660 redirections — et Google, qui les suit,
// n'indexe pas l'URL d'origine. Relevé en Search Console le 2026-10-22 : 1 474 URLs dans ce
// cas. On normalise ICI, au point de passage, plutôt que dans chaque table de liens : les
// deux tables (nav.ts et le pied de page) divergeraient de toute façon.
// Laissées intactes : les ancres, les requêtes, et tout ce qui n'est pas une adresse interne.
const lienInterne = (h: string) =>
  !h || !h.startsWith("/") || h.includes("#") || h.includes("?") || h.endsWith("/") ? h : `${h}/`;

const here = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const isActive = (href: string) => {
  if (href.includes("#")) return false;
  // « sur le chemin seulement » : la requête se retire AUSSI, sinon un lien de menu qui en
  // porte une (voir `?v=2` sur Comparer, nav.ts) n'allumerait jamais son onglet.
  const p = (href.split("?")[0].replace(/\/+$/, "") || "/");
  return p === here;
};
const groupActive = (n: NavNode) => isGroup(n) && n.children.some((c) => isActive(c.href));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ScoreMyDataCenter" />
    <meta property="og:locale" content={c.ogLocale} />
    <meta property="og:image" content={ogImageResolved} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageResolved} />
    <link rel="icon" type="image/svg+xml" href="/assets/smdc-icon.svg" />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={altLang} href={altAbs} />
    <link rel="alternate" hreflang="x-default" href={enAbs} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={home} aria-label="ScoreMyDataCenter home">
        <img src="/assets/smdc-icon.svg" alt="" width="40" height="40" />
        <span class="brand-text">
          <span class="brand-name">Score<span class="brand-my">My</span>DataCenter</span>
          <span class="brand-bars" aria-hidden="true"><i class="b-a"></i><i class="b-b"></i><i class="b-c"></i><i class="b-d"></i><i class="b-e"></i></span>
          <span class="brand-tagline">{tagline}</span>
        </span>
      </a>
      <form class="header-search" action={c.search.action} method="get" role="search">
        {/* Le libellé promettait « un site, un opérateur, un pays » — jamais une commune,
            qui est pourtant la façon dont un riverain ou un élu arrive ici. Depuis le
            dictionnaire de lieux (2026-10-18), taper un nom de commune RÉPOND, même quand
            elle n'a aucun data center : on annonce donc ce que la boîte sait faire. */}
        <input type="search" name="q"
          placeholder={c.search.placeholder}
          aria-label={c.search.aria} />
      </form>
      <nav class="main-nav" aria-label="Site sections">
        {nav.map((item) => (
          isGroup(item) ? (
            <details class="nav-group" data-nav-group>
              <summary class:list={["nav-summary", { "is-active": groupActive(item) }]}>
                <span>{item.label}</span>
                <svg class="nav-caret" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="nav-menu">
                {item.children.map((c) => (
                  <a href={lienInterne(c.href)} class:list={{ "is-active": isActive(c.href) }}
                     aria-current={isActive(c.href) ? "page" : undefined}>{c.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <a class:list={["nav-link", { "is-active": isActive(item.href) }]} href={lienInterne(item.href)}
               aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          )
        ))}
        <a class="lang-switch" href={altHref}>{altLabel}</a>
      </nav>
      <script>
        // Progressive enhancement over native <details> (which already gives
        // click + keyboard + no-JS). Desktop pointer: open on hover, single
        // group open at a time; everywhere: close on outside-click and Escape.
        const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-nav-group]"));
        const fine = matchMedia("(hover: hover) and (pointer: fine)");
        for (const g of groups) {
          g.addEventListener("toggle", () => {
            if (g.open) for (const o of groups) if (o !== g) o.open = false;
          });
          if (fine.matches) {
            let t: number | undefined;
            g.addEventListener("pointerenter", () => { clearTimeout(t); g.open = true; });
            g.addEventListener("pointerleave", () => { t = window.setTimeout(() => { g.open = false; }, 130); });
          }
        }
        document.addEventListener("click", (e) => {
          if (!(e.target as HTMLElement).closest("[data-nav-group]"))
            for (const g of groups) g.open = false;
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") for (const g of groups) if (g.open) {
            g.open = false;
            g.querySelector("summary")?.focus();
          }
        });
      </script>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer footer-v2">
      <div class="footer-brand">
        <span class="footer-name">Score<span class="brand-my">My</span>DataCenter</span>
        <p>{c.baseline}</p>
        <p class="footer-lic">Engine AGPL-3.0 · Data: licence by source (ODbL, Licence Ouverte…) · Methodology CC BY-SA 4.0<br/>© 2026 Franck Bardol and contributors</p>
      </div>
      {c.footer.map(({ heading, links }) => (
        <div class="footer-col">
          <h4>{heading}</h4>
          <ul>{links.map(({ label, href }) => <li><a href={lienInterne(href)}>{label}</a></li>)}</ul>
        </div>
      ))}
    </footer>
    <!-- Audience measurement (GA4) is consent-gated: nothing loads and no cookie
         is set until the visitor clicks Accept. Choice kept 6 months, revocable
         from the legal-notices page (CNIL guidelines). -->
    <div class="consent-banner" id="consent-banner" hidden role="dialog" aria-live="polite"
      aria-label={c.consent.aria}>
      <p class="consent-text">
        {c.consent.text}
        <a href={lienInterne(c.consent.moreHref)}>
          {c.consent.more}</a>
      </p>
      <div class="consent-actions">
        <button class="button button-secondary" type="button" data-consent="denied">
          {c.consent.decline}</button>
        <button class="button button-secondary" type="button" data-consent="granted">
          {c.consent.accept}</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var KEY = "smdc-consent";
        var MAX_AGE = 182 * 24 * 3600 * 1000; // re-ask after ~6 months (CNIL)
        function readChoice() {
          try {
            var raw = localStorage.getItem(KEY);
            if (!raw) return null;
            var c = JSON.parse(raw);
            if (!c || !c.v || Date.now() - c.t > MAX_AGE) { localStorage.removeItem(KEY); return null; }
            return c.v;
          } catch (e) { return null; }
        }
        function loadGA() {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag("js", new Date());
          // Consent Mode v2. The tag only loads HERE, on Accept — nothing pings
          // before consent, so the hard gate stays (CNIL-clean). Analytics is
          // granted (the visitor just consented); every advertising signal is
          // denied — we never run ads.
          gtag("consent", "default", {
            analytics_storage: "granted",
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
          });
          gtag("config", "G-L6TGP1783C");
          var el = document.createElement("script");
          el.async = true;
          el.src = "https://www.googletagmanager.com/gtag/js?id=G-L6TGP1783C";
          document.head.appendChild(el);
        }
        window.smdcConsentReset = function () { localStorage.removeItem(KEY); location.reload(); };
        var banner = document.getElementById("consent-banner");
        var choice = readChoice();
        if (choice === "granted") loadGA();
        else if (choice === null && banner) {
          banner.hidden = false;
          banner.addEventListener("click", function (ev) {
            var v = ev.target && ev.target.getAttribute && ev.target.getAttribute("data-consent");
            if (!v) return;
            try { localStorage.setItem(KEY, JSON.stringify({ v: v, t: Date.now() })); } catch (e) {}
            banner.hidden = true;
            if (v === "granted") loadGA();
          });
        }
      })();
    </script>
    <!-- Conversion events. Fire ONLY if the visitor consented (gtag present);
         no consent → no gtag → events silently drop. Declarative: any element
         with data-ga-event fires on click, data-ga-* attributes become params. -->
    <script is:inline>
      (function () {
        window.smdcTrack = function (name, params) {
          try { if (typeof window.gtag === "function") window.gtag("event", name, params || {}); } catch (e) {}
        };
        document.addEventListener("click", function (ev) {
          var t = ev.target;
          var el = t && t.closest ? t.closest("[data-ga-event]") : null;
          if (!el) return;
          var params = {};
          for (var i = 0; i < el.attributes.length; i++) {
            var a = el.attributes[i];
            if (a.name.indexOf("data-ga-") === 0 && a.name !== "data-ga-event") {
              params[a.name.slice(8).replace(/-/g, "_")] = a.value;
            }
          }
          window.smdcTrack(el.getAttribute("data-ga-event"), params);
        });
      })();
    </script>
  </body>
</html>
