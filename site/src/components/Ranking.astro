---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// The tweetable ranking, shared FR/EN (i18n §13: one template, per-language t).
// Every sort/filter/search state has a shareable URL. Rows render at build time
// from the engine's artifacts; the client script only reorders and filters.
import Base from "../layouts/Base.astro";
import type { NavNode } from "../config/nav";
import ScoreBadge from "./ScoreBadge.astro";
import scoresData from "../../public/data/scores.json";
import methodologyData from "../../public/data/methodology.json";
import PillarIcon from "./PillarIcon.astro";
import { readFileSync } from "node:fs";

const { lang, t, nav, altHref, altLabel } = Astro.props as {
  lang: "fr" | "en"; t: any; nav: NavNode[];
  altHref: string; altLabel: string;
};

const scores = scoresData as any[];
const methodology = methodologyData as any;
const pillars = methodology.pillars as any[];

// UNE COLONNE VIDE À 99,5 % N'EST PAS UNE COLONNE (Franck, 2026-10-21). Mesuré sur le corpus
// du jour : la mise en service est renseignée sur 17 fiches de 3 283 — et uniquement sur des
// sites DÉJÀ EN SERVICE, pour qui la date est du passé. Zéro sur les 322 projets annoncés et
// les 78 en instruction, c'est-à-dire exactement ceux pour qui elle compterait.
//
// Dérivé, pas retiré en dur : le jour où ces dates seront collectées, la colonne revient
// seule. Une suppression écrite à la main, elle, ne se relit jamais.
const PART_MINIMALE_COLONNE = 0.05;
const colonneAnnee = scores.filter((d) => d.expected_commissioning != null).length
  / Math.max(scores.length, 1) >= PART_MINIMALE_COLONNE;

// La légende des statuts, rassemblée en une phrase : elle vit maintenant dans l'infobulle de
// l'en-tête, pas en quatre lignes au-dessus du tableau.
const legendeStatuts = [t.statusHelpTitre, ...Object.entries(t.status).map(
  ([k, label]) => `${label} — ${t.statusHelp?.[k] ?? ""}`)].join("\n");

const ficheBase = lang === "fr" ? "/fr/dc" : "/dc";
const mapPath = lang === "fr" ? "/fr/carte" : "/map";
const confidenceRank: Record<string, number> = { high: 3, medium: 2, low: 1 };

const sortValue = (graded: any) => (graded && typeof graded.score === "number" ? graded.score : -1);
// Anti-pillage (Franck 2026-09-05): the bulk ranking table must NOT emit the exact
// /100 score per cell (a scrapable dump of the whole scored corpus). It sorts by
// the LETTER instead — enough to rank/browse; the exact /100 stays in the fiche
// (human) and the API (machine, gated). Letter → ordinal so parseFloat sort holds.
const LETTER_RANK: Record<string, number> = { A: 5, B: 4, C: 3, D: 2, E: 1 };
const gradeRank = (graded: any) => (graded && typeof graded.grade === "string" && LETTER_RANK[graded.grade] ? LETTER_RANK[graded.grade] : -1);

// Percentile-context register (brief 2026-07-12 · A-27): we SITUATE, we never judge.
// A presentation-only derived field, computed at build from the frozen published
// corpus (scores.json) — deterministic, no engine/artifact change, golden untouched.
const pool = (getter: (d: any) => any) =>
  scores.map(getter).filter((v: any) => typeof v === "number").sort((a: number, b: number) => a - b);
const sitePool = pool((d) => d.grades.site.score);
const ppPool = pool((d) => d.grades.project_process.score);
// Bottom percentile: share of the corpus scored at or below this value (P4 = bottom 4%).
const bottomPct = (arr: number[], v: number) => Math.ceil((arr.filter((x) => x <= v).length / arr.length) * 100);
const topPct = (arr: number[], v: number) => Math.ceil((arr.filter((x) => x >= v).length / arr.length) * 100);
// The mid-range buckets ("quart inférieur", "sous la médiane") say nothing — the
// label must carry the DRIVING FACT (Franck, 2026-07-12). Extremes keep the shock
// phrase; the middle names the pillar that pulls the position (lowest pillar when
// low, highest pillar when high) — derived from published pillar scores, no invention.
const siteDriver = (dc: any, positive: boolean): string | null => {
  const entries = pillars
    .map((p: any) => ({ id: p.id, s: dc.pillars[p.id]?.score }))
    .filter((e: any) => typeof e.s === "number");
  if (!entries.length) return null;
  entries.sort((a: any, b: any) => a.s - b.s);
  const pick = positive ? entries[entries.length - 1] : entries[0];
  return (positive ? t.driver.high : t.driver.low)[pick.id] ?? null;
};
const opBand = (score: number): string =>
  score >= 80 ? t.opBand.proven : score >= 50 ? t.opBand.documented : t.opBand.partial;
const pctInfo = (arr: number[], graded: any, dc: any, axis: "site" | "operator"): { pos: number; label: string } | null => {
  if (!graded || typeof graded.score !== "number" || arr.length < 2) return null;
  const bp = bottomPct(arr, graded.score);
  const tp = topPct(arr, graded.score);
  let label: string | null;
  if (tp <= 10) label = t.pct.top.replace("{p}", String(tp));
  else if (bp <= 10) label = t.pct.bottom.replace("{p}", String(bp));
  else if (axis === "operator") label = opBand(graded.score);
  else label = siteDriver(dc, bp >= 50);
  if (!label) {
    // no pillar detail published — fall back to the neutral bucket
    if (tp <= 25) label = t.pct.upperQuartile;
    else if (bp <= 25) label = t.pct.lowerQuartile;
    else if (bp >= 45 && bp <= 55) label = t.pct.median;
    else label = bp < 50 ? t.pct.belowMedian : t.pct.aboveMedian;
  }
  return { pos: Math.min(99, Math.max(1, bp)), label: `P${bp} · ${label}` };
};
// NOTE PROBABLE (règle C-bis) — la bande voyage avec la ligne de classement depuis l'option A.
// `bandOf` ne rend un objet que si la bande porte vraiment une lettre : une fiche tenue en
// veille est blanchie en amont (plus de bande du tout), elle retombe donc sur la puce neutre.
const bandOf = (dc: any) => {
  const b = dc.provisional_band;
  return b && typeof b.central === "string"
    ? { central: b.central, edges: b.edges ?? null, adjacent: b.adjacent ?? null,
        a_reserved: b.a_reserved, wide: !!b.wide }
    : null;
};
const probableLabel = (dc: any): string => {
  const b = dc.provisional_band;
  const span = b.band && b.band !== b.central ? ` · ${t.range} ${b.band}` : "";
  return `${t.probable} ${b.central}${span}`;
};
const fmtDate = (iso: string | null) => (iso ? (lang === "fr" ? iso.split("-").reverse().join("/") : iso) : "");
// Accent-insensitive haystack for the basic search engine (client mirrors this).
const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const haystack = (dc: any) => norm([dc.name, dc.operator, dc.municipality, dc.country].filter(Boolean).join(" "));

// RECHERCHE PAR LIEU (Franck 2026-10-18) : chaque ligne porte sa position pour que le
// navigateur puisse répondre « les plus proches de la commune que vous cherchez ».
// La coordonnée est celle de la carte publique — arrondie à ~1 km, déjà servie dans
// map.geojson. On n'expose donc rien de neuf : on réutilise, à la décimale près, ce que la
// carte montre déjà. Republier ici une position plus fine défairait en silence l'arrondi
// décidé pour l'exposition.
const mapData = JSON.parse(
  readFileSync(new URL("../../public/data/map.geojson", import.meta.url), "utf8"));
// ── BANDEAU DE PILIERS (Franck 2026-10-20, d'après l'étiquette européenne du pneu) ────────
// Quatre mesures toujours aux mêmes places, qu'on compare sans lire. L'étiquette du pneu ne
// dit pas quel pneu est le meilleur : elle donne les axes, l'acheteur arbitre. C'est notre
// doctrine — on situe, on ne juge pas — et nous avions déjà l'étiquette sans la montrer.
//
// 🔴 LES COLONNES SE DÉRIVENT DE LA COUVERTURE, ELLES NE SE CHOISISSENT PAS. Une colonne
// vide sur presque toutes les lignes ne compare rien : elle n'a aucun pouvoir séparateur et
// finit par se lire comme un défaut d'affichage. Mesuré sur le corpus servi : foncier 84 %,
// eau 74 %, énergie 32 %, impact local 10 % — et transparence 0,1 %, soit DEUX fiches.
// L'écart entre le quatrième et le cinquième est de deux ordres de grandeur, donc tout seuil
// entre 1 % et 9 % retient les mêmes quatre colonnes : le seuil ne décide de rien, c'est le
// trou qui décide. Et le jour où la transparence se collecte, sa colonne revient seule.
const COUVERTURE_MINIMALE = 0.05;
const pilierCouverture = (pid: string) =>
  scores.filter((d: any) => typeof (d.pillars?.[pid]?.grade) === "string"
    && LETTER_RANK[d.pillars[pid].grade]).length / Math.max(1, scores.length);
// Les noms d'icônes des piliers : ceux des fiches, pour qu'un lecteur qui a vu une fiche
// retrouve les mêmes repères (c'est la moitié du contrat d'une étiquette : être apprise une
// fois). `land_biodiversity` et `local_impact` portent des noms d'icône plus courts.
const ICONE_PILIER: Record<string, string> = {
  energy: "energy", water: "water", land_biodiversity: "land",
  local_impact: "local", transparency_governance: "transparency",
};
const pilierBandeau = pillars
  .filter((p: any) => pilierCouverture(p.id) >= COUVERTURE_MINIMALE)
  .map((p: any) => ({ id: p.id, label: t.pillarShort[p.id], icone: ICONE_PILIER[p.id] }));

const coordsParId: Record<string, [number, number]> = Object.fromEntries(
  ((mapData as any).features ?? [])
    .filter((f: any) => f?.properties?.id && Array.isArray(f?.geometry?.coordinates))
    .map((f: any) => [f.properties.id, f.geometry.coordinates as [number, number]])
);
---

<Base
  lang={lang}
  title={t.pageTitle}
  description={t.metaDescription}
  tagline={t.tagline}
  altHref={altHref}
  altLabel={altLabel}
  nav={nav}
>
  <section class="section" aria-labelledby="rank-title">
    <div class="section-inner">
      <div class="section-heading">
        <h2 id="rank-title">{t.title}</h2>
        <p>{t.lede}</p>
        <a class="rank-map-cta" href={mapPath}>{t.mapCta} ↗</a>
      </div>

      <div class="rank-controls">
        <label class="rank-search">
          <span class="sr-only">{t.searchSr}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="rank-q" placeholder={t.searchPlaceholder} autocomplete="off" />
        </label>
        <label>
          {t.sortBy}
          <select id="rank-sort">
            <option value="site">{t.sortSite}</option>
            <option value="operator">{t.sortOperator}</option>
            {pillars.map((p) => <option value={p.id}>{t.pillarPrefix}{t.pillarShort[p.id]}</option>)}
            <option value="confidence">{t.sortConfidence}</option>
            <option value="power">{t.sortPower}</option>
            <option value="year">{t.sortYear}</option>
            <option value="country">{t.sortCountry}</option>
          </select>
        </label>
        <label>
          {t.order}
          <select id="rank-order">
            <option value="desc">{t.orderBest}</option>
            <option value="asc">{t.orderWorst}</option>
          </select>
        </label>
        <label>
          {t.statusLabel}
          <select id="rank-status">
            <option value="all">{t.statusAll}</option>
            {Object.entries(t.status).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
      </div>

      <p class="sr-only">{t.srSummary}</p>

      {/* RÉPONSE DE LIEU — le troisième état du classement. Il n'en avait que deux : des
          lignes, ou rien. « Rien » était un mensonge par omission : chercher
          « Ferney-Voltaire » ne rendait aucune ligne alors que cinq data centers sont à
          moins de 21 km, dont quatre en Suisse — qu'aucune recherche textuelle ne trouvera
          jamais, puisqu'une frontière n'est pas un mot. Le bloc transforme l'absence en
          réponse. Il est VIDE au rendu et rempli par le navigateur : le dictionnaire de
          communes ne descend qu'à la demande, par tranche. */}
      {/* Les icônes sont rendues par un composant Astro, donc côté serveur : on en dépose un
          exemplaire caché que le script clone. Les inliner en chaîne dans le script aurait
          dupliqué le dessin des piliers à un second endroit. */}
      <div class="rank-ico-bank" hidden aria-hidden="true">
        {pilierBandeau.map((p) => (
          <span data-pilier={p.id}><PillarIcon name={p.icone as any} size={13} /></span>
        ))}
      </div>
      <div class="rank-lieu" id="rank-lieu" hidden
           data-labels={JSON.stringify(t.lieu)}
           data-piliers={JSON.stringify(pilierBandeau)}></div>

      <div class="rank-wrap">
        <table class="rank-table" id="rank-table">
          <thead>
            <tr>
              <th>#</th>
              <th>{t.thProject}</th>
              <th data-tri="country">{t.thCountry}</th>
              {colonneAnnee && <th data-tri="year">{t.thYear}</th>}
              {/* La légende des statuts tenait quatre lignes sous les filtres, au-dessus du
                  tableau, et repoussait les données vers le bas à chaque chargement. Elle est
                  là où la question se pose : sur l'en-tête de la colonne. */}
              <th class="rank-th-aide" tabindex="0" title={legendeStatuts}>
                {t.thStatus}<span class="rank-th-ico" aria-hidden="true">?</span>
                <span class="sr-only">{legendeStatuts}</span>
              </th>
              <th data-tri="site">{t.thRails}</th>
              {pillars.map((p) => <th data-tri={p.id}>{t.pillarShort[p.id]}</th>)}
              <th data-tri="confidence">{t.thConfidence}</th>
            </tr>
          </thead>
          <tbody>
            {scores.map((dc) => (
              <tr
                data-status={dc.project_status}
                data-country={dc.country}
                data-search={haystack(dc)}
                data-lon={coordsParId[dc.id]?.[0]}
                data-lat={coordsParId[dc.id]?.[1]}
                data-nom={dc.name}
                data-commune={dc.municipality ?? ""}
                data-k-site={gradeRank(dc.grades.site)}
                data-k-operator={gradeRank(dc.grades.project_process)}
                data-k-confidence={confidenceRank[dc.confidence.level]}
                data-k-power={dc.power_mw ?? -1}
                data-k-year={dc.expected_commissioning ?? -1}
                {...Object.fromEntries(pillars.map((p) => [`data-k-${p.id}`, gradeRank(dc.pillars[p.id])]))}
              >
                <td class="rank-index"></td>
                <td class="rank-project">
                  <strong><a href={`${ficheBase}/${dc.id}`}>{dc.name}</a></strong>
                  <span>{dc.municipality} — {dc.operator}{dc.id.startsWith("zz-") ? ` · ${t.fixture}` : ""}</span>
                  <a class="rank-map-link" href={`${mapPath}?dc=${dc.id}`}>{t.viewOnMap} ↗</a>
                </td>
                <td class="rank-country">{dc.country}</td>
                {colonneAnnee && <td class="rank-year">{dc.expected_commissioning ?? <span title={t.yearUnknown}>—</span>}</td>}
                <td set:html={(() => {
                  const base = t.status[dc.project_status];
                  if (!dc.power_mw) return `${base} · ${t.powerUnknown}`;
                  const est = dc.power_mw_status === "estimated";
                  const r = (v: number) => Number(v.toPrecision(2));
                  const val = est ? `~${r(dc.power_mw)}` : dc.power_mw;
                  return `${base} · ${val} MW${est ? ` · <span class="pw-est">${t.powerEstimated}</span>` : ""}`;
                })()}></td>
                <td class="rank-rails">
                  {(() => { const p = pctInfo(sitePool, dc.grades.site, dc, "site"); return (
                  <div class="rail">
                    <span class="rail-axis">{t.railSite}</span>
                    <ScoreBadge
                      label={t.thSite}
                      grade={dc.grades.site}
                      band={bandOf(dc)}
                      confidence={dc.confidence.level}
                      confidenceLabel={t.confidence[dc.confidence.level]}
                      renderConfidence={false}
                      renderLabel={false}
                      size="sm"
                      naLabel={t.naLabel}
                      enAttenteLabel={t.enAttenteLabel}
                      reservedLabel={t.reserved}
                    />
                    {/* Le rail porte la MÊME phrase que la fiche. Un classement qui afficherait
                        une lettre nue là où la fiche publie « probable E · distribué E–C »
                        republierait un point sans son incertitude — la famille de bug qui a
                        produit « Google Bissen · dans les 3 % les moins bien notés » sous une
                        fiche qui disait ne pas savoir. */}
                    {bandOf(dc)
                      ? <span class="rail-label rail-label-prov">{probableLabel(dc)}</span>
                      : p
                      ? <Fragment><span class="rail-track" aria-hidden="true"><i class="rail-cursor" style={`left:${p.pos}%`}></i></span><span class="rail-label">{p.label}</span></Fragment>
                      : <span class="rail-label rail-label-na">{dc.grades.site.grade === "en_attente" ? t.enAttenteLabel : t.naLabel}</span>}
                  </div> ); })()}
                  {(() => { const p = pctInfo(ppPool, dc.grades.project_process, dc, "operator"); return (
                  <div class="rail">
                    <span class="rail-axis">{t.railOperator}</span>
                    <ScoreBadge
                      label={t.thOperator}
                      grade={dc.grades.project_process}
                      confidence={dc.confidence.level}
                      confidenceLabel={t.confidence[dc.confidence.level]}
                      renderConfidence={false}
                      renderLabel={false}
                      size="sm"
                      naLabel={t.naLabel}
                      enAttenteLabel={t.enAttenteLabel}
                      reservedLabel={t.reserved}
                    />
                    {p
                      ? <Fragment><span class="rail-track" aria-hidden="true"><i class="rail-cursor" style={`left:${p.pos}%`}></i></span><span class="rail-label">{p.label}</span></Fragment>
                      : <span class="rail-label rail-label-na">{t.railUnproven}</span>}
                  </div> ); })()}
                </td>
                {pillars.map((p) => (
                  <td>
                    <ScoreBadge
                      label={t.pillarShort[p.id]}
                      grade={dc.pillars[p.id]}
                      confidence={dc.confidence.level}
                      confidenceLabel={t.confidence[dc.confidence.level]}
                      renderConfidence={false}
                      renderLabel={false}
                      size="sm"
                      naLabel={t.naLabel}
                      enAttenteLabel={t.enAttenteLabel}
                    />
                  </td>
                ))}
                <td>
                  <span class={`confidence ${dc.confidence.level}`}>
                    <span class="dot" aria-hidden="true"></span>
                    {t.confidence[dc.confidence.level]}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="rank-note">{t.note}</p>
      {/* La ligne de méthode est une note de bas de page, pas une entrée en matière : elle
          s'intercalait entre les filtres et le tableau, où personne ne la lit et où elle
          retarde la donnée. */}
      <p class="rank-ref">{t.reference.replace("{n}", String(sitePool.length)).replace("{version}", methodology.version)}</p>
    </div>
  </section>
</Base>

<script>
  // Tweetable state: ?tri=<key>&ordre=<asc|desc>&statut=<status>&q=<query> reorders the
  // build-rendered rows. insufficient_data sorts as -1 (always last on "best first").
  const table = document.getElementById("rank-table") as HTMLTableElement;
  const tbody = table.querySelector("tbody")!;
  const sortSel = document.getElementById("rank-sort") as HTMLSelectElement;
  const orderSel = document.getElementById("rank-order") as HTMLSelectElement;
  const statusSel = document.getElementById("rank-status") as HTMLSelectElement;
  const searchInput = document.getElementById("rank-q") as HTMLInputElement;

  // Same normalisation as the build-time haystack: accent-insensitive matching.
  const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  function apply(updateUrl = true) {
    const key = sortSel.value;
    const asc = orderSel.value === "asc";
    const status = statusSel.value;
    const q = norm(searchInput.value.trim());
    const rows = Array.from(tbody.querySelectorAll("tr"));

    rows.sort((a, b) => {
      if (key === "country") {
        // Alphabetical: "best first" reads A→Z (real panels before the ZZ fixtures).
        const diff = (a.dataset.country ?? "").localeCompare(b.dataset.country ?? "");
        return asc ? -diff : diff;
      }
      const va = parseFloat(a.getAttribute(`data-k-${key}`) ?? "-1");
      const vb = parseFloat(b.getAttribute(`data-k-${key}`) ?? "-1");
      return asc ? va - vb : vb - va;
    });

    let rank = 0;
    for (const row of rows) {
      const visible = (status === "all" || row.dataset.status === status)
        && (!q || (row.dataset.search ?? "").includes(q));
      row.style.display = visible ? "" : "none";
      if (visible) {
        rank += 1;
        row.querySelector(".rank-index")!.textContent = String(rank);
      }
      tbody.appendChild(row);
    }

    if (updateUrl) {
      const params = new URLSearchParams();
      if (key !== "site") params.set("tri", key);
      if (asc) params.set("ordre", "asc");
      if (status !== "all") params.set("statut", status);
      if (searchInput.value.trim()) params.set("q", searchInput.value.trim());
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
    }
  }

  // TRIER EN CLIQUANT L'EN-TÊTE, comme dans un tableur (Franck, 2026-10-21). On pilote les
  // deux sélecteurs existants plutôt que d'écrire un second tri : une seule implémentation,
  // donc un seul comportement, et l'URL partageable reste la même.
  for (const th of Array.from(table.querySelectorAll("th[data-tri]")) as HTMLElement[]) {
    const key = th.dataset.tri!;
    th.setAttribute("role", "button");
    th.setAttribute("tabindex", "0");
    const trier = () => {
      // Re-cliquer la même colonne inverse l'ordre ; changer de colonne repart du sens le
      // plus utile, qui est `desc` pour TOUTES les clés — y compris le pays, dont le tri
      // alphabétique est déjà câblé « A→Z sur desc » dans apply(). Un cas particulier ici
      // renvoyait le premier clic à l'envers : les États-Unis arrivaient avant la Suisse.
      if (sortSel.value === key) orderSel.value = orderSel.value === "asc" ? "desc" : "asc";
      else { sortSel.value = key; orderSel.value = "desc"; }
      apply();
      marquerTri();
    };
    th.addEventListener("click", trier);
    th.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
        e.preventDefault(); trier();
      }
    });
  }

  function marquerTri() {
    for (const th of Array.from(table.querySelectorAll("th[data-tri]")) as HTMLElement[]) {
      const actif = th.dataset.tri === sortSel.value;
      th.classList.toggle("is-tri", actif);
      th.classList.toggle("is-asc", actif && orderSel.value === "asc");
      if (actif) th.setAttribute("aria-sort", orderSel.value === "asc" ? "ascending" : "descending");
      else th.removeAttribute("aria-sort");
    }
  }

  const params = new URLSearchParams(location.search);
  if (params.get("tri")) sortSel.value = params.get("tri")!;
  if (params.get("ordre") === "asc") orderSel.value = "asc";
  if (params.get("statut")) statusSel.value = params.get("statut")!;
  if (params.get("q")) searchInput.value = params.get("q")!;
  if (sortSel.selectedIndex < 0) sortSel.value = "site";
  if (statusSel.selectedIndex < 0) statusSel.value = "all";

  // ── RECHERCHE PAR LIEU ────────────────────────────────────────────────────────────────
  // Quand le texte ne rend AUCUNE ligne, la question n'est pas close : le lecteur a peut-être
  // tapé le nom de sa commune. On va alors chercher le lieu dans le dictionnaire embarqué et
  // on répond par les data centers les plus proches — en kilomètres, pas en mots.
  const blocLieu = document.getElementById("rank-lieu")!;
  const L = JSON.parse(blocLieu.dataset.labels || "{}");
  // Le bandeau : les piliers retenus (dérivés de la couverture au build) et leurs icônes,
  // clonées depuis l'exemplaire rendu côté serveur.
  const PILIERS: { id: string; label: string; icone: string }[] =
    JSON.parse(blocLieu.dataset.piliers || "[]");
  const banque = document.querySelector(".rank-ico-bank");
  const icone = (pid: string) =>
    banque?.querySelector(`[data-pilier="${pid}"]`)?.innerHTML ?? "";
  // Les lignes du tableau portent le RANG de la lettre (A=5 … E=1, -1 = pas de note) :
  // on relit l'échelle dans l'autre sens plutôt que de republier les lettres une deuxième
  // fois dans le DOM — une même valeur écrite à deux endroits finit par diverger.
  const LETTRE: Record<string, string> = { "5": "A", "4": "B", "3": "C", "2": "D", "1": "E" };
  const lettrePilier = (row: HTMLElement, pid: string) =>
    LETTRE[row.getAttribute(`data-k-${pid}`) ?? ""] ?? null;

  const enteteBandeau = () =>
    `<span class="rl-cols rl-entete">` + PILIERS.map((p) =>
      `<span title="${p.label}">${icone(p.id)}<i>${p.label}</i></span>`).join("") + `</span>`;

  const bandeau = (row: HTMLElement) =>
    `<span class="rl-cols">` + PILIERS.map((p) => {
      const g = lettrePilier(row, p.id);
      // 🔴 Une case vide ne doit JAMAIS se lire comme une note moyenne : hachurée, en
      // pointillés, avec un tiret. C'est la différence entre « mal noté » et « non mesuré »,
      // et c'est exactement celle qu'on passe nos journées à défendre ailleurs.
      return g
        ? `<span class="rl-cell g-${g.toLowerCase()}" title="${p.label} : ${g}">${g}</span>`
        : `<span class="rl-cell rl-vide" title="${p.label} : ${L.notMeasured ?? ""}">–</span>`;
    }).join("") + `</span>`;

  // La confiance porte sur la note D'ENSEMBLE, pas sur chaque pilier : on ne la calcule pas
  // par pilier, on se garde donc de la suggérer par pilier. Elle reste à droite, sur la note.
  const noteEtConfiance = (row: HTMLElement) => {
    const g = LETTRE[row.getAttribute("data-k-site") ?? ""] ?? null;
    const c = parseInt(row.getAttribute("data-k-confidence") ?? "0", 10) || 0;
    const puce = g ? `<span class="rl-note g-${g.toLowerCase()}">${g}</span>` : "";
    const pts = `<span class="rl-conf c${c}" title="${L.docLevel ?? ""}"><i></i><i></i><i></i></span>`;
    return `<span class="rl-noteconf">${puce}${g ? pts : ""}</span>`;
  };
  // La normalisation doit être EXACTEMENT celle du générateur (scripts/build_gazetteer.py) :
  // c'est elle qui décide du nom de la tranche à télécharger. Deux normalisations qui
  // divergent rendraient des communes introuvables, et sans la moindre erreur à l'écran.
  const normLieu = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "")
    .toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
  const tranches = new Map<string, any[]>();
  let demandeEnCours = 0;
  // Les fiches portent le CODE de la région (« US.NH ») ; son nom vit dans une table à
  // part, chargée une fois — 165 000 lieux pour 290 régions. Elle porte les deux langues,
  // parce que la table de référence de GeoNames est anglicisée : la page française
  // affichait « Vernon (Normandy) » juste au-dessus de « Nation Data Center – Normandie ».
  let nomsRegions: Record<string, any> = {};
  fetch("/data/lieux/regions.json")
    .then((r) => (r.ok ? r.json() : {}))
    .then((t) => { nomsRegions = t; })
    .catch(() => { /* sans la table, on affiche le pays seul : dégradé, pas cassé */ });
  const langue = document.documentElement.lang === "en" ? "en" : "fr";
  const nomRegion = (code: string) => (code && nomsRegions[code]?.[langue]) || "";

  async function chargerTranche(prefixe: string): Promise<any[]> {
    if (tranches.has(prefixe)) return tranches.get(prefixe)!;
    try {
      const r = await fetch(`/data/lieux/${prefixe.replace(/ /g, "_")}.json`);
      // Une tranche absente n'est pas une panne : c'est « aucune commune ne commence
      // ainsi ». On mémorise le vide pour ne pas redemander à chaque frappe.
      const data = r.ok ? await r.json() : [];
      tranches.set(prefixe, data);
      return data;
    } catch {
      tranches.set(prefixe, []);
      return [];
    }
  }

  const RAYON_TERRE_KM = 6371;
  const km = (aLon: number, aLat: number, bLon: number, bLat: number) => {
    const r = Math.PI / 180;
    const dLat = (bLat - aLat) * r, dLon = (bLon - aLon) * r;
    const h = Math.sin(dLat / 2) ** 2
      + Math.cos(aLat * r) * Math.cos(bLat * r) * Math.sin(dLon / 2) ** 2;
    return 2 * RAYON_TERRE_KM * Math.asin(Math.sqrt(h));
  };

  const fmtKm = (d: number) => (d < 10 ? d.toFixed(1) : String(Math.round(d)))
    .replace(".", L.decimal || ".");

  async function repondreParLieu(saisie: string) {
    const q = normLieu(saisie);
    // Deux lettres : en dessous, « pa » ramènerait des milliers de communes pour une frappe
    // qui n'est pas encore une recherche.
    if (q.length < 2) return masquerBloc();
    const jeton = ++demandeEnCours;
    const candidats = await chargerTranche(q.slice(0, 2));
    if (jeton !== demandeEnCours) return;           // une frappe plus récente a pris la main

    // 🔴 DEUX RÈGLES, DANS CET ORDRE — et les deux ont été établies par un contre-exemple,
    // pas par raisonnement :
    //   1. UN NOM EXACT BAT UN PRÉFIXE. Sans ça, « Vernon » élisait « Vernon Hills »
    //      (Illinois, 22 000 hab.) parce qu'elle est à peine plus peuplée que Vernon dans
    //      l'Eure — et répondait avec les data centers de Chicago.
    //   2. À ÉGALITÉ DE FORME, LE PLUS PEUPLÉ GAGNE. La tranche arrive déjà triée ainsi.
    // Le cas « Ferney » traverse les deux : aucun nom exact ne lui correspond (les deux
    // hameaux américains homonymes sont sous le plancher de 100 habitants du dictionnaire),
    // donc on tombe sur le préfixe le plus peuplé — Ferney-Voltaire. Les homonymes restent
    // listés en dessous : rien n'est caché, et trois lettres de plus suffisent à les viser.
    const prefixes = candidats.filter((c: any[]) => normLieu(c[0]).startsWith(q));
    const exacts = prefixes.filter((c: any[]) => normLieu(c[0]) === q);
    const trouves = exacts.length ? exacts.concat(prefixes.filter((c) => !exacts.includes(c)))
                                  : prefixes;
    if (!trouves.length) return masquerBloc();

    const [nom, pays, lat, lon, , region] = trouves[0];
    // « Berlin (US) » ne permet pas de choisir : il y a plusieurs Berlin aux États-Unis.
    // Le pays ne situe rien À L'INTÉRIEUR d'un pays — c'est l'État ou la région qui le fait.
    const situe = (code: string, p: string) => [nomRegion(code), p].filter(Boolean).join(" · ");
    const proches = Array.from(tbody.querySelectorAll("tr"))
      .map((row) => {
        const rLat = parseFloat((row as HTMLElement).dataset.lat ?? "");
        const rLon = parseFloat((row as HTMLElement).dataset.lon ?? "");
        if (Number.isNaN(rLat) || Number.isNaN(rLon)) return null;
        return { row: row as HTMLElement, d: km(lon, lat, rLon, rLat) };
      })
      .filter(Boolean)
      .sort((a: any, b: any) => a.d - b.d)
      .slice(0, 5) as { row: HTMLElement; d: number }[];
    if (!proches.length) return masquerBloc();

    // ⚠️ ON LISTE PAR DISTANCE, JAMAIS PAR NOTE. Un rayon traverse les frontières et nos
    // notes sont calibrées pays par pays : classer un B suisse et un D français dans la même
    // colonne inviterait une comparaison que la grille ne soutient pas. Le pays est donc
    // toujours affiché, et l'ordre est géographique.
    const items = proches.map(({ row, d }) => {
      const href = row.querySelector("a")?.getAttribute("href") ?? "#";
      const commune = row.dataset.commune || "";
      const drapeau = row.dataset.country || "";
      return `<li><span class="rl-qui"><a href="${href}">${row.dataset.nom}</a>`
        + `<span class="rl-ou">${commune}${commune && drapeau ? " · " : ""}${drapeau}</span></span>`
        + bandeau(row)
        + `<b class="rl-km">${L.away.replace("{km}", fmtKm(d))}</b>`
        + noteEtConfiance(row) + `</li>`;
    }).join("");

    // « 21 autres lieux portent ce nom » était faux : le compte ramassait tous les préfixes,
    // donc Vernonia et Vernon Hills, qui ne portent pas ce nom. On ne compte que les vrais
    // homonymes. Et on dédoublonne à l'affichage sur (nom, pays, position au dixième de
    // degré) : GeoNames décrit souvent une même commune deux fois — la commune et son
    // chef-lieu — avec des populations légèrement différentes, et la liste bégayait
    // « Vernon (FR), Vernon (FR) ». Le dixième de degré (~11 km) sépare deux communes
    // homonymes réelles sans séparer deux descriptions du même lieu.
    const memeNom = trouves.filter((c: any[]) => normLieu(c[0]) === normLieu(nom));
    const vus = new Set<string>();
    const homonymes = memeNom.filter((c: any[]) => {
      const cle = `${normLieu(c[0])}|${c[1]}|${c[2].toFixed(1)}|${c[3].toFixed(1)}`;
      if (vus.has(cle)) return false;
      vus.add(cle);
      return true;
    }).slice(1);

    const autres = homonymes.length
      ? `<p class="rl-autres">${L.ambiguous.replace("{n}", String(homonymes.length))} `
        // Le pays seul ne départage pas : la France a plusieurs Vernon. La population, si.
        + homonymes.slice(0, 3).map((c: any[]) =>
            `<span>${c[0]} (${situe(c[5], c[1])}${c[4] ? `, ${c[4].toLocaleString()} ${L.inhabitants}` : ""})</span>`).join(", ")
        + "</p>"
      : "";

    // Le prolongement du scénario : le lecteur sait « 5,5 km », il veut savoir DE QUEL CÔTÉ.
    // On passe la coordonnée, pas un niveau de zoom : c'est la carte qui sait jusqu'où ouvrir
    // pour que les voisins tiennent dans l'image, et elle le recalcule si le corpus bouge.
    const versCarte = `${L.mapPath}?lieu=${lat},${lon}&nom=${encodeURIComponent(nom)}`;

    blocLieu.innerHTML =
      `<p class="rl-titre">${L.none.replace("{lieu}", `<strong>${nom}</strong> (${situe(region, pays)})`)}</p>`
      + `<p class="rl-sous">${L.nearest}</p>`
      // La première cellule est VIDE et volontaire : elle tient la colonne des noms pour
      // que l'entête tombe exactement au-dessus des cases, pas à gauche de la ligne.
      + `<div class="rl-tete"><span></span>${enteteBandeau()}<span class="rl-km"></span>`
      + `<span class="rl-entete rl-noteconf-h">${L.gradeDoc ?? ""}</span></div>`
      + `<ol class="rl-liste">${items}</ol>`
      + `<a class="rl-carte" href="${versCarte}">${L.onMap.replace("{lieu}", nom)} ↗</a>`
      + autres
      + `<p class="rl-src">${L.source}</p>`;
    blocLieu.hidden = false;
  }

  function masquerBloc() {
    blocLieu.hidden = true;
    blocLieu.innerHTML = "";
  }

  function peutEtreUnLieu() {
    const saisie = searchInput.value.trim();
    if (!saisie) return masquerBloc();
    const visibles = Array.from(tbody.querySelectorAll("tr"))
      .some((r) => (r as HTMLElement).style.display !== "none");
    // Le bloc ne parle QUE dans le silence : si des lignes répondent, le lecteur a trouvé.
    if (visibles) return masquerBloc();
    void repondreParLieu(saisie);
  }

  [sortSel, orderSel, statusSel].forEach((el) => el.addEventListener("change", () => { apply(); marquerTri(); }));
  searchInput.addEventListener("input", () => { apply(); peutEtreUnLieu(); });
  apply(false);
  marquerTri();
  peutEtreUnLieu();
</script>
