---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// The proof page, shared FR/EN (i18n §13: one template, per-language t object —
// duplicated pages is how EN silently diverged). Rendered from the engine's
// dc/{id}.json artifact (never hand-written); a grade letter only ever appears
// through <ScoreBadge>. Bilingual data reads label[lang]/synthesis .fr/.en.
import Base from "../layouts/Base.astro";
import type { NavNode } from "../config/nav";
import ScoreBadge from "./ScoreBadge.astro";
import PillarIcon from "./PillarIcon.astro";
import type { PillarIconName } from "./PillarIcon.astro";
import SourceLink from "./SourceLink.astro";
import DossierEnvironnemental from "./DossierEnvironnemental.astro";
import methodologyData from "../../public/data/methodology.json";
import { STATS, fmtPct } from "../config/stats";
import { operateurIdentifie } from "../config/operator";
import { COUNTRY_NAME } from "../config/flags";
import { libelleValeur, libelleUnite, phraseFacteurDominant } from "../config/indicatorValues";

import xLogo from "@phosphor-icons/core/assets/regular/x-logo.svg?raw";
import whatsappLogo from "@phosphor-icons/core/assets/regular/whatsapp-logo.svg?raw";
import linkedinLogo from "@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw";
import envelope from "@phosphor-icons/core/assets/regular/envelope-simple.svg?raw";
import linkSimple from "@phosphor-icons/core/assets/regular/link-simple.svg?raw";
import downloadSimple from "@phosphor-icons/core/assets/regular/download-simple.svg?raw";
import shareNetwork from "@phosphor-icons/core/assets/regular/share-network.svg?raw";
import infoIcon from "@phosphor-icons/core/assets/regular/info.svg?raw";
import mapPin from "@phosphor-icons/core/assets/regular/map-pin.svg?raw";

const { dc, lang, t, nav, altHref, altLabel, related = [], geo = null } = Astro.props as {
  dc: any; lang: "fr" | "en"; t: any; nav: NavNode[];
  altHref: string; altLabel: string; related?: any[];
  geo?: [number, number] | null;
};

// T0 « Les chiffres du parc » : la ligne contextuelle — ce site situé dans les
// agrégats de SON pays (jamais un jugement, une position dans le parc).
const _fleetPeri = (STATS as any).perimeters?.[dc.country];
const _fleetInd = (iid: string) => (dc.indicators || []).find((i: any) => i.id === iid);
const _FLEET_RULES: [string, string, (v: any) => boolean, string][] = [
  ["grid_saturated", "E2", (v) => v === "saturated", "reseau-sature"],
  ["water_stress_high", "W1", (v) => v === "high" || v === "zre_or_crisis", "stress-hydrique"],
  ["soil_artificialized", "F2", (v) => v === "artificialized", "sols-artificialises"],
];
let fleetLine: { text: string; href: string } | null = null;
if (_fleetPeri && (t as any).fleet) {
  for (const [statId, iid, pred, anchorId] of _FLEET_RULES) {
    const stat = _fleetPeri.stats?.[statId];
    const ind = _fleetInd(iid);
    if (stat && ind && ["measured", "announced", "verified"].includes(ind.status) && pred(ind.value)) {
      // `base` n'a PAS de barre finale : elle est ajoutée une seule fois dans `href`, sinon
      // le périmètre France produisait « /fr/chiffres//#… » et l'anglais « /figures//#… ».
      const base = /* i18n:route */ lang === "fr"
        ? (dc.country === "FR" ? "/fr/chiffres" : `/fr/chiffres/${dc.country.toLowerCase()}`)
        : `/figures/${dc.country.toLowerCase()}`;
      fleetLine = {
        text: (t as any).fleet[statId].replace("{pct}", fmtPct(stat.pct, lang)),
        href: `${base}/#${anchorId}`,
      };
      break;
    }
  }
}
const methodology = methodologyData as any;

// Indices pays (brief 2026-07-18/19 §2.3) : la ligne de croisement — l'indice
// SITE du pays de cette fiche, avec sa réserve A-25 si elle s'applique.
import indicesData from "../../public/data/indices.json";
import { COUNTRY_NAMES } from "../config/indices";
const _idxEntry = (indicesData as any).countries?.[dc.country];
let idxLine: { text: string; href: string } | null = null;
if (_idxEntry?.eligible) {
  const cname = (COUNTRY_NAMES as any)[dc.country]?.[lang] ?? dc.country;
  // La virgule décimale est un FORMAT, pas un mot : elle suit la locale et n'a rien à faire
  // dans la table — une langue nouvelle n'aurait pas à décider comment on écrit « 3,4 ».
  const score = /* i18n:format */ lang === "fr" ? String(_idxEntry.score).replace(".", ",") : String(_idxEntry.score);
  const res = _idxEntry.reserved_from === "A" ? t.idx.reserved : "";
  idxLine = {
    text: t.idx.line
      .replace("{country}", cname)
      .replace("{grade}", _idxEntry.grade)
      .replace("{reserved}", res)
      .replace("{score}", score),
    href: `${/* i18n:route */ lang === "fr" ? "/fr" : ""}/indices/?pays=${dc.country}`,
  };
}

const SITE_ORIGIN = "https://scoremydatacenter.org";
const ficheBase = /* i18n:route */ lang === "fr" ? "/fr/dc" : "/dc";
// En-veille: the public grade is withheld ("note en attente") — the site is
// visible with its facts, but no letter is shown anywhere (leak-safe by data
// scrub). For desalination-dominant countries (Israel now) we carry the
// validated water×desalination note so the fiche isn't mute on the "why".
// Loupe — provisional coverage band on a PIPELINE project (servable_band → dc/{id}.json.provisional_band).
// Servable → big central letter + a small chip per edge; band withheld → the neutral en_attente chip.
const pband = (dc as any).provisional_band;
// RÈGLE C-BIS (Franck, 2026-10-16) : une fenêtre PLUS LARGE que le plancher n'est plus muette.
// Elle porte la note probable (le point renormalisé) et ses bornes — « probable E · distribué
// E–C » dit min, max et tendance là où « en attente » ne disait rien. Le `kind` reste
// "en_attente" côté moteur ; ce qui change est ce qu'il TRANSPORTE, d'où le test sur `central`
// et non sur le kind seul. Une fiche tenue en veille n'a plus de bande du tout (blanchie par la
// couche de service) : elle retombe donc sur la puce neutre sans rien savoir d'ici.
const bandWide = pband?.kind === "en_attente" && typeof pband.central === "string";
const hasLoupe = (pband?.kind === "provisional_band" || bandWide) && typeof pband.central === "string";
// A withheld band is « en attente » on the PAGE too, not just in the <title>. Without the second
// clause the badge fell back to the definitive letter from grades.site: the SERP announced « note
// en attente » while the page showed a firm D — the site contradicting itself on the one thing it
// sells, on 15 pipeline fiches (constaté le 2026-09-30, antérieur à la règle C). An operational
// fiche has no band at all, so it keeps its definitive letter untouched.
// « En attente » = AUCUNE lettre publiable. Dès que la loupe s'ouvre (plage au plancher OU
// fenêtre large portant un probable), la fiche PUBLIE une lettre : elle n'est plus en attente,
// et le bloc d'explication comme le titre doivent suivre — sans quoi la page dirait « pas
// encore notée » juste au-dessus d'une note.
const isEnAttente = !hasLoupe && (dc.grades?.site?.grade === "en_attente" || pband?.kind === "en_attente");
// Le libellé du badge dit le FAIT, rien de plus : « note probable : D, fenêtre C–E ». La
// phrase longue du moteur (« la plage se resserre à la collecte ») prenait trois lignes dans
// la barre latérale et disait ce que le bloc « pourquoi cette note ? » explique en entier.
const provLabel = bandWide
  ? t.prov.probable.replace("{central}", pband.central)
      + (pband.band && pband.band !== pband.central ? t.prov.window.replace("{band}", pband.band) : "")
  : t.prov.narrowing;
// Les lettres citées dans la prose portent leur couleur (.note-inline, global.css).
const noteChip = (g: string) => `<span class="note-inline n-${g.toLowerCase()}">${g}</span>`;
const bandChips = (b: string) => b.split("–").map(noteChip).join("–");
const isDesalCountry = dc.country === "IL";
const mapPath = /* i18n:route */ lang === "fr" ? "/fr/carte/" : "/map/";
const pageUrl = `${SITE_ORIGIN}${ficheBase}/${dc.id}/`;
const L = (obj: any) => obj?.[lang] ?? obj?.fr ?? "";
// The synthesis `lead` is per-language like the body. Back-compat: older records carry a bare
// string (single language) — render it as-is until they are regenerated. New records carry
// {fr,en,…}, resolved by the active locale exactly like the body, so adding a language is a locale,
// not a code change (i18n §13: "la langue suit le pays").
const Lead = (block: any) => (typeof block?.lead === "string" ? block.lead : L(block?.lead));
// L'ordre des composantes d'une date est un FORMAT, pas un mot.
const fmtDate = (iso: string | null) => (iso ? (/* i18n:format */ lang === "fr" ? iso.split("-").reverse().join("/") : iso) : "");

const pillarIconName: Record<string, PillarIconName> = {
  energy: "energy",
  water: "water",
  land_biodiversity: "land",
  local_impact: "local",
  transparency_governance: "transparency",
};

const shareIcon: Record<string, string> = {
  x: xLogo, whatsapp: whatsappLogo, linkedin: linkedinLogo,
  mail: envelope, copy: linkSimple, download: downloadSimple, native: shareNetwork,
  info: infoIcon, map: mapPin,
};
const icon = (name: string, size = 18) =>
  shareIcon[name].replace("<svg", `<svg width="${size}" height="${size}" fill="currentColor" aria-hidden="true"`);

const isNa = (g: any) => !g || g.grade === "insufficient_data";
const siteDocLabel = L(dc.grades.site.documentation?.label);
const ppDocLabel = isNa(dc.grades.project_process)
  ? t.naLabel
  : L(dc.grades.project_process.documentation?.label);

const confPct = Math.round((dc.confidence.score ?? 0) * 100);

const commissioning = dc.vintage?.expected_commissioning;
// Power carries its documentation status (measured>announced>estimated, A-16 v0.1.x):
// an estimated figure is flagged « ~X MW · estimé » (prudence family), never served
// as a bare fact. null/legacy → plain, unchanged.
const powerEstimated = dc.power_mw && dc.power_mw_status === "estimated";
// An estimate is a raw model float (e.g. 0.518008551) — round it for display so the
// figure READS as approximate (precision loss is the point). Measured/announced/legacy
// values are shown untouched.
// 2 significant figures — aligned with the source rounding (data-pipeline 949bc49):
// idempotent, so source ≈ display (no double-round), and defensive if a raw float slips.
const roundEst = (v: number) => Number(v.toPrecision(2));
const powerText = dc.power_mw
  ? `${powerEstimated ? `~${roundEst(dc.power_mw)}` : dc.power_mw} MW`
  : t.powerUnknown;
// Status proof (Franck 2026-09-17): an operational fiche says whether its « en service » is
// independently confirmed (weekly job, PeeringDB) or not yet — never silent, never guessed.
const sc = dc.project_status === "operational" ? dc.status_check : null;
const scDate = sc?.checked_at
  ? new Date(sc.checked_at + "T00:00:00Z").toLocaleDateString(lang, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })
  : "";
// Make the interconnected-network count READABLE (not just in the tooltip), Franck 2026-09-25.
// A NEUTRAL fact: shown only when > 0 — a private enterprise DC legitimately has zero networks, and
// zero is never implied to be worse (no count shown, no superlative for a high count).
const nNets = sc?.verified ? Number(sc.evidence?.networks ?? 0) : 0;
const netLabel = nNets > 0
  ? ` · ${nNets} ${nNets > 1 ? t.statusCheck.networksPlural : t.statusCheck.networksSingular}`
  : "";
const statusCheck = !sc ? null
  : sc.verified
    ? `<a class="st-ok" href="${sc.evidence?.url ?? "#"}" target="_blank" rel="noopener" title="${t.statusCheck.verifiedTip.replace("{date}", scDate).replace("{n}", String(sc.evidence?.networks ?? ""))}">✓ ${t.statusCheck.verified}${netLabel}</a>`
    : `<span class="st-unv" title="${t.statusCheck.unverifiedTip}">${t.statusCheck.unverified}</span>`;
const metaLine = [t.status[dc.project_status] ?? dc.project_status,
  statusCheck,
  powerText,
  powerEstimated ? `<span class="pw-est">${t.powerEstimated}</span>` : null,
  commissioning ? `${t.commissioning} ${commissioning}` : null].filter(Boolean).join(" · ");

// Operator (Franck 2026-09-17): shown when known; a register-resolved one links to its SIRENE entry.
// « Connu » se décide à UN seul endroit (config/operator.ts) : trois copies de la réponse
// vivaient ici, dans related.ts et dans le balisage, et elles divergeaient.
const hasOperator = operateurIdentifie(dc.operator);
// Distance aux premières habitations (Franck 2026-09-21) : un FAIT à côté de la note, jamais dedans.
// « environ », car la mesure vise le centre de l'objet OSM ; une zone résidentielle (bâti non tagué,
// fréquent en rural) est dite comme telle, jamais présentée comme une maison.
const dwell = dc.nearest_dwelling;
const place = [dc.municipality, dc.admin_area ? `(${dc.admin_area})` : null].filter(Boolean).join(" ")
  + (dc.country ? ` · ${dc.country}` : "");

// L'ÉNUMÉRATION DOIT BOUCLER. Elle listait mesurés + annoncés + manquants et s'arrêtait là :
// sur ce site-ci, 6 + 0 + 5 = 11 d'un total annoncé de 26. Les quinze autres — ceux que nous
// n'avons pas cherchés — disparaissaient du compte, c'est-à-dire que la plus grosse part de
// notre ignorance était la seule à ne pas être dite. Les estimations manquaient aussi.
const counts = { measured: 0, announced: 0, estimated: 0, missing: 0, not_collected: 0 } as Record<string, number>;
for (const ind of dc.indicators) counts[ind.status] = (counts[ind.status] ?? 0) + 1;
const dataState = t.dataState
  .replace("{n}", String(dc.indicators.length))
  .replace("{measured}", String(counts.measured + counts.estimated))
  .replace("{announced}", String(counts.announced))
  .replace("{missing}", String(counts.missing))
  .replace("{notCollected}", String(counts.not_collected));

// Direct publication (2026-07-15, legal review): the permanent response space is
// publication.operator_response — attributed, dated, shown whenever present.
const op = dc.publication.operator_response;
const lastScored = dc.score_history.length ? dc.score_history[dc.score_history.length - 1].date : null;

const indicatorValue = (ind: any) => {
  if (ind.status === "missing") return t.notDisclosed;
  // Une clé technique n'est pas une phrase : `none_within_5km` se lit « aucun site
  // recensé … à notre connaissance ». La réserve est obligatoire sur une absence.
  if (ind.value !== null && ind.value !== undefined) return libelleValeur(ind.id, ind.value, lang);
  if (ind.proxies) return t.procedureSeeSource;
  return "—";
};

// T1 procedural facts (A-21 voie A): neutral facts, never a judgment (G6).
const proxyFacts = (p: any): string[] => [
  p.public_inquiry_held ? t.proxy.inquiryHeld : t.proxy.inquiryNone,
  t.proxy.envOpinion[p.environmental_authority_opinion],
  p.cndp_referral ? t.proxy.cndpYes : t.proxy.cndpNo,
  `${t.proxy.appeals} ${p.legal_appeals_count}`,
  t.proxy.council[p.council_deliberations],
].filter(Boolean) as string[];

// Methodology meta per indicator — units, scoring direction, threshold basis.
const indMeta: Record<string, any> = {};
for (const i of methodology.indicators) indMeta[i.id] = i;
// Une unité qui est une PHRASE se traduit (« emplois permanents pour 100 MW ») ;
// une notation standard reste telle quelle (gCO2e/kWh, PUE, L/kWh).
const indUnit = (id: string) => {
  const u = indMeta[id]?.unit ?? "";
  return u ? libelleUnite(u, lang) : "";
};
const indTooltip = (id: string) => {
  const m = indMeta[id];
  if (!m) return "";
  const desc = L(m.description) ?? "";
  const hint = t.directionHint[m.direction] ?? "";
  // avoid repeating the hint when the description already ends with it
  return [desc, desc.includes(t.hintDedupe) ? "" : hint].filter(Boolean).join(" ");
};
const senseBand = (score: number | null | undefined) => {
  if (score === null || score === undefined) return null;
  if (score >= 66) return { cls: "good", label: t.sense.good };
  if (score >= 40) return { cls: "mid", label: t.sense.mid };
  return { cls: "bad", label: t.sense.bad };
};
// Grouped by pillar (methodology order) — 5 labelled blocks instead of 21 flat rows.
const indByPillar = (methodology.pillars as any[])
  .map((p: any) => ({ pillar: p, items: dc.indicators.filter((ind: any) => ind.pillar === p.id) }))
  .filter((g: any) => g.items.length);

const shareText = t.shareText
  .replace("{name}", dc.name)
  .replace("{grade}", isNa(dc.grades.site) ? t.naLabel : dc.grades.site.grade)
  + (siteDocLabel ? ` · ${siteDocLabel}` : "") + t.shareSuffix;
const enc = encodeURIComponent;
const shareLinks = {
  x: `https://twitter.com/intent/tweet?text=${enc(shareText)}&url=${enc(pageUrl)}`,
  whatsapp: `https://wa.me/?text=${enc(shareText + " " + pageUrl)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(pageUrl)}`,
  mail: `mailto:?subject=${enc(dc.name + " — ScoreMyDataCenter")}&body=${enc(shareText + "\n\n" + pageUrl)}`,
};

const pillars = methodology.pillars as any[];

// LA CARTE DE CONTEXTE SUIT LA LANGUE DE LA PAGE, PAS LE PAYS DE LA FICHE (Franck,
// 2026-10-05). Un lecteur francophone sur une fiche néerlandaise doit voir l'image en
// français, et un anglophone sur une fiche française la voir en anglais : l'image est faite
// pour voyager hors de son contexte, souvent vers un élu local, et c'est SA langue qui compte.
// Repli sur l'ancienne URL unique tant qu'une fiche n'a pas reçu ses deux variantes — sans
// quoi il faudrait livrer les 1366 cartes d'un coup, ou laisser des fiches sans image.
const ctxUrl: string | null = dc.context_map
  ? (dc.context_map.urls?.[lang] ?? dc.context_map.urls?.fr ?? dc.context_map.url ?? null)
  : null;

// SUR QUOI LA NOTE D'UN PILIER REPOSE. La renormalisation retire les indicateurs
// non observés du dénominateur — ce qui est le bon choix (un 0 pour ce qu'on n'a
// jamais lu pénaliserait notre ignorance), mais elle est SILENCIEUSE : un pilier
// porté par un seul point se lit comme un pilier complet. Mesuré le 2026-10-05 :
// 779 fiches ont un pilier porté par un seul indicateur, qui y pèse 38 % de la
// note. On ne change pas le calcul (décision Franck), on le DIT.
//
// Pas de pourcentage affiché : il varie d'une fiche à l'autre (24 à 38 %) et un
// chiffre figé rassurerait à tort. Le nom de l'indicateur est la partie utile —
// le lecteur peut aller lire sa valeur dans le tableau juste en dessous.
const socleParPilier: Record<string, string[]> = {};
for (const i of methodology.indicators as any[]) {
  if (i.block === "base") (socleParPilier[i.pillar] ??= []).push(i.id);
}
const OBSERVE = ["measured", "announced", "estimated"];
const phraseDrag = phraseFacteurDominant(dc.dominant_drag, lang);

const pillarBasis = (pid: string): string => {
  const ids = socleParPilier[pid];
  if (!ids?.length) return "";   // Transparence : aucun indicateur de socle, par construction
  const vus = dc.indicators.filter((x: any) => ids.includes(x.id) && OBSERVE.includes(x.status));
  if (!vus.length) return "";
  if (vus.length === 1) {
    const lbl = indMeta[vus[0].id]?.label;
    return `${t.pillarBasis.one} ${t.quoteOpen}${L(lbl) || vus[0].id}${t.quoteClose}`;
  }
  return "";   // au-delà d'un seul point, ce sont les MANQUANTS qu'on nomme (voir pilierManque)
};

// CE QUI MANQUE, NOMMÉ. Le compte « 2 indicateurs sur 3 » disait le NOMBRE alors que c'est le
// POIDS qui décide : deux piliers au même compte n'ont pas la même note, et le lecteur ne
// pouvait pas le savoir. On nomme donc les absents au lieu de les compter.
//
// Aucun pourcentage, aucune jauge (Franck, 2026-10-20) : publier la couverture en poids
// livrerait la calibration — le corpus expose 11 motifs de présence pour 6 poids en énergie,
// 9 pour 4 en eau, et une douzaine de fiches suffisent à résoudre le système.
//
// Et aucun qualificatif : pas de « les plus déterminants », car la hiérarchie EST le poids.
// Pour la même raison la liste suit l'ordre des ID, jamais l'ordre des poids — l'ordre seul
// livrerait le classement qu'on refuse de publier.
const notantsParPilier: Record<string, string[]> = {};
for (const i of methodology.indicators as any[]) {
  if (i.mvp) (notantsParPilier[i.pillar] ??= []).push(i.id);
}
const pilierManque = (pid: string): string => {
  const ids = notantsParPilier[pid] ?? [];
  const absents = ids
    .filter((id) => !dc.indicators.some((x: any) => x.id === id && OBSERVE.includes(x.status)))
    .sort();
  if (!absents.length || absents.length === ids.length) return "";
  const noms = absents.map((id) => L(indMeta[id]?.label) || id);
  return `${t.pillarMissing} ${noms.join(", ")}.`;
};

// LA PORTÉE DE LA SOUS-NOTE : parle-t-elle de ce site, ou du pays ? Dérivée au build sur tout
// le corpus (engine/artifacts.pillar_scope_fields) — jamais une liste écrite à la main, qui
// dériverait au premier pays ajouté. Une lettre juste peut ne rien dire DE CE SITE-LÀ : si le
// seul indicateur qui la porte prend la même valeur partout dans le pays, elle décrit le pays.
const paysNom = COUNTRY_NAME[dc.country]?.[lang] ?? dc.country;
const pilierPortee = (pid: string): string => {
  const p = dc.pillar_scope?.[pid];
  if (p === "national") return t.pillarScope.national.replace("{pays}", paysNom);
  if (p === "pays_mince") return t.pillarScope.thin;
  return "";
};

// --- JSON-LD : dire la fiche aux machines, sans prétendre plus que la page ---------------
// Pas de balisage Rating pour l'instant : c'est un test à mener (éligibilité Google, mapping
// A=5…E=1), pas un go ferme, et un balisage d'avis sur une entreprise nommée se relit deux
// fois avant d'être posé. On décrit donc le LIEU et la page, pas un verdict.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Place",
  name: dc.name,
  url: `${SITE_ORIGIN}${/* i18n:route */ lang === "fr" ? "/fr" : ""}/dc/${dc.id}/`,
  // 🔴 Le balisage est la pire des quatre fuites : il AFFIRME à une machine, sans prose
  // autour pour nuancer, que l'exploitant de ce site est une société nommée « opérateur non
  // identifié ». C'est ce qui était publié sur 162 fiches jusqu'au 2026-10-17. Même prédicat
  // que l'affichage : une seule réponse à « l'opérateur est-il identifié ? ».
  ...(operateurIdentifie(dc.operator)
    ? { additionalProperty: [{ "@type": "PropertyValue", name: t.schemaOperator, value: dc.operator }] }
    : {}),
  address: {
    "@type": "PostalAddress",
    ...(dc.municipality ? { addressLocality: dc.municipality } : {}),
    ...(dc.admin_area ? { addressRegion: String(dc.admin_area) } : {}),
    ...(dc.country ? { addressCountry: dc.country } : {}),
  },
  // 🔴 LA COORDONNÉE EST CELLE DE LA CARTE PUBLIQUE, arrondie à ~1 km — pas celle du
  // corpus. L'arrondi est une décision d'exposition prise une fois ; republier la position
  // exacte ici la défairait en silence, et une machine lirait ce que la carte refuse de
  // montrer. Le balisage dit donc exactement ce que le site montre, ni plus fin ni autre.
  ...(geo ? { geo: { "@type": "GeoCoordinates", latitude: geo[1], longitude: geo[0] } } : {}),
  ...(dc.content_changed_at ? { dateModified: dc.content_changed_at } : {}),
  isPartOf: { "@type": "WebSite", name: "ScoreMyDataCenter", url: SITE_ORIGIN },
};

// Fil d'Ariane : il dit la place de la fiche dans le site, et c'est aussi ce qui permet à un
// moteur d'afficher « ScoreMyDataCenter › Carte › {commune} » plutôt qu'une URL nue.
const racine = `${SITE_ORIGIN}${/* i18n:route */ lang === "fr" ? "/fr" : ""}`;
const filAriane = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ScoreMyDataCenter", item: `${racine}/` },
    { "@type": "ListItem", position: 2, name: t.breadcrumbMap, item: `${racine}/${/* i18n:route */ lang === "fr" ? "carte" : "map"}/` },
    { "@type": "ListItem", position: 3, name: dc.name, item: `${racine}/dc/${dc.id}/` },
  ],
};

// --- Unité de distance : elle suit le LIEU, pas le moteur (Franck 2026-10-17) ------------
// « 17 km away » sur un site de Virginie ne dit rien à l'habitant qui le cherche. L'unité
// d'un voisinage est une convention locale, et la page anglaise d'un site américain est
// précisément celle que ce lecteur-là ouvre. La page française garde le kilomètre : son
// lecteur à elle est métrique, même quand le site est au Maryland.
//
// ⚠️ ON NE CONVERTIT QUE CETTE DISTANCE-LÀ. Les bandes d'indicateur (« zone protégée à
// 1–5 km ») sont des SEUILS de la grille, identiques dans tous les pays : réécrites en
// miles elles donneraient « 0,6–3,1 miles », une précision que personne n'a posée et une
// frontière que la méthodologie ne reconnaîtrait pas. Un seuil se cite dans son unité.
//
// La liste est un ENSEMBLE, pas un `if` : y ajouter le Royaume-Uni (qui compte aussi ses
// distances en miles) doit être un mot, pas une condition de plus à retrouver.
const PAYS_EN_MILES = new Set(["US"]);
const enMiles = lang === "en" && PAYS_EN_MILES.has(dc.country);
// 🔴 PLANCHER DE PRÉCISION — la coordonnée publiée est ARRONDIE À ~1 km, c'est une décision
// d'exposition prise une fois (voir le balisage GeoCoordinates plus bas). Une distance
// calculée entre deux points arrondis ne peut donc rien affirmer sous le kilomètre : les
// « 0,0 km » servis sur 238 fiches ne disaient pas « ces deux data centers sont au même
// endroit », ils disaient « nos deux points sont tombés dans la même case ». On publiait la
// trace de notre propre arrondi comme si c'était une mesure.
// La phrase de repli est vraie dans les deux unités : sous 1 km, c'est aussi sous un mile.
const PLANCHER_KM = 1;
// Même règle d'arrondi dans les deux unités : sous 10, une décimale ; au-delà, l'entier.
// Une distance de voisinage à trois décimales ferait croire à une mesure de géomètre.
const distanceVoisin = (km: number) => {
  // Gabarit absent = build rouge, et c'est voulu : une unité déclarée sans ses phrases doit
  // s'entendre, pas se replier en silence sur l'autre unité.
  if (km < PLANCHER_KM)
    return enMiles ? t.related.relation.nearbyUnderMi : t.related.relation.nearbyUnder;
  const v = enMiles ? km / 1.609344 : km;
  const n = v < 10 ? v.toFixed(1) : String(Math.round(v));
  return (enMiles ? t.related.relation.nearbyMi : t.related.relation.nearby)
    .replace(enMiles ? "{mi}" : "{km}", n);
};

// --- SEO : titre daté, sur TOUTES les fiches (Franck 2026-09-29) -------------------------
// Motif : la date rend bénigne une SERP en retard sur un changement de note — cas vécu avec
// Fouju passée de E à D pendant que Google servait encore l'ancienne. « Pas d'exceptions qui
// pourrissent le code » : aucune variante sans date, y compris pour les notes provisoires.
// La note affichée est celle qu'on PUBLIE — fourchette provisoire ou « en attente », jamais
// une lettre ferme là où on publie une plage : un titre de SERP est lu comme un verdict.
const seoBand = dc.provisional_band ?? {};
const seoGrade = seoBand.kind === "en_attente" && typeof seoBand.central === "string"
  // Fenêtre large : le titre annonce la note PROBABLE. Écrire « note en attente » au-dessus
  // d'une page qui affiche « probable E » rejouerait exactement la contradiction SERP↔page
  // constatée le 2026-09-30.
  ? t.seo.probable.replace("{central}", seoBand.central)
  : seoBand.kind === "en_attente"
  ? t.seo.pending
  : seoBand.kind === "provisional_band" && seoBand.band
    ? t.seo.provisional.replace("{band}", seoBand.band)
    // L'axe site peut lui aussi être retiré faute de données (seuil `min_site_coverage`,
    // 2026-10-02). Sans ce cas, le titre sortait « note insufficient_data » — l'énumération
    // interne, en anglais, dans l'onglet du navigateur et dans les résultats de recherche.
    : dc.grades.site.grade === "insufficient_data"
      ? t.seo.insufficient
      : t.seo.grade.replace("{grade}", dc.grades.site.grade);
const seoPlaceRaw = dc.municipality ?? dc.admin_area ?? dc.country ?? "";
// « Campus IA Fouju (Fouju) » : quand le nom du site porte déjà sa commune, la parenthèse
// est du bruit qui mange la largeur utile du titre en SERP.
const seoPlace = seoPlaceRaw && !dc.name.toLowerCase().includes(String(seoPlaceRaw).toLowerCase())
  ? seoPlaceRaw : "";
// 🔴 LE TITRE NE PORTAIT PAS LE MOT « DATA CENTER » (audit SEO, 2026-10-16). « Campus IA
// Fouju : note provisoire E–D » ne répond pas à « data center Fouju » — la requête d'un
// riverain ou d'un élu, c'est-à-dire exactement notre lecteur. On nomme donc la CATÉGORIE et
// la COMMUNE, sans toucher aux deux règles déjà acquises : la date sur toutes les fiches, et
// une note qui n'affirme jamais plus que ce qu'on publie (plage, « en attente »).
// ⚠️ La commune est répétée même quand le nom la contient (« Campus IA Fouju, data center à
// Fouju ») : la redondance coûte quelques caractères, l'absence coûtait la requête.
const seoLieuSansRegion = dc.municipality
  ? t.seo.place.replace("{municipality}", dc.municipality)
  : "data center";
const seoLieu = seoLieuSansRegion + (dc.municipality && dc.admin_area ? ` (${dc.admin_area})` : "");
// 🔴 LE TITRE ÉTAIT COUPÉ AVANT LA NOTE — SUR 100 % DES FICHES (Search Console, 2026-10-23).
// Mesuré : médiane 92 caractères, p90 109, max 142, quand Google en affiche ~60. Le lecteur
// voyait « Digital Realty Frankfurt FRA28 (Closed), data center in Frankf… » et JAMAIS
// « : grade D » — c'est-à-dire la seule chose qui nous distingue des neuf annuaires qui
// occupent la page sur ces requêtes. Notre différence était systématiquement tronquée.
//
// L'ordre suit donc ce qui doit survivre à la coupure : le NOM (c'est lui qu'on cherche), la
// NOTE (c'est elle qui nous distingue), puis le lieu. La catégorie « data center » reste —
// elle avait été ajoutée le 2026-10-16 parce qu'un titre sans elle ne répondait pas à « data
// center {commune} » — mais elle passe derrière la note, qui est plus rare et plus décisive.
//
// LA DATE SORT DU TITRE. Elle coûtait 25 caractères, n'était jamais affichée, et la fraîcheur
// se dit déjà par `lastmod` au sitemap et par la date en clair sur la page.
// 🔴 LE REPLI SUPPRIMAIT LE LIEU SUR 57 % DU CORPUS — 1 882 fiches (mesuré 2026-10-26).
// L'ordre (nom, note, lieu) reste celui du 2026-10-23 et il est bon. Ce qui était faux est
// l'étape « si > 65, j'efface le lieu » : 65 caractères est une limite d'AFFICHAGE, Google
// indexe et classe sur le titre ENTIER. Tronquer coûte de la lisibilité sur la dernière
// partie ; supprimer coûte le classement sur « data center {commune} » — c'est-à-dire la
// SEULE intention française mesurée (huit des dix suggestions de Google sur « data center »
// sont des communes à projet ; personne ne cherche une note).
//
// On dégrade donc dans l'ordre du moins coûteux, et le lieu ne part jamais : la région entre
// parenthèses d'abord (-815 fiches au-dessus de la limite), et c'est tout.
const seoTitle = [
  `${dc.name} — ${seoGrade} | ${seoLieu}`,
  `${dc.name} — ${seoGrade} | ${seoLieuSansRegion}`,
].find((s) => s.length <= 65) ?? `${dc.name} — ${seoGrade} | ${seoLieuSansRegion}`;
// La meta reprend l'accroche générée du contrat d'artefact plutôt qu'un gabarit : c'est une
// phrase écrite pour CE site, donc un extrait SERP qui dit quelque chose.
const seoLead = dc.synthesis?.site?.lead?.[lang];
const seoDesc = seoLead
  ? `${seoLead} — ${dc.name}, ${seoLieu}. ${seoGrade.charAt(0).toUpperCase()}${seoGrade.slice(1)}, `
    + t.seo.tail
  : t.metaDescription.replace("{name}", dc.name).replace("{municipality}", dc.municipality);
---

<Base
  lang={lang}
  title={seoTitle}
  description={seoDesc}
  tagline={t.tagline}
  altHref={altHref}
  altLabel={altLabel}
  nav={nav}
  ogImage={`${SITE_ORIGIN}/og/dc/${dc.id}.png`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(filAriane)}></script>
  <article class="fiche">
    <aside class="fiche-side">
      <div>
        <p class="fiche-kicker">{t.kicker}</p>
        <h1 class="fiche-name">{dc.name}</h1>
        <p class="fiche-place">{place}</p>
        {dwell && (
          <p class="fiche-meta fiche-dwell">
            {t.dwellLabel} <strong>~{dwell.distance_m} m</strong>
            <span class="dwell-src" title={dwell.kind === "landuse" ? t.dwellLanduse : t.dwellBuilding}>
              · {dwell.kind === "landuse" ? t.dwellLanduseShort : t.dwellBuildingShort}</span>
          </p>
        )}
        {hasOperator && (
          <p class="fiche-meta fiche-operator">
            {t.operatorLabel} {dc.operator_source
              ? <a class="op-src" href={dc.operator_source.url} target="_blank" rel="noopener" title={t.operatorFromRegister}>{dc.operator}</a>
              : dc.operator}
            {/* Developer-when-known (Franck 2026-09-25): a SOURCED register fact, never our verdict —
                the declared NAF activity + register link. Only present when R&D signed the case. */}
            {dc.developer_source && (
              <span class="fiche-dev"> — {t.developerDeclared} <a class="dev-src" href={dc.developer_source.url} target="_blank" rel="noopener">{/* i18n:donnee */ lang === "fr" ? dc.developer_source.activity_fr : dc.developer_source.activity_en}</a> <span class="dev-reg">({t.developerRegister})</span></span>
            )}
          </p>
        )}
        <p class="fiche-meta" set:html={metaLine}></p>
      </div>

      <div class="fiche-badges">
        {hasLoupe ? (
          <>
          <ScoreBadge
            label={t.siteScore}
            grade={dc.grades.site}
            band={{ central: pband.central, edges: pband.edges ?? null,
                    adjacent: pband.adjacent ?? null, a_reserved: pband.a_reserved,
                    wide: bandWide }}
            provisionalLabel={provLabel}
            confidence={pband.confidence ?? dc.confidence.level}
            confidenceLabel={t.confidence[pband.confidence ?? dc.confidence.level]}
            {/* « dossier peu sourcé » existait déjà dans la fiche et parle du DOSSIER, pas de
                ce que vaut la note : c'est exactement ce qu'on mesure. Rien à inventer. */}
            documentationLabel={t.confidenceNote[pband.confidence ?? dc.confidence.level]}
            reservedLabel={t.reserved}
            size="lg"
            naLabel={t.naLabel}
          />
          {bandWide && (
            /* Sans ce lien, la lettre et son axe arrivent sans rien pour appeler
               l'explication : le bloc qui dit d'où elle vient est plus bas dans la page et
               rien n'y menait. Une ancre, pas un repli — le bloc reste lisible pour qui
               arrive par la recherche ou imprime la page. */
            <a class="fiche-why" href="#note-probable">{t.whyLink}</a>
          )}
          </>
        ) : (
          <ScoreBadge
            label={t.siteScore}
            grade={pband?.kind === "en_attente" ? { ...dc.grades.site, grade: "en_attente" } : dc.grades.site}
            enAttenteLabel={t.pending.label}
            confidence={dc.confidence.level}
            confidenceLabel={t.confidence[dc.confidence.level]}
            documentationLabel={siteDocLabel}
            reservedLabel={t.reserved}
            size="lg"
            layout="lead"
            naLabel={t.naLabel}
          />
        )}
        <hr />
        <ScoreBadge
          label={t.ppScore}
          grade={dc.grades.project_process}
          confidence={dc.confidence.level}
          confidenceLabel={t.confidence[dc.confidence.level]}
          documentationLabel={ppDocLabel}
          reservedLabel={t.reserved}
          size="lg"
          layout="lead"
          naLabel={t.naLabel}
        />
      </div>

      {phraseDrag && (
        /* « Ce qui pèse le plus ici » — calculé à chaque build depuis le classement des
           contributions, jamais stocké (donc jamais périmé), et jamais conditionné à la
           distance au seuil : la seule présence de la phrase serait sinon la mesure de
           l'écart. Ce que la note DOIT au lecteur, c'est ce qui la tire — pas la recette. */
        <p class="fiche-drag">
          {phraseDrag}{" "}
          {/* LE MAILLON QUI FAIT UN PARCOURS AU LIEU DE TROIS SURFACES. Le lecteur vient
              d'apprendre ce qui tire CETTE note ; la question suivante est ce que valent les
              lettres. Sans ce lien, l'explication de la fiche et l'échelle vivent chacune de
              leur côté et personne ne passe de l'une à l'autre. */}
          <a href={/* i18n:route */ lang === "fr" ? "/fr/la-note-pas-a-pas/" : "/the-grade-step-by-step/"}>
            {t.lettersLink}
          </a>
        </p>
      )}

      <div class="fiche-conf">
        <span class="fiche-conf-label">{t.confGlobal}</span>
        <div class="fiche-conf-track"><i style={`width:${confPct}%`}></i></div>
        <span class="fiche-conf-note">{confPct} % — {t.confidenceNote[dc.confidence.level]}</span>
      </div>

      {/* Geographic context (Franck 2026-07-13): right below the confidence gauge,
          before the share block — geography is context, not content; the prime
          spot belongs to the written synthesis. */}
      <div class="fiche-side-map">
        {!ctxUrl && dc.satellite_image && (
          <figure class="fiche-sat">
            <a href={dc.satellite_image.url} target="_blank" rel="noopener">
              <img src={dc.satellite_image.thumb} alt={(t as any).satAlt?.replace("{name}", dc.name) ?? dc.name}
                width="400" height="267" loading="lazy" />
              {dc.project_status !== "operational" && (t as any).satStatusChip?.[dc.project_status] && (
                <span class="fiche-sat-chip">{(t as any).satStatusChip[dc.project_status]}</span>
              )}
            </a>
            <figcaption>
              {(t as any).satCaption?.replace("{municipality}", dc.municipality ?? "")} {dc.satellite_image.credit}
              {dc.project_status !== "operational" && (t as any).satStatusNote && (
                <> — {(t as any).satStatusNote}</>
              )}
            </figcaption>
          </figure>
        )}
        <span class="fiche-share-label">{t.miniMapTitle}</span>
        <div class="fiche-mini-map" data-dc={dc.id} data-grade={dc.grades.site.grade} data-fiche-base={ficheBase} aria-label={t.miniMapAria}>
          <div class="mini-map-canvas" aria-hidden="true"></div>
          <a class="mini-map-open" href={`${mapPath}?dc=${dc.id}`}>{t.openFullMap}</a>
        </div>
      </div>

      {/* PASSERELLE VERS L'AUTRE PERSONA. La fiche parle à qui lit vingt-six indicateurs ;
          le portrait parle à qui habite à côté. Mêmes faits, mêmes sources — l'un n'est pas
          une version simplifiée de l'autre, et c'est pour ça que le lien est explicite. */}
      <a class="fiche-portrait-link" href={`${ficheBase}/${dc.id}/portrait/`}>
        {t.portraitLink}<span>{t.portraitLinkSub}</span>
      </a>

      <div class="fiche-share">
        <span class="fiche-share-label">{t.share}</span>
        <div class="fiche-share-icons">
          <a href={shareLinks.x} target="_blank" rel="noopener" aria-label={t.shareOn + " X"} set:html={icon("x")}></a>
          <a href={shareLinks.whatsapp} target="_blank" rel="noopener" aria-label={t.shareOn + " WhatsApp"} set:html={icon("whatsapp")}></a>
          <a href={shareLinks.linkedin} target="_blank" rel="noopener" aria-label={t.shareOn + " LinkedIn"} set:html={icon("linkedin")}></a>
          <a href={shareLinks.mail} aria-label={t.shareMail} set:html={icon("mail")}></a>
          <button type="button" class="fiche-copy" data-url={pageUrl} data-copied={t.copied} aria-label={t.copyLink} set:html={icon("copy")}></button>
          <button type="button" class="fiche-share-native" data-url={pageUrl} data-text={shareText} aria-label={t.share} set:html={icon("native")}></button>
        </div>
        <a class="fiche-download" href={`/og/dc/${dc.id}.png`} download aria-label={t.download}>
          <span set:html={icon("download", 16)}></span>{t.download}
        </a>
        <a class="fiche-signal" href={`mailto:contact@scoremydatacenter.org?subject=${enc(`${t.signalSubject} — ${dc.id}`)}&body=${enc(t.signalBody.replace("{url}", pageUrl))}`}>
          <span set:html={icon("info", 16)}></span>{t.signal}
        </a>
        <p class="fiche-signal-note" set:html={t.signalNote}></p>
      </div>

      <p class="fiche-side-foot">{t.methodology} {methodology.version} · scoremydatacenter.org</p>
    </aside>

    <div class="fiche-main">
      {ctxUrl && (
        <figure class="fiche-ctx">
          <a href={ctxUrl} target="_blank" rel="noopener"
             aria-label={t.ctxMap.aria}>
            <img src={ctxUrl} alt={t.ctxMap.alt.replace("{name}", dc.name).replace("{municipality}", dc.municipality ?? "")}
              width="1200" height="900" loading="lazy" />
          </a>
        </figure>
      )}
      {bandWide && (
        /* Une note probable sans explication est une note ferme mal écrite : si la page montre
           « probable E · distribué E–C », elle doit dire d'où vient le E et pourquoi il bouge.
           Court volontairement — le détail du calcul vit dans « la note, pas à pas ». */
        <section class="fiche-enveille" id="note-probable" aria-label={t.probable.aria}>
          <p class="fiche-enveille-k">{t.probable.title}</p>
          <p class="fiche-enveille-lead" set:html={t.probable.lead.replace("{central}", noteChip(pband.central)).replace("{band}", bandChips(pband.band))} />
        </section>
      )}
      {isEnAttente && (
        <section class="fiche-enveille" aria-label={t.pending.label}>
          <p class="fiche-enveille-k">{t.pending.label}</p>
          <p class="fiche-enveille-lead">{t.pending.lead}</p>
          {isDesalCountry && (
            <div class="fiche-enveille-note">
              <p class="fiche-enveille-note-k">{t.desal.title}</p>
              <p>{t.desal.body}</p>
            </div>
          )}
        </section>
      )}
      <div class="fiche-top">
      <div class="fiche-subscores">
        <div class="fiche-subscores-head">
          <div>
            <h2>{t.subscoresTitle}</h2>
            <span class="fiche-subscores-sub">{t.subscoresSub}<span
              class="fiche-why" tabindex="0" role="note"
              aria-label={t.whyAria}
              title={t.whyTip}
              set:html={icon("info", 13)}></span></span>
          </div>
          <span class="fiche-legend"><span class="pillar-dots"><span class="on">●●●</span><span class="off">○</span></span> = {t.legendDoc}</span>
        </div>
        <div class="fiche-pillars">
          {pillars.map((p) => {
            const detail = dc.pillars[p.id];
            const dots = detail?.documentation?.dots;
            // RÈGLE C-BIS ÉTENDUE AUX PILIERS (Franck, 2026-10-23). La fiche publiait une note
            // probable en haut (« probable D, fenêtre B–E ») et cinq tirets en dessous, alors
            // que les deux sortent du MÊME calcul sur les MÊMES mesures. Le pilier porte donc
            // sa propre sous-note probable quand il tient sur au moins deux indicateurs
            // présents ; en dessous il reste muet, et son compte d'indicateurs parle à sa place.
            const sousBande = (dc as any).pillar_bands?.[p.id] ?? null;
            const note = detail?.grade && detail.grade !== "insufficient_data";
            // Une sous-note sans lettre n'a rien à qualifier : son état se lit sur le badge.
            const portee = note ? pilierPortee(p.id) : "";
            const basis = note ? pillarBasis(p.id) : "";
            // Quand un seul indicateur porte la note, énumérer les absents revient à dire
            // « tous les autres » : l'information est déjà dans la phrase du dessus, et le
            // tableau « Indicateurs suivis » porte le détail ligne par ligne.
            const manque = note && !basis ? pilierManque(p.id) : "";
            return (
              <div class="pillar-block">
              <div class="pillar-line">
                <span class="pillar-name"><PillarIcon name={pillarIconName[p.id]} size={16} />{L(p.label)}</span>
                <ScoreBadge
                  label={L(p.label)}
                  grade={detail}
                  band={sousBande}
                  confidence={dc.confidence.level}
                  confidenceLabel={t.confidence[dc.confidence.level]}
                  renderConfidence={false}
                  renderLabel={false}
                  size="sm"
                  naLabel={t.naLabel}
                />
                {dots ? (
                  <span class="pillar-dots">
                    <span class="on">{"●".repeat(dots)}</span><span class="off">{"○".repeat(4 - dots)}</span>
                  </span>
                ) : <span class="pillar-dots"></span>}
              </div>
              {portee && <p class="pillar-scope">{portee}</p>}
              {basis && <p class="pillar-basis">{basis}</p>}
              {manque && <p class="pillar-basis">{manque}</p>}
              </div>
            );
          })}
        </div>
      </div>
        <div class="fiche-top-right">
        {dc.synthesis && (
          <aside class="fiche-synthesis" aria-labelledby="synth-title">
            <div class="synth-head">
              <h2 id="synth-title">{t.synthTitle}</h2>
              <span class="synth-sub">{t.synthSub}</span>
            </div>
            <div class="synth-block synth-project">
              <span class="synth-tag">{t.synthProjectTag}</span>
              <span class="synth-lead">{Lead(dc.synthesis.project_process)}</span>
              <p>{L(dc.synthesis.project_process)}</p>
            </div>
            <div class="synth-block synth-site">
              <span class="synth-tag">{t.synthSiteTag}</span>
              <span class="synth-lead">{Lead(dc.synthesis.site)}</span>
              <p>{L(dc.synthesis.site)}</p>
            </div>
          </aside>
        )}
        {/* Thin file, nothing held: the spot still explains itself — we do not
            write an overall reading without sufficient facts (same doctrine as
            "we do not grade the unknown"). */}
        {!dc.synthesis && (
          <aside class="fiche-synthesis fiche-synthesis-empty">
            <div class="synth-head">
              <h2>{t.synthTitle}</h2>
              <span class="synth-sub">{t.synthSub}</span>
            </div>
            <p class="synth-empty-note">{t.synthEmptyNote.replace("{pct}", String(confPct))}</p>
          </aside>
        )}
        </div>
      </div>

      <blockquote class="fiche-quote"><p>{t.quoteOpen}{L(dc.citable_quote)}{t.quoteClose}</p></blockquote>

      {fleetLine && (
        <p class="fiche-fleetline">{fleetLine.text} <a href={fleetLine.href}>{(t as any).fleet.cta}</a></p>
      )}

      {idxLine && (
        <p class="fiche-idxline">{idxLine.text} <a href={idxLine.href}>{t.idx.cta} →</a></p>
      )}

      {/* L'avis d'autorité environnementale, À CÔTÉ de la note et jamais dedans : il arrive
          après la synthèse (qui, elle, s'appuie sur les indicateurs notés) et avant le
          tableau, pour qu'on ne puisse pas lire ses chiffres comme une composante du score.
          Présent sur les seules fiches dont le rattachement avis→site est sûr. */}
      {dc.environmental_dossier && (
        <DossierEnvironnemental dossier={dc.environmental_dossier} lang={lang} />
      )}

      <section class="fiche-section" aria-label={t.indicatorsTitle}>
        <h2>{t.indicatorsTitle}</h2>
        <div class="fiche-ind-wrap">
          <table class="fiche-ind">
            <thead>
              <tr><th>{t.th.indicator}</th><th>{t.th.value}</th><th>{t.th.reading}</th><th>{t.th.state}</th><th>{t.th.source}</th></tr>
            </thead>
            <tbody>
              {indByPillar.map((g: any) => (
                <Fragment>
                  <tr class="ind-group">
                    <td colspan="5"><span class="pillar-name"><PillarIcon name={pillarIconName[g.pillar.id]} size={15} />{L(g.pillar.label)}</span></td>
                  </tr>
                  {g.items.map((ind: any) => {
                    const band = senseBand(ind.score);
                    const unit = indUnit(ind.id);
                    const tip = indTooltip(ind.id);
                    return (
                      <tr>
                        <td class="ind-name">
                          {L(ind.label)}
                          {/* UN FAIT CONTEXTUEL DOIT SE VOIR COMME TEL. Sans cette marque, un
                              indicateur informationnel s'affiche au milieu des indicateurs notés,
                              dans son pilier — c'est-à-dire qu'on publierait l'argument d'un
                              porteur de projet à l'endroit exact où le lecteur cherche la note,
                              et qu'on lui donnerait le crédit qu'on vient de lui refuser. */}
                          {indMeta[ind.id]?.informational && (
                            <span class="ind-info-flag">{t.notScoredFlag}</span>
                          )}
                          {tip && (
                            <span class="info" tabindex="0" role="note" aria-label={`${t.explanation}: ${tip}`}>
                              <span class="info-ico" set:html={icon("info", 14)}></span>
                              <span class="info-tip">{tip}</span>
                            </span>
                          )}
                        </td>
                        <td class={ind.status === "missing" ? "ind-missing" : ""}>
                          {ind.proxies
                            ? <ul class="proxy-facts">{proxyFacts(ind.proxies).map((f) => <li>{f}</li>)}</ul>
                            : ind.status === "missing" ? t.notDisclosed
                            /* Une unité n'a de sens qu'accrochée à un nombre : sans cette
                               garde la fiche écrivait « — PUE » et « — gCO2e/kWh », soit une
                               unité pour une valeur qui n'existe pas. */
                            : (() => { const v = indicatorValue(ind);
                                       return v === "—" ? v : `${v}${unit ? " " + unit : ""}`; })()}
                        </td>
                        <td>
                          {band
                            ? <span class={`sense sense-${band.cls}`} title={band.label} role="img" aria-label={band.label}><i style={`width:${Math.round(ind.score)}%`}></i></span>
                            : <span class="sense-na" aria-label={t.notApplicable}>—</span>}
                        </td>
                        <td>
                          <span class={`status-tag status-${ind.status}`}>{t.indStatus[ind.status] ?? ind.status}</span>
                          {t.indStatusHint?.[ind.status] && (
                            <span class="info" tabindex="0" role="note" aria-label={t.indStatusHint[ind.status]}>
                              <span class="info-ico" set:html={icon("info", 12)}></span>
                              <span class="info-tip">{t.indStatusHint[ind.status]}</span>
                            </span>
                          )}
                        </td>
                        <td class="ind-source"><SourceLink source={ind.source} accessedLabel={t.accessed} archivedLabel={t.archived} /></td>
                      </tr>
                    );
                  })}
                </Fragment>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <div class="fiche-cards">
        <div class="fiche-card">
          <h3>{t.opTitle}</h3>
          {op
            ? <p>{op.text}{op.date ? ` (${fmtDate(op.date)})` : ""}</p>
            : <p class="empty">{t.opNone}</p>}
          <p class="fiche-card-note" set:html={t.opNote}></p>
        </div>
        <div class="fiche-card">
          <h3>{t.dataStateTitle}</h3>
          <p>{dataState}</p>
        </div>
      </div>

      {dc.contestation && dc.contestation.length > 0 && (
        <section class="fiche-contestation" aria-labelledby="contestation-title">
          <h2 id="contestation-title">{t.contestationTitle}</h2>
          <p class="contestation-sub">{t.contestationSub}</p>
          <ul class="contestation-list">
            {dc.contestation.map((item: any) => (
              <li>
                <span class="contestation-fact">
                  {item.kind === "press" ? t.press : ""}{L(item.label)}
                  {item.self_reported && <span class="contestation-tag">{t.selfReported}</span>}
                </span>
                <span class="contestation-src"><SourceLink source={item.source} accessedLabel={t.accessed} archivedLabel={t.archived} /></span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="fiche-history" aria-label={t.historyTitle}>
        <h2>{t.historyTitle}</h2>
        <ul>
          {dc.score_history.map((h: any) => (
            <li>
              <time>{h.date}</time>
              <span class="hist-grades">
                <ScoreBadge label={t.histSite} grade={{ grade: h.grades.site }} confidence={h.confidence} confidenceLabel={t.confidence[h.confidence]} renderConfidence={false} renderLabel={false} size="sm" naLabel={t.naLabel} />
                <ScoreBadge label={t.histPp} grade={{ grade: h.grades.project_process }} confidence={h.confidence} confidenceLabel={t.confidence[h.confidence]} renderConfidence={false} renderLabel={false} size="sm" naLabel={t.naLabel} />
              </span>
              <span>{h.rationale ?? h.event}</span>
            </li>
          ))}
        </ul>
      </section>

      {related.length > 0 && (
        <nav class="fiche-related" aria-label={t.related.title}>
          <h2>{t.related.title}</h2>
          {/* La maille se nomme comme elle se nomme DANS CE PAYS — même dérivation que
              l'étiquette de la relation juste en dessous (`regionFR` vs `region`). Deux
              règles séparées pour la même question auraient divergé, et c'est déjà ce qui
              s'est passé : la phrase annonçait « même département » sur une fiche du Texas. */}
          <p class="fiche-related-sub">{t.related.sub.replace(
            "{maille}",
            dc.country === "FR" ? t.related.subMailleFR : t.related.subMaille)}</p>
          <ul>
            {related.map((r: any) => (
              <li>
                <a href={`${ficheBase}/${r.id}/`}>
                  <span class="fr-name">{r.name}</span>
                  <span class="fr-meta">
                    {[r.municipality,
                      r.relation === "nearby"
                        ? (r.km == null ? null : distanceVoisin(r.km))
                        : r.relation === "operator"
                          ? `${t.related.relation.operator} ${r.operator}`
                          : (dc.country === "FR" ? t.related.relation.regionFR : t.related.relation.region),
                    ].filter(Boolean).join(" · ")}
                    {r.grade && /^[A-E]$/.test(r.grade) ? <span class="fr-grade" data-grade={r.grade}>{r.grade}</span> : null}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="fiche-related-all" href={/* i18n:route */ lang === "fr" ? "/fr/classement/" : "/ranking/"}>{t.related.seeAll}</a>
        </nav>
      )}

      <div class="fiche-foot">
        <span>{t.methodology} {methodology.version}{lastScored ? ` · ${t.scoredOn} ${lastScored}` : ""}</span>
        <span>scoremydatacenter.org</span>
      </div>
    </div>
  </article>
</Base>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { whitenBasemap } from "../scripts/basemap";

  // Geographic context: a still mini-map centred on THIS project (coords come from
  // map.geojson, the same artifact the big maps read — the fiche adds no data).
  const mini = document.querySelector<HTMLElement>(".fiche-mini-map");
  if (mini) {
    try {
      const geo = await (await fetch("/data/map.geojson")).json();
      const f = geo.features.find((x: any) => x.properties.id === mini.dataset.dc);
      if (!f) {
        mini.style.display = "none"; // no coordinates published — no empty frame
      } else {
        const [lon, lat] = f.geometry.coordinates;
        // B-1 (avis cabinet 2026-07-27) : attribution ODbL DCWatch locale sur la carte.
        const dcwatchAttr = (mini.dataset.ficheBase || "/fr/dc").startsWith("/fr")
          ? 'Contient des informations de <a href="https://dcwatch.hubblo.org" target="_blank" rel="noopener">DCWatch (Hubblo)</a>, ODbL'
          : 'Contains information from <a href="https://dcwatch.hubblo.org" target="_blank" rel="noopener">DCWatch (Hubblo)</a>, ODbL';
        const map = new maplibregl.Map({
          container: mini.querySelector<HTMLElement>(".mini-map-canvas")!,
          style: "https://tiles.openfreemap.org/styles/positron",
          center: [lon, lat],
          zoom: 8, // regional context — close enough to read the territory, not a rooftop
          cooperativeGestures: true, // pan/zoom without trapping the page scroll
          attributionControl: { compact: true, customAttribution: dcwatchAttr },
        });
        whitenBasemap(map);
        map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
        const chipHtml = (grade: string) => {
          const na = !grade || grade === "insufficient_data";
          return `<span class="gradechip sm ${na ? "grade-na" : `grade-${grade.toLowerCase()}`} map-chip">${na ? "–" : grade}</span>`;
        };
        // Neighbours first (cumulative-effects context is the point of this map):
        // small, dimmed, clickable to their own fiche — the data is already here.
        const ficheBase = (mini.dataset.ficheBase || "/fr/dc");
        for (const n of geo.features) {
          if (n.properties.id === mini.dataset.dc) continue;
          const el = document.createElement("a");
          el.className = "map-marker mini-neighbour";
          el.href = `${ficheBase}/${n.properties.id}/`;
          el.title = n.properties.name;
          el.style.width = el.style.height = "24px";
          el.innerHTML = chipHtml(n.properties.grade_site);
          new maplibregl.Marker({ element: el }).setLngLat(n.geometry.coordinates).addTo(map);
        }
        // The fiche's own project, full size, on top.
        const g = mini.dataset.grade || "insufficient_data";
        const el = document.createElement("div");
        el.className = "map-marker mini-main";
        el.style.width = el.style.height = "40px";
        el.innerHTML = chipHtml(g);
        new maplibregl.Marker({ element: el }).setLngLat([lon, lat]).addTo(map);
        map.once("load", () => map.resize()); // re-measure once layout settles
      }
    } catch {
      mini.style.display = "none";
    }
  }

  // Copy-link and native share.
  document.querySelectorAll(".fiche-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = (btn as HTMLElement).dataset.url!;
      try { await navigator.clipboard.writeText(url); (btn as HTMLElement).setAttribute("aria-label", (btn as HTMLElement).dataset.copied || "OK"); }
      catch { /* clipboard blocked — no-op */ }
    });
  });
  const native = document.querySelector(".fiche-share-native") as HTMLElement | null;
  if (native && "share" in navigator) {
    native.addEventListener("click", () => {
      navigator.share({ title: document.title, text: native.dataset.text, url: native.dataset.url }).catch(() => {});
    });
  }

</script>
