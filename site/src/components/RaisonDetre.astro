---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
//
// "Notre raison d'être" — the mission block that OPENS the Observatory page, before
// "Qui sommes-nous". The WHY (why we exist) precedes the WHO. Copy carries the mission
// WITHOUT any label — we are data-for-the-common-good in substance, never in slogan
// (Franck 2026-07-31). "raison d'être" is kept in both languages (a lexicalised English
// loanword — elegant, not franglais).
//
// Two columns: the text, and a satellite view of a real hyperscaler data center that
// reads like a bunker/fortress — illustrating "un camp a tous les chiffres" — undercut
// by the caption "les data centers ne sont pas des forteresses opaques" (the image LOOKS
// like an opaque fortress; we are the reason it no longer is). Satellite crop carries its
// own baked credit cartouche (pipeline A-28).
interface Props { lang: "fr" | "en"; }
const { lang } = Astro.props;

// A big, dark, monolithic hyperscaler block from above (Amazon DUB-2, IE) — the most
// fortress-like of the corpus. Illustration only; not a grade shown here.
const SAT = "https://media.scoremydatacenter.org/sat/ie-amazon-dub-2-clondalkin-247df009.webp";

const T = {
  fr: {
    eyebrow: "NOTRE RAISON D'ÊTRE",
    heading: "Une donnée qui reste opaque. Un camp a tous les chiffres. Pas l'autre.",
    p1: "Les data centers se multiplient ; ce qu'ils consomment, le sol, l'eau, le territoire où ils se posent, reste dispersé et illisible. Nous rassemblons cette donnée, la passons à une grille unique, et la rendons <b>publique, gratuite et vérifiable</b>.",
    p2: "Puis nous la mettons <b>des deux côtés de la table</b> : une note d'acceptabilité claire, sourcée, dans la langue de qui décide localement. Indépendants et gratuits — parce qu'une donnée qui n'atteint pas ceux qu'elle concerne ne sert à rien.",
    caption: "Les data centers ne sont pas des forteresses opaques.",
    alt: "Vue satellite d'un grand data center, vu du ciel",
  },
  en: {
    eyebrow: "OUR RAISON D'ÊTRE",
    heading: "Data that stays opaque. One side has every figure — the other, none.",
    p1: "Data centers are multiplying; what they consume — the soil, the water, the territory they land on — stays scattered and unreadable. We gather that data, run it through a single lens, and make it <b>public, free and verifiable</b>.",
    p2: "Then we set it on <b>both sides of the table</b>: a clear, sourced acceptability grade, in the language of whoever decides locally. Independent and free — because data that never reaches the people it concerns is worth nothing.",
    caption: "Data centers are not opaque fortresses.",
    alt: "Satellite view of a large data center, seen from above",
  },
} as const;
const t = T[lang];
---

<section class="section rd-etre-section" aria-labelledby="raison-title">
  <div class="section-inner rd-etre-grid">
    <div class="rd-etre-text">
      <p class="hero-eyebrow" id="raison-title">{t.eyebrow}</p>
      <h1 class="rd-etre-h">{t.heading}</h1>
      <p class="rd-etre-p" set:html={t.p1}></p>
      <p class="rd-etre-p" set:html={t.p2}></p>
    </div>
    <figure class="rd-etre-fig">
      <img src={SAT} alt={t.alt} width="640" height="800" loading="lazy" decoding="async" />
      <figcaption class="rd-etre-cap">{t.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .rd-etre-section { padding-block: clamp(2.4rem, 6vw, 4.5rem) clamp(1rem, 2.5vw, 1.75rem); }
  .rd-etre-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  @media (max-width: 820px) { .rd-etre-grid { grid-template-columns: 1fr; } }

  .rd-etre-text { max-width: 56ch; }
  .rd-etre-h {
    font-size: clamp(1.65rem, 3.6vw, 2.65rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0.15em 0 0.7em;
    text-wrap: balance;
    color: var(--ink);
  }
  .rd-etre-p { font-size: clamp(1rem, 1.35vw, 1.15rem); line-height: 1.6; color: var(--ink-soft); margin: 0 0 1rem; }
  .rd-etre-p:last-child { margin-bottom: 0; }
  .rd-etre-p b { color: var(--ink); font-weight: 700; }

  /* the fortress */
  .rd-etre-fig {
    position: relative; margin: 0;
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 24px 56px -28px rgba(14, 22, 38, 0.65);
    background: #16233a;
  }
  .rd-etre-fig img {
    display: block; width: 100%; height: 100%;
    aspect-ratio: 4 / 5; object-fit: cover;
    filter: saturate(0.9) contrast(1.03);
  }
  @media (max-width: 820px) { .rd-etre-fig img { aspect-ratio: 16 / 10; } }
  .rd-etre-cap {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 2.2rem 1.15rem 0.95rem;
    font-size: clamp(0.95rem, 1.5vw, 1.12rem);
    font-weight: 700; line-height: 1.3; color: #fff;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
    background: linear-gradient(to top, rgba(8, 14, 24, 0.86) 0%, rgba(8, 14, 24, 0.5) 45%, rgba(8, 14, 24, 0) 100%);
  }
</style>
