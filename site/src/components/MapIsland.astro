---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// The living map — fed by map.geojson (engine artifact). Markers are grade
// chips; every popup shows both grades WITH the confidence level (the
// ScoreBadge invariant holds in client-rendered HTML too).
interface Props {
  variant: "hero" | "full";
  labels: {
    site: string;
    operator: string;
    confidence: Record<string, string>;
    insufficient: string;
    fixture: string;
    openMap?: string;
    // i18n (§13): link bases + strings the client script renders. FR defaults
    // apply when absent so existing callers keep working.
    ficheBase?: string;   // "/fr/dc" | "/dc"
    mapPath?: string;     // "/fr/carte" | "/map"
    viewFiche?: string;
    reserved?: string;
    legendGraded?: string;
    legendDonut?: string;
    legendWatch?: string;
    watch?: { badge: string; note: string; source: string; press: string; selfReported: string; aria: string; title: string; status: Record<string, string> };
  };
}
import { EUROPE_ISO } from "../config/stats";
const { variant, labels } = Astro.props;
---

<div class={`map-island map-${variant}`} data-variant={variant} data-labels={JSON.stringify(labels)} data-europe={JSON.stringify(EUROPE_ISO)}>
  <div class="map-canvas"></div>
  {variant === "hero" && labels.openMap && (
    <a class="button button-primary map-open-link" href={labels.mapPath ?? "/fr/carte"}>{labels.openMap}</a>
  )}
  {variant === "full" && (
    <div class="map-legend" aria-hidden="true">
      <span class="map-legend-grades">
        {["a", "b", "c", "d", "e"].map((g) => <i class={`legend-dot legend-${g}`}>{g.toUpperCase()}</i>)}
        {labels.legendGraded ?? "notes du site"}
      </span>
      <span><svg class="legend-donut-ico" width="17" height="17" viewBox="0 0 17 17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="var(--grade-c)" stroke-width="3.4"></circle><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="var(--grade-a)" stroke-width="3.4" stroke-dasharray="9 26" transform="rotate(-90 8.5 8.5)"></circle><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="var(--grade-e)" stroke-width="3.4" stroke-dasharray="6 29" stroke-dashoffset="-9" transform="rotate(-90 8.5 8.5)"></circle></svg>{labels.legendDonut ?? "anneau = composition des notes · centre = nombre de sites"}</span>
      <span><i class="legend-dot legend-dot-mw"></i>{labels.legendPower ?? "taille = puissance (MW) · petit point = non communiquée"}</span>
      <span class="legend-line-announced"><span class="map-legend-watch">🗣️</span>{labels.legendWatch ?? "En veille — suivi, pas encore noté"}</span>
      <span><span class="legend-emoji">✋🏼</span>{labels.legendWatchOpp ?? "Opposition citoyenne locale"}</span>
      <span><span class="legend-emoji">⏸️</span>{labels.legendWatchMor ?? "Moratoire (acte officiel 🏛️)"}</span>
    </div>
  )}
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { whitenBasemap } from "../scripts/basemap";
  // Même réponse que la fiche à « l'opérateur est-il identifié ? ». L'infobulle testait
  // `p.operator ?` tout court — vrai pour « unknown » (167 sites) et pour « opérateur non
  // identifié » (162), qui s'affichaient donc comme des noms d'exploitant sur la carte.
  import { operateurIdentifie } from "../config/operator";

  const STYLE_URL = "https://tiles.openfreemap.org/styles/positron";

  function chip(grade: string, extra = ""): string {
    const na = grade === "insufficient_data";
    // « en_attente » est une ÉNUMÉRATION INTERNE : sans ce cas, l'infobulle affichait le mot
    // `en_attente` en clair, dans une classe CSS qui n'existe pas (donc sans couleur).
    const pending = grade === "en_attente";
    const cls = na ? "grade-na" : pending ? "grade-enveille" : `grade-${grade.toLowerCase()}`;
    return `<span class="gradechip sm ${cls} ${extra}">${na ? "–" : pending ? "…" : grade}</span>`;
  }

  // Client-side mirror of the SourceLink component (A-20): live link + archived snapshot.
  function srcLink(s: any): string {
    if (!s?.url) return "—";
    const live = `<a href="${s.url}" target="_blank" rel="noopener">${s.title}${s.accessed ? ` — consulté le ${s.accessed}` : ""}</a>`;
    const archived = s.archived_url ? ` · <a href="${s.archived_url}" target="_blank" rel="noopener" class="src-archived">archivé</a>` : "";
    return live + archived;
  }

  document.querySelectorAll<HTMLElement>(".map-island").forEach(async (root) => {
    const labels = JSON.parse(root.dataset.labels || "{}");
    const isFull = root.dataset.variant === "full";
    const canvas = root.querySelector<HTMLElement>(".map-canvas");
    if (!canvas) return;

    const geo = await (await fetch("/data/map.geojson")).json();

    // B-1 (avis cabinet 2026-07-27) : attribution ODbL LOCALE là où de la donnée
    // DCWatch s'affiche — « contient des informations de » (jamais « basé sur »).
    const dcwatchAttr = (labels.ficheBase ?? labels.mapPath ?? "/fr").startsWith("/fr")
      ? 'Contient des informations de <a href="https://dcwatch.hubblo.org" target="_blank" rel="noopener">DCWatch (Hubblo)</a>, ODbL'
      : 'Contains information from <a href="https://dcwatch.hubblo.org" target="_blank" rel="noopener">DCWatch (Hubblo)</a>, ODbL';
    const map = new maplibregl.Map({
      container: canvas,
      style: STYLE_URL,
      center: [2.4, 46.8],
      zoom: isFull ? 5.3 : 4.7,
      attributionControl: { compact: true, customAttribution: dcwatchAttr },
      scrollZoom: isFull,
      cooperativeGestures: isFull,
    });
    whitenBasemap(map);
    (root as any).__map = map; // test handle — verification scripts drive the view through it
    if (isFull) map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");

    // Deep-link from the ranking: /fr/carte?dc=<id> flies to that project and opens its popup.
    const focusId = new URLSearchParams(location.search).get("dc");
    const markerById: Record<string, { marker: any; center: [number, number] }> = {};

    // ── « MONTRE-MOI CHEZ MOI » : /fr/carte?lieu=<lat>,<lon>&nom=<commune> ────────────────
    // Les liens existants répondent « montre-moi CE data center » ; celui-ci répond
    // « montre-moi CHEZ MOI, et ce qu'il y a autour ». C'est la suite de la recherche par
    // commune : le lecteur vient d'apprendre qu'un site est à 5,5 km, et sa question
    // suivante est physique — de quel côté ? Cinq kilomètres au nord d'une ville et cinq
    // kilomètres sous le vent ne sont pas la même nouvelle.
    const paramLieu = new URLSearchParams(location.search).get("lieu");
    const lieuDemande = (() => {
      if (!paramLieu) return null;
      const [la, lo] = paramLieu.split(",").map(Number);
      // Une coordonnée hors domaine n'est pas un plantage, c'est une URL bricolée : on
      // l'ignore et la carte s'ouvre normalement.
      if (!Number.isFinite(la) || !Number.isFinite(lo)) return null;
      if (Math.abs(la) > 90 || Math.abs(lo) > 180) return null;
      return { lat: la, lon: lo };
    })();
    const nomLieu = new URLSearchParams(location.search).get("nom") || "";

    // Popup carries ONLY the free floor (name, operator, place, status, site LETTER).
    // The depth lives on the fiche (free HTML) + the API (paid). Shared by the hero DOM
    // markers AND the full map's clustered dot clicks (2026-07-30), so both read identically.
    const sitePopupHtml = (p: any): string => {
      const fixtureTag = p.id.startsWith("zz-") ? `<span class="fixture-tag">${labels.fixture}</span>` : "";
      const place = [p.municipality, p.country].filter(Boolean).join(" · ");
      return `
        <div class="map-popup">
          <strong>${p.name}</strong>
          ${operateurIdentifie(p.operator) ? `<span class="map-popup-sub">${p.operator}</span>` : ""}
          ${place ? `<span class="map-popup-sub">${place}</span>` : ""}
          <div class="map-popup-grades">
            ${p.band_central
              // Projet en plage : l'infobulle dit la MÊME chose que la fiche, lettres en
              // couleur — « probable D · plage B–E ». Afficher d'abord la puce neutre de
              // `grade_site` puis le probable juste en dessous disait deux fois la même
              // chose, dont une fois sans information.
              ? `<span>${labels.site} ${labels.probable ?? "probable"} ${chip(p.band_central)}${
                  p.band && p.band !== p.band_central
                    ? ` · ${labels.range ?? "plage"} ${p.band.split("–").map((g: string) => chip(g)).join("–")}`
                    : ""}</span>`
              : `<span>${labels.site} ${chip(p.grade_site)}${p.reserved_site ? `<span class="map-popup-reserved">${labels.reserved}</span>` : ""}</span>`}
          </div>
          ${fixtureTag}
          <a class="map-popup-link" href="${labels.ficheBase ?? "/fr/dc"}/${p.id}/">${labels.viewFiche || "Voir la fiche →"}</a>
        </div>`;
    };

    // Assigned by the full-map cluster setup; lets the watch kind-filter hide the graded
    // corpus (dots + donuts) even though there are no per-site DOM markers to toggle.
    let toggleClusteredSites: (visible: boolean) => void = () => {};

    // Hero intro (brief 2026-07-12): motion is the data — the pins ARE the published
    // grades, they just drop in once. Browser-only; the artifacts never change.
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const animateIntro = !isFull && !reducedMotion;
    const DROP_WINDOW_MS = 2200; // whole cascade fits in ~2.2s whatever the pin count

    const introDots: HTMLElement[] = [];
    // CADRAGE : « Europe » est une APPARTENANCE, pas « ce qu'il se trouve qu'on sert ».
    // Le plan par défaut se calait sur tous les points servis : une seule fiche américaine
    // l'aurait étiré jusqu'au Kansas et aurait ouvert la carte européenne sur l'Atlantique.
    // La liste vient du moteur (data/scopes.json → stats.json) ; elle était recopiée ici.
    // Liste vide (fichier absent) → on retombe sur tous les points plutôt que sur rien.
    const EUROPE_ISO = new Set<string>(JSON.parse(root.dataset.europe || "[]"));
    const inEurope = (cc: string) => EUROPE_ISO.size === 0 || EUROPE_ISO.has(cc);
    const bounds = new maplibregl.LngLatBounds();      // plan européen = le plan par défaut
    const worldBounds = new maplibregl.LngLatBounds(); // plan « 🌍 Monde » = tout, sans exception
    geo.features.forEach((feature: any, idx: number) => {
      const p = feature.properties;
      const [lon, lat] = feature.geometry.coordinates;
      worldBounds.extend([lon, lat]);
      if (inEurope(p.country)) bounds.extend([lon, lat]);

      // Full map: the graded corpus rides a CLUSTERED source (distribution donuts),
      // built after this loop. 1 405 DOM markers would both melt the map AND carpet
      // dense regions (Paris/Benelux) into unreadable blobs — the whole reason for the
      // donut. The hero keeps its DOM pins (the drop cascade IS its identity).
      if (isFull) return;

      const el = document.createElement("div");
      el.className = "map-marker";
      // Marker size follows a COARSE tier (0 unknown · 1 small · 2 med · 3 large),
      // computed server-side from √MW — the map keeps its power-scaled dots
      // (Franck 2026-07-13) without the geojson ever carrying the sellable MW
      // figure (anti-pillage 2026-07-22). Dot colour = the public site letter.
      const tier = typeof p.size_tier === "number" ? p.size_tier : 0;
      const size = [10, 15, 22, 32][tier] ?? 10;
      el.style.width = el.style.height = `${size}px`;
      // La pastille d'un projet en plage reste NEUTRE : une fenêtre ne tient pas dans un point
      // de six pixels, et y peindre le probable seul republierait le point sans son
      // incertitude. L'infobulle, elle, a la place de dire « probable E · E–C ».
      // « Pas de lettre » a deux valeurs servies : insufficient_data (jamais assez de
      // données) et en_attente (note retenue — veille, ou bande plus large que le
      // plancher). Les deux se peignent en neutre. Sans ce second cas la classe
      // `dot-en_attente` n'existe pas en CSS et la pastille sort sans couleur.
      const na = p.grade_site === "insufficient_data" || p.grade_site === "en_attente";
      const dot = document.createElement("span");
      dot.className = `map-dot ${na ? "dot-na" : `dot-${p.grade_site.toLowerCase()}`}${tier === 0 ? " mw-unknown" : ""}`;
      dot.title = `${p.name}${operateurIdentifie(p.operator) ? ` — ${p.operator}` : ""}`;
      el.appendChild(dot);
      if (animateIntro) {
        // Armed but hidden until the section scrolls into view (see below).
        dot.classList.add("pin-armed");
        dot.style.setProperty("--pin-delay", `${Math.round((idx / geo.features.length) * DROP_WINDOW_MS)}ms`);
        introDots.push(dot);
      }

      const popupHtml = sitePopupHtml(p);

      const marker = new maplibregl.Marker({ element: el })
        .setLngLat([lon, lat])
        .setPopup(new maplibregl.Popup({ offset: 18, closeButton: false, maxWidth: "320px" }).setHTML(popupHtml))
        .addTo(map);
      markerById[p.id] = { marker, center: [lon, lat] };
    });

    // Play the cascade WHEN THE SECTION SCROLLS INTO VIEW, not on load (Franck
    // 2026-07-21): since the satellite wall moved to position 2, "Explorer les
    // scores" now sits well below the fold — a load-time animation fired unseen.
    // Pins stay armed (hidden) until the map enters the viewport, then drop +
    // one light sweep. Fires once; degrades to immediate play without IO.
    if (animateIntro) {
      const playIntro = () => {
        for (const dot of introDots) { dot.classList.remove("pin-armed"); dot.classList.add("chip-drop"); }
        const scan = document.createElement("div");
        scan.className = "map-scan";
        scan.setAttribute("aria-hidden", "true");
        scan.style.setProperty("--scan-delay", `${DROP_WINDOW_MS + 500}ms`);
        scan.addEventListener("animationend", () => scan.remove());
        canvas.appendChild(scan);
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) { io.disconnect(); playIntro(); }
        }, { threshold: 0.3 });
        io.observe(root);
      } else {
        playIntro();
      }
    }

    if (focusId && markerById[focusId]) {
      // Hero path: DOM marker exists — fly + open its own popup.
      const { marker, center } = markerById[focusId];
      map.flyTo({ center, zoom: 9, duration: 800 });
      marker.togglePopup();
    } else if (geo.features.length > 1 && !(isFull && focusId) && !lieuDemande) {
      // Frame the corpus — except on the full map WITH a deep-link, where the cluster
      // setup below flies to the target site (avoids a fit→fly double-move flash).
      // 🔴 LE PLAN D'OUVERTURE DIT CE QU'EST LE CORPUS. Il s'ouvrait sur l'Europe, et c'était
      // juste tant que le corpus était européen. Depuis la vague américaine, les États-Unis
      // sont le PREMIER pays servi (633 fiches, devant la France et ses 408) : ouvrir sur
      // l'Europe demandait au lecteur de deviner qu'un tiers du corpus existe hors du cadre.
      // Un cadrage n'est pas un réglage esthétique, c'est une affirmation sur le périmètre.
      // Le héros garde son plan européen : il montre une poignée d'épingles qui tombent, pas
      // le corpus — à l'échelle du monde elles seraient six points perdus.
      map.fitBounds(isFull ? worldBounds : bounds,
                    { padding: isFull ? 60 : 90, maxZoom: isFull ? 6 : 7, duration: 0 });
    }

    // ── Full map: distribution-donut clustering for the graded corpus (2026-07-30) ──
    // Franck's call after the mockup: legibility in dense regions WITHOUT ever averaging
    // grades. A cluster shows the REAL A→E composition as a ring + the site count at its
    // centre; click to expand; past clusterMaxZoom the individual saturated dots return
    // (the vert/rouge punch comes back at street scale). Never a single averaged colour.
    if (isFull) {
      // "X" = SANS LETTRE PUBLIÉE (gris) — compté honnêtement pour qu'un anneau ne cache
      // jamais un site non noté. Deux valeurs servies entrent ici : insufficient_data (on
      // n'en sait pas assez) et en_attente (note RETENUE — veille, ou bande plus large que
      // le plancher). Oublier la seconde laissait les arcs sommer à MOINS que le nombre au
      // centre : l'anneau disait 1 555 et n'en peignait que 1 537.
      const RING = ["A", "B", "C", "D", "E", "X"] as const;
      const GC: Record<string, string> = {
        A: "#0b7a4b", B: "#6fa032", C: "#dfa918", D: "#cf6a1c", E: "#bf3b21", X: "#8fa0b3",
      };
      const isNA = (g: string) => g === "insufficient_data" || g === "en_attente";
      const donutMarkers: Record<number, any> = {};
      let donutOn: Record<number, any> = {};
      let sitesHidden = false;

      const clusterCounts = Object.fromEntries(
        RING.map((g) => [g, ["+", ["case",
          g === "X"
            ? ["any", ["==", ["get", "grade_site"], "insufficient_data"], ["==", ["get", "grade_site"], "en_attente"]]
            : ["==", ["get", "grade_site"], g], 1, 0]]]),
      );

      const mountSites = () => {
        map.addSource("sites", {
          type: "geojson", data: geo,
          cluster: true, clusterRadius: 46, clusterMaxZoom: 11,
          clusterProperties: clusterCounts,
        });
        // Individual (unclustered) sites: colour = the public site letter, radius = the
        // coarse power tier (keeps "taille = puissance" once you zoom past the clusters).
        map.addLayer({
          id: "site-dot", type: "circle", source: "sites",
          filter: ["!", ["has", "point_count"]],
          paint: {
            // Un projet en PLAGE porte la couleur de sa note PROBABLE, mais en ANNEAU CREUX :
            // la couleur dit la note, la forme dit le statut. Le laisser gris laissait la carte
            // muette là où la fiche affiche « probable D » — deux surfaces, deux récits, la
            // famille de bug qu'on vient de réparer. Le peindre en disque plein aurait dit
            // l'inverse : une note définitive qu'on n'a pas.
            "circle-color": ["case",
              ["has", "band_central"], "#ffffff",
              ["match", ["get", "grade_site"],
                "A", GC.A, "B", GC.B, "C", GC.C, "D", GC.D, "E", GC.E, GC.X]],
            "circle-radius": ["interpolate", ["linear"], ["zoom"],
              5, ["match", ["get", "size_tier"], 3, 5.5, 2, 4.5, 1, 3.6, 3],
              11, ["match", ["get", "size_tier"], 3, 12, 2, 9, 1, 6.5, 5]],
            "circle-stroke-width": ["case", ["has", "band_central"], 2.6, 1.4],
            "circle-stroke-color": ["case",
              ["has", "band_central"], ["match", ["get", "band_central"],
                "A", GC.A, "B", GC.B, "C", GC.C, "D", GC.D, "E", GC.E, GC.X],
              "#ffffff"],
            "circle-opacity": 0.96,
          },
        });
      };

      // One HTML donut marker per on-screen cluster (the classic maplibre recipe): a ring
      // whose arcs are the REAL A→E share, the total at centre. Click → expand.
      const donutEl = (props: any): HTMLElement => {
        const counts = RING.map((g) => props[g] || 0);
        const total = props.point_count as number;
        const r = total >= 60 ? 25 : total >= 15 ? 20 : 16;
        const w = r < 18 ? 5 : 6;
        const cx = r + w, size = (r + w) * 2, C = 2 * Math.PI * r;
        let offset = 0, rings = "";
        RING.forEach((g, i) => {
          const frac = counts[i] / total;
          if (frac <= 0) return;
          const len = frac * C;
          rings += `<circle cx="${cx}" cy="${cx}" r="${r}" fill="none" stroke="${GC[g]}" stroke-width="${w}" stroke-dasharray="${len} ${C - len}" stroke-dashoffset="${-offset}" transform="rotate(-90 ${cx} ${cx})"></circle>`;
          offset += len;
        });
        const fs = total >= 60 ? 15 : total >= 15 ? 13 : 11.5;
        const wrap = document.createElement("div");
        wrap.innerHTML =
          `<svg class="map-donut" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">` +
          `<circle cx="${cx}" cy="${cx}" r="${r}" fill="#ffffff" opacity="0.95"></circle>${rings}` +
          `<text x="${cx}" y="${cx}" text-anchor="middle" dominant-baseline="central" font-size="${fs}">${total}</text></svg>`;
        const node = wrap.firstElementChild as HTMLElement;
        // Native tooltip = the honest breakdown, zero popup churn.
        node.title = RING.filter((_, i) => counts[i] > 0)
          .map((g) => `${g === "X" ? "n/d" : g} : ${counts[RING.indexOf(g)]}`).join("   ");
        node.addEventListener("click", () => {
          (map.getSource("sites") as any).getClusterExpansionZoom(props.cluster_id).then((z: number) => {
            map.easeTo({ center: props._lngLat, zoom: Math.min(z + 0.4, 15), duration: 600 });
          });
        });
        return node;
      };

      const updateDonuts = () => {
        if (sitesHidden || !map.getSource("sites")) return;
        const newOn: Record<number, any> = {};
        for (const f of map.querySourceFeatures("sites") as any[]) {
          if (!f.properties.cluster) continue;
          const id = f.properties.cluster_id;
          let m = donutMarkers[id];
          if (!m) {
            const props = { ...f.properties, _lngLat: f.geometry.coordinates };
            m = donutMarkers[id] = new maplibregl.Marker({ element: donutEl(props) }).setLngLat(f.geometry.coordinates);
          }
          newOn[id] = m;
          if (!donutOn[id]) m.addTo(map);
        }
        for (const id in donutOn) if (!newOn[id]) donutOn[id].remove();
        donutOn = newOn;
      };

      // Watch kind-filter hides the graded corpus: dots (layer) + donuts (markers).
      toggleClusteredSites = (visible: boolean) => {
        sitesHidden = !visible;
        if (map.getLayer("site-dot")) map.setLayoutProperty("site-dot", "visibility", visible ? "visible" : "none");
        if (visible) updateDonuts();
        else { for (const id in donutOn) donutOn[id].remove(); donutOn = {}; }
      };

      const startClusters = () => {
        mountSites();
        map.on("click", "site-dot", (e: any) => {
          new maplibregl.Popup({ offset: 14, closeButton: false, maxWidth: "320px" })
            .setLngLat(e.features[0].geometry.coordinates).setHTML(sitePopupHtml(e.features[0].properties)).addTo(map);
        });
        map.on("mouseenter", "site-dot", () => { map.getCanvas().style.cursor = "pointer"; });
        map.on("mouseleave", "site-dot", () => { map.getCanvas().style.cursor = ""; });
        map.on("data", (e: any) => { if (e.sourceId === "sites" && (map.getSource("sites") as any)?.loaded()) updateDonuts(); });
        map.on("move", updateDonuts);
        map.on("moveend", updateDonuts);

        // Deep-link (?dc=<id>): fly past the cluster zoom so the target is an individual
        // dot, and open its popup at the coordinates.
        if (focusId) {
          const f = geo.features.find((ft: any) => ft.properties.id === focusId);
          if (f) {
            map.flyTo({ center: f.geometry.coordinates, zoom: 11.5, duration: 800 });
            new maplibregl.Popup({ offset: 14, closeButton: false, maxWidth: "320px" })
              .setLngLat(f.geometry.coordinates).setHTML(sitePopupHtml(f.properties)).addTo(map);
          }
        }
        updateDonuts();
      };
      map.isStyleLoaded() ? startClusters() : map.once("load", startClusters);
    }

    // Watchlist layer (A-19) — world "En veille" projects: sourced facts, NEVER a
    // grade, a score or a confidence. Full map only. 863 entries (US wave 1) ride a
    // clustered geojson SOURCE (DOM markers would melt the map); only the rare
    // announced_project entries keep the DOM 🗣️ marker. Shape carries the kind —
    // round = local opposition, square = moratorium (official act) — same neutral
    // tint; the fine distinction lives in the popup, not in visual noise.
    if (isFull) {
      const W = Object.assign({
        badge: "En veille", note: "Projet suivi ; pas encore noté.",
        source: "Source :", press: "Presse : ", selfReported: "auto-déclaré",
        aria: "Projet suivi — contestation", title: "Projet suivi ; pas encore noté",
        lang: "fr",
        typeOpposition: "Opposition locale", typeMoratorium: "Moratoire",
        filterLabel: "En veille :", filterAll: "Tout", filterOppositions: "Oppositions",
        filterMoratoria: "Moratoires", filterAria: "Filtrer la couche en veille",
        viewWorld: "🌍 Monde", viewEurope: "🇪🇺 Europe",
        // Discipline juridique watchlist (avis cabinet Batch D, 2026-07-27) :
        // Mod 1 (phrase permanente en tête) + Mod 2 (note « source documentaire »).
        watchlistNote: "Les projets « En veille » ne sont pas notés. Cette rubrique décrit uniquement des faits publics issus de sources identifiées.",
        extSourceNote: "Source externe citée à titre documentaire.",
        status: { announced: "Annoncé", permitting: "En instruction",
                  under_construction: "En construction", operational: "En service" },
      }, labels.watch ?? {});
      const WATCH_STATUS: Record<string, string> = W.status;
      const GREY = "#c3d0dc", STROKE = "#ffffff", INK = "#33475c";
      try {
        const watch = await (await fetch("/data/watchlist.geojson")).json();
        const isClusteredKind = (f: any) => f.properties.kind === "opposition" || f.properties.kind === "moratorium";
        const clusteredAll = { type: "FeatureCollection", features: watch.features.filter(isClusteredKind) };
        const announced = watch.features.filter((f: any) => !isClusteredKind(f));

        // EEA watch entries belong in the DEFAULT Europe frame (Franck 2026-07-22): Iceland
        // (GIGA-42 Bakki) et al. are European — unlike the US/Maghreb wave, which stays one
        // "🌍 Monde" click away. The default frame is built from the graded corpus (§6), which
        // has no Icelandic DC, so Bakki fell ~1° off the NW corner. Extend the bounds with the
        // European watch points and re-fit, so a European "en veille" pin is never off-frame.
        // Les points de veille entrent dans les DEUX plans : l'européen (bouton « Europe »)
        // et le mondial, qui est désormais le plan d'ouverture. Ce re-cadrage existe parce
        // que la veille arrive APRÈS le premier `fitBounds` — sans lui, un point hors du
        // rectangle du corpus noté (Bakki en Islande) s'ouvrait hors champ.
        for (const f of watch.features) {
          worldBounds.extend(f.geometry.coordinates);
          if (inEurope(f.properties.country)) bounds.extend(f.geometry.coordinates);
        }
        if (!focusId && !lieuDemande && geo.features.length > 1) {
          map.fitBounds(worldBounds, { padding: 60, maxZoom: 6, duration: 0 });
        }

        // Shareable filter state, ranking-style URL: /fr/carte?veille=moratoires
        const FILTERS: Record<string, string | null> = { tout: null, oppositions: "opposition", moratoires: "moratorium" };
        let veille = new URLSearchParams(location.search).get("veille") ?? "tout";
        if (!(veille in FILTERS)) veille = "tout";
        const subset = (v: string) => FILTERS[v]
          ? { type: "FeatureCollection", features: clusteredAll.features.filter((f: any) => f.properties.kind === FILTERS[v]) }
          : clusteredAll;

        // « Monde » = tout ce qui est sur la carte, veille comprise ET fiches servies hors
        // d'Europe : sans ces dernières, le seul endroit où elles seraient visibles serait un
        // zoom manuel.
        const watchBounds = new maplibregl.LngLatBounds();
        for (const f of watch.features) watchBounds.extend(f.geometry.coordinates);
        if (!worldBounds.isEmpty()) {
          watchBounds.extend(worldBounds.getSouthWest());
          watchBounds.extend(worldBounds.getNorthEast());
        }
        // View doctrine (COUNTRIES.md §6): the full map keeps the EUROPE frame by
        // default — the graded corpus is the product. Everything else is one explicit
        // click away. The watch layer was US-only ("Monde" then overpromised); it now
        // spans several continents (US + Maghreb…), so the toggle is honestly "🌍 Monde"
        // and frames the whole watched world (an active ?veille= filter still auto-frames
        // the layer it shows).
        const fitWorld = (ms = 600) => map.fitBounds(watchBounds, { padding: 60, maxZoom: 6, duration: ms });
        const fitEurope = (ms = 600) => map.fitBounds(bounds, { padding: 120, maxZoom: 7, duration: ms });

        const watchPopupHtml = (p: any) => {
          const facts = typeof p.facts === "string" ? JSON.parse(p.facts) : (p.facts || []);
          const src = typeof p.source === "string" && p.source.startsWith("{") ? JSON.parse(p.source) : p.source;
          const typeLabel = p.kind === "moratorium" ? W.typeMoratorium : p.kind === "opposition" ? W.typeOpposition : "";
          // Never append the raw ISO country code when the place label is already a
          // DESCRIPTIVE territory (contains an em-dash) — avis cabinet Batch D (2026-07-27,
          // EH vs MA) : le code pays n'est jamais un élément éditorial. « Húsavík · IS »
          // reste ; « Dakhla — Sahara occidental — territoire non autonome (ONU) » n'a
          // pas de « · EH » accolé.
          const loc = p.municipality && p.municipality.includes("—")
            ? p.municipality
            : [p.municipality, p.country].filter(Boolean).join(" · ");
          const sub = [loc, p.project_status ? WATCH_STATUS[p.project_status] : ""].filter(Boolean).join(" · ");
          const factItems = facts.map((f: any) =>
            `<li>${f.kind === "press" ? W.press : ""}${(f.label || {})[W.lang] ?? (f.label || {}).fr ?? ""}` +
            `${f.self_reported ? ` <span class="contestation-tag">${W.selfReported}</span>` : ""} — ${srcLink(f.source)}</li>`
          ).join("");
          return `
            <div class="map-popup watch-popup">
              <span class="watch-badge">${W.badge}</span>
              <strong>${typeLabel ? `${typeLabel} — ` : ""}${p.name}</strong>
              ${sub ? `<span class="map-popup-sub">${sub}</span>` : ""}
              <p class="watch-note">${W.note}</p>
              <p class="watch-src">${W.source} ${srcLink(src)}</p>
              ${factItems ? `<ul class="watch-facts">${factItems}</ul>` : ""}
              <p class="watch-ext">${W.extSourceNote}</p>
            </div>`;
        };

        // announced_project (no hard fact yet): rendered as a NATIVE symbol layer
        // (GPU-locked WITH the tiles). HTML markers "swim" during animated zoom at
        // high latitude — the Húsavík 🗣️ drifted into the ocean at low zoom, converging
        // back only at rest (Franck 2026-07-27). A symbol layer never drifts. Trade-off
        // assumed: no CSS pulse ring. Mounted in onStyleReady below with the other layers.
        if (!announced.length) root.querySelector(".legend-line-announced")?.remove();
        const announcedData = { type: "FeatureCollection", features: announced };

        // Toggling the graded corpus on demand (Franck 2026-07-14): a kind filter
        // (Oppositions / Moratoires) HIDES the DC grade pins so the contestation layer
        // reads clearly; "Tout" brings them back. The DC pins are DOM markers.
        const dcEls = Object.values(markerById).map((m) => m.marker.getElement());
        const setDcVisible = (v: boolean) => {
          for (const el of dcEls) el.style.display = v ? "" : "none";   // hero DOM pins (none on full map)
          toggleClusteredSites(v);                                       // full map: dots layer + donuts
        };

        let applyVeille: (v: string) => void = () => {};
        const onStyleReady = (fn: () => void) => (map.isStyleLoaded() ? fn() : map.once("load", fn));
        onStyleReady(() => {
          // Pictograms carry the kind (Franck 2026-07-14): ✋🏼 = local opposition (the
          // citizens' halt — deliberately NOT 🛑, red would read as a D/E grade),
          // ⏸️ = moratorium (the official pause). Maplibre glyphs have no emoji, so
          // rasterise via canvas (system emoji font) into layer icons.
          const emojiIcon = (name: string, emoji: string) => {
            const px = 48, cv = document.createElement("canvas");
            cv.width = cv.height = px;
            const ctx = cv.getContext("2d")!;
            ctx.font = "38px 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif";
            ctx.textAlign = "center"; ctx.textBaseline = "middle";
            ctx.fillText(emoji, px / 2, px / 2 + 2);
            map.addImage(name, ctx.getImageData(0, 0, px, px), { pixelRatio: 2 });
          };
          emojiIcon("watch-hand", "✋🏼");
          emojiIcon("watch-pause", "⏸️");
          emojiIcon("watch-speak", "🗣️");

          // Announced pins on their OWN non-clustered source + symbol layer (GPU-locked,
          // never re-mounted by the kind filter — only toggled visible/hidden).
          if (announced.length) {
            map.addSource("watch-announced", { type: "geojson", data: announcedData });
            map.addLayer({ id: "watch-announced-pins", type: "symbol", source: "watch-announced", layout: {
              "icon-image": "watch-speak", "icon-size": 0.7, "icon-allow-overlap": true,
            }});
            map.on("click", "watch-announced-pins", (e: any) => {
              new maplibregl.Popup({ offset: 12, closeButton: false, maxWidth: "300px" })
                .setLngLat(e.lngLat).setHTML(watchPopupHtml(e.features[0].properties)).addTo(map);
            });
            map.on("mouseenter", "watch-announced-pins", () => { map.getCanvas().style.cursor = "pointer"; });
            map.on("mouseleave", "watch-announced-pins", () => { map.getCanvas().style.cursor = ""; });
          }

          // (Re)mount the watch source + its layers. Clustering is ON for "Tout" (the US
          // wave is 800+ points and would carpet the map) and OFF while a kind filter is
          // active — the filtered subset is sparse, so every ✋🏼/⏸️ must show individually
          // rather than hide inside a grey cluster at the Europe frame (Franck 2026-07-14).
          const WATCH_LAYERS = ["watch-clusters", "watch-cluster-count", "watch-opposition", "watch-moratorium"];
          const mountWatch = (data: any, clustered: boolean) => {
            for (const id of WATCH_LAYERS) if (map.getLayer(id)) map.removeLayer(id);
            if (map.getSource("watch")) map.removeSource("watch");
            map.addSource("watch", { type: "geojson", data, cluster: clustered, clusterMaxZoom: 10, clusterRadius: 44 });
            map.addLayer({ id: "watch-clusters", type: "circle", source: "watch", filter: ["has", "point_count"], paint: {
              "circle-color": GREY, "circle-opacity": 0.92,
              "circle-stroke-color": STROKE, "circle-stroke-width": 2,
              "circle-radius": ["step", ["get", "point_count"], 11, 10, 15, 50, 20, 200, 26],
            }});
            map.addLayer({ id: "watch-cluster-count", type: "symbol", source: "watch", filter: ["has", "point_count"], layout: {
              "text-field": ["get", "point_count_abbreviated"], "text-font": ["Noto Sans Bold"], "text-size": 11,
            }, paint: { "text-color": INK }});
            map.addLayer({ id: "watch-opposition", type: "symbol", source: "watch",
              filter: ["all", ["!", ["has", "point_count"]], ["==", ["get", "kind"], "opposition"]], layout: {
                "icon-image": "watch-hand", "icon-size": 0.8, "icon-allow-overlap": true,
              }});
            map.addLayer({ id: "watch-moratorium", type: "symbol", source: "watch",
              filter: ["all", ["!", ["has", "point_count"]], ["==", ["get", "kind"], "moratorium"]], layout: {
                "icon-image": "watch-pause", "icon-size": 0.8, "icon-allow-overlap": true,
              }});
          };
          mountWatch(subset(veille), veille === "tout");

          // Handlers bind to layer ids and survive a remove/re-add, so bind once.
          for (const layerId of ["watch-opposition", "watch-moratorium"]) {
            map.on("click", layerId, (e: any) => {
              new maplibregl.Popup({ offset: 12, closeButton: false, maxWidth: "300px" })
                .setLngLat(e.lngLat).setHTML(watchPopupHtml(e.features[0].properties)).addTo(map);
            });
            map.on("mouseenter", layerId, () => { map.getCanvas().style.cursor = "pointer"; });
            map.on("mouseleave", layerId, () => { map.getCanvas().style.cursor = ""; });
          }
          map.on("click", "watch-clusters", async (e: any) => {
            const cluster = e.features[0];
            const zoom = await (map.getSource("watch") as any).getClusterExpansionZoom(cluster.properties.cluster_id);
            map.easeTo({ center: cluster.geometry.coordinates, zoom, duration: 500 });
          });
          map.on("mouseenter", "watch-clusters", () => { map.getCanvas().style.cursor = "pointer"; });
          map.on("mouseleave", "watch-clusters", () => { map.getCanvas().style.cursor = ""; });

          // A kind filter hides the graded corpus + the 🗣️ announced pins so the
          // contestation reads clean — never re-frames the map (it stays where you are).
          applyVeille = (v: string) => {
            veille = v;
            const filtered = v !== "tout";
            setDcVisible(!filtered);
            if (map.getLayer("watch-announced-pins")) map.setLayoutProperty("watch-announced-pins", "visibility", filtered ? "none" : "visible");
            mountWatch(subset(v), !filtered);
          };
          if (veille !== "tout") applyVeille(veille);
        });

        // Filter control (shareable) + view toggle — mirrors the ranking's tweetable URLs.
        const ctl = document.createElement("div");
        ctl.className = "map-veille-ctl";
        ctl.setAttribute("role", "group");
        ctl.setAttribute("aria-label", W.filterAria);
        ctl.innerHTML =
          `<span class="veille-ctl-label">${W.filterLabel}</span>` +
          [["tout", W.filterAll], ["oppositions", W.filterOppositions], ["moratoires", W.filterMoratoria]]
            .map(([v, label]) => `<button type="button" data-veille="${v}"${v === veille ? ' class="active"' : ""}>${label}</button>`).join("") +
          `<span class="veille-ctl-sep"></span>` +
          `<button type="button" data-view="world">${W.viewWorld}</button>` +
          `<button type="button" data-view="europe">${W.viewEurope}</button>` +
          `<p class="veille-ctl-note">${W.watchlistNote}</p>`;
        canvas.appendChild(ctl);
        ctl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest("button");
          if (!btn) return;
          // Geographic view toggles: US and Europe re-frame the map (that IS their job).
          if (btn.dataset.view === "world") return fitWorld();
          if (btn.dataset.view === "europe") return fitEurope();
          // Kind filters: toggle layers in place, never jump the map.
          veille = btn.dataset.veille!;
          applyVeille(veille);
          ctl.querySelectorAll("[data-veille]").forEach((b) => b.classList.toggle("active", (b as HTMLElement).dataset.veille === veille));
          const url = new URL(location.href);
          if (veille === "tout") url.searchParams.delete("veille"); else url.searchParams.set("veille", veille);
          history.replaceState(null, "", url);
        });
      } catch {
        /* no watchlist artifact yet — the layer is optional */
      }
    }

    // ── Cadrer sur une commune ───────────────────────────────────────────────────────────
    // Le cadrage se CALCULE ici plutôt que d'être passé dans l'URL : la carte connaît les
    // points, elle sait donc jusqu'où ouvrir pour que les voisins tiennent dans l'image. Une
    // URL qui porterait un niveau de zoom mentirait dès qu'un site apparaît ou disparaît du
    // corpus, et deux pages se contrediraient sur « les plus proches ».
    //
    // Une seule fonction pour les DEUX entrées — le lien venu du classement (?lieu=…) et la
    // recherche posée sur la carte. Deux implémentations finiraient par cadrer différemment
    // la même commune, et le lecteur ne saurait pas laquelle croire.
    const km = (aLon: number, aLat: number, bLon: number, bLat: number) => {
      const r = Math.PI / 180;
      const dLat = (bLat - aLat) * r, dLon = (bLon - aLon) * r;
      const h = Math.sin(dLat / 2) ** 2
        + Math.cos(aLat * r) * Math.cos(bLat * r) * Math.sin(dLon / 2) ** 2;
      return 2 * 6371 * Math.asin(Math.sqrt(h));
    };
    let repereCourant: any = null;

    const cadrerSurLieu = (lat: number, lon: number, nom: string, anime = false) => {
      const proches = geo.features
        .map((f: any) => ({ c: f.geometry.coordinates as [number, number],
                            d: km(lon, lat, f.geometry.coordinates[0], f.geometry.coordinates[1]) }))
        .sort((a: any, b: any) => a.d - b.d)
        .slice(0, 5);

      // Le repère de la commune n'est PAS une épingle de projet : c'est le point de vue du
      // lecteur. Il doit se distinguer au premier regard des sites notés, sinon on lui fait
      // croire qu'un data center est posé sur sa mairie.
      // Un seul repère à la fois : deux recherches successives laisseraient deux « vous êtes
      // ici » sur la carte, ce qui n'a aucun sens.
      repereCourant?.remove();
      const repere = document.createElement("div");
      repere.className = "map-lieu-repere";
      if (nom) {
        const etiquette = document.createElement("span");
        // textContent, jamais innerHTML : ce nom vient de l'URL ou d'un dictionnaire
        // externe, donc potentiellement de n'importe qui ayant envoyé un lien au lecteur.
        etiquette.textContent = nom;
        repere.appendChild(etiquette);
      }
      repereCourant = new maplibregl.Marker({ element: repere, anchor: "center" })
        .setLngLat([lon, lat])
        .addTo(map);

      const cadre = new maplibregl.LngLatBounds();
      cadre.extend([lon, lat]);
      for (const p of proches) cadre.extend(p.c);

      // La légende et la barre de filtres sont POSÉES SUR la carte : un cadrage à marge
      // uniforme place les voisins pile dessous. Vu depuis Ferney-Voltaire, les cinq sites
      // genevois disparaissaient derrière la légende — soit exactement ce que le lien
      // promettait de montrer. On mesure donc les panneaux au lieu de deviner, et on retombe
      // sur une marge simple quand ils sont absents (le héros n'en a pas) ou quand l'écran
      // est trop étroit pour qu'une réserve ait un sens.
      const hauteur = (sel: string) =>
        Math.ceil((root.querySelector(sel) as HTMLElement)?.getBoundingClientRect().height ?? 0);
      const largeur = (sel: string) =>
        Math.ceil((root.querySelector(sel) as HTMLElement)?.getBoundingClientRect().width ?? 0);
      const boite = map.getContainer();
      const etroit = boite.clientWidth < 720;
      const marges = {
        top: Math.max(70, hauteur(".map-veille-ctl") + 30),
        right: 70,
        bottom: Math.max(60, hauteur(".map-legend") + 24),
        // Sur un écran étroit la légende occupe toute la largeur : lui réserver une colonne
        // à gauche ne protège rien et pousse le repère hors cadre. Elle est déjà couverte
        // par la marge basse.
        left: etroit ? 40 : Math.max(60, largeur(".map-legend") + 24),
      };
      // 🔴 DES MARGES PLUS GRANDES QUE LA CARTE NE CADRENT PLUS RIEN. Sur un téléphone, la
      // légende fait la moitié de la hauteur : additionnée à la barre de filtres, la réserve
      // dépassait la zone utile et le repère sortait par le haut. On borne donc chaque axe à
      // 60 % de sa dimension, en gardant la proportion entre les deux côtés — mieux vaut un
      // voisin un peu sous la légende qu'une commune hors de l'écran.
      const borne = (a: number, b: number, total: number): [number, number] => {
        const max = total * 0.6;
        if (a + b <= max || a + b === 0) return [a, b];
        const k = max / (a + b);
        return [Math.floor(a * k), Math.floor(b * k)];
      };
      [marges.top, marges.bottom] = borne(marges.top, marges.bottom, boite.clientHeight);
      [marges.left, marges.right] = borne(marges.left, marges.right, boite.clientWidth);
      // `maxZoom` protège le cas où un data center serait sur la commune même : sans lui, le
      // cadre serait un point et la carte plongerait au niveau de la rue.
      map.fitBounds(cadre, { padding: marges, maxZoom: 11, duration: anime ? 700 : 0 });
    };

    if (lieuDemande) cadrerSurLieu(lieuDemande.lat, lieuDemande.lon, nomLieu);

    // ── RECHERCHE SUR LA CARTE ───────────────────────────────────────────────────────────
    // La carte n'en avait aucune. Le champ de l'en-tête existe bien sur cette page, mais il
    // EMMÈNE le lecteur vers le classement : on pose une question géographique et on se
    // retrouve devant un tableau. Pour « qu'y a-t-il autour de chez moi », c'est à l'envers.
    //
    // Une seule boîte, deux natures de réponse — comme au classement. Les projets d'abord :
    // ils sont le contenu propre de la carte, déjà chargés, et une recherche de carte qui ne
    // saurait pas trouver « Equinix GV2 » paraîtrait cassée. Les communes ensuite, via le
    // même dictionnaire embarqué, chargé par tranche à la frappe — rien ne sort du
    // navigateur.
    if (isFull) {
      const S = labels.search ?? {};
      const normLieu = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "")
        .toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
      const tranches = new Map<string, any[]>();
      // Les fiches portent le CODE de la région (« US.NH ») ; son nom vit dans une table à
      // part, chargée une fois, parce qu'il y a 165 000 lieux pour 290 régions. Elle porte
      // les deux langues : la table de référence de GeoNames est anglicisée, et la page
      // française affichait « Normandy » à côté de notre propre « Normandie ».
      let nomsRegions: Record<string, any> = {};
      fetch("/data/lieux/regions.json")
        .then((r) => (r.ok ? r.json() : {}))
        .then((t) => { nomsRegions = t; })
        .catch(() => { /* sans la table, on affiche le pays seul : dégradé, pas cassé */ });
      // La langue se lit sur la page elle-même : le composant est le même pour /fr/carte et
      // /map, et seul `<html lang>` dit laquelle est servie.
      const langue = document.documentElement.lang === "en" ? "en" : "fr";
      const nomRegion = (code: string) => (code && nomsRegions[code]?.[langue]) || "";
      const chargerTranche = async (prefixe: string): Promise<any[]> => {
        if (tranches.has(prefixe)) return tranches.get(prefixe)!;
        try {
          const r = await fetch(`/data/lieux/${prefixe.replace(/ /g, "_")}.json`);
          const data = r.ok ? await r.json() : [];
          tranches.set(prefixe, data);
          return data;
        } catch {
          tranches.set(prefixe, []);
          return [];
        }
      };

      const ctlRecherche = document.createElement("div");
      ctlRecherche.className = "map-search-ctl";
      ctlRecherche.innerHTML =
        `<label class="ms-field"><span class="sr-only">${S.label ?? "Rechercher"}</span>`
        + `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"`
        + ` stroke-width="2" stroke-linecap="round" aria-hidden="true">`
        + `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`
        + `<input type="search" autocomplete="off" placeholder="${S.placeholder ?? ""}"`
        + ` aria-label="${S.label ?? ""}" /></label>`
        + `<ul class="ms-results" hidden></ul>`;
      canvas.appendChild(ctlRecherche);
      const champ = ctlRecherche.querySelector("input") as HTMLInputElement;
      const liste = ctlRecherche.querySelector(".ms-results") as HTMLElement;

      const fermer = () => { liste.hidden = true; liste.innerHTML = ""; };

      let frappe = 0;
      const proposer = async () => {
        const brut = champ.value.trim();
        const q = normLieu(brut);
        if (q.length < 2) return fermer();
        const jeton = ++frappe;

        // Les projets viennent des points déjà en mémoire : aucune requête, réponse immédiate.
        const projets = geo.features
          .filter((f: any) => normLieu(
            [f.properties.name, f.properties.municipality, f.properties.operator]
              .filter(Boolean).join(" ")).includes(q))
          .slice(0, 4)
          .map((f: any) => ({
            type: "dc" as const,
            id: f.properties.id,
            titre: f.properties.name,
            sous: [f.properties.municipality, f.properties.country].filter(Boolean).join(" · "),
            c: f.geometry.coordinates as [number, number],
          }));

        const candidats = await chargerTranche(q.slice(0, 2));
        if (jeton !== frappe) return;                 // une frappe plus récente a pris la main
        // Mêmes deux règles qu'au classement, pour la même raison : un nom exact bat un
        // préfixe (sinon « Vernon » élit Vernon Hills), et à forme égale le plus peuplé
        // gagne (la tranche arrive déjà triée ainsi).
        const prefixes = candidats.filter((c: any[]) => normLieu(c[0]).startsWith(q));
        const exacts = prefixes.filter((c: any[]) => normLieu(c[0]) === q);
        const communes = (exacts.length
          ? exacts.concat(prefixes.filter((c) => !exacts.includes(c)))
          : prefixes)
          .slice(0, 5)
          // « Berlin (US) » ne permet pas de choisir : il y a plusieurs Berlin aux
          // États-Unis. Le pays ne situe rien À L'INTÉRIEUR d'un pays — c'est l'État ou la
          // région qui le fait, et c'est le repère que le lecteur connaît.
          .map((c: any[]) => ({ type: "lieu" as const, titre: c[0],
                                sous: [nomRegion(c[5]), c[1]].filter(Boolean).join(" · "),
                                lat: c[2], lon: c[3] }));

        const resultats = [...projets, ...communes];
        if (!resultats.length) {
          liste.innerHTML = `<li class="ms-vide">${S.none ?? ""}</li>`;
          liste.hidden = false;
          return;
        }
        liste.innerHTML = "";
        resultats.forEach((r, i) => {
          const li = document.createElement("li");
          const b = document.createElement("button");
          b.type = "button";
          b.dataset.i = String(i);
          // textContent : ces libellés viennent du corpus ET d'un dictionnaire externe.
          const t1 = document.createElement("strong");
          t1.textContent = r.titre;
          const t2 = document.createElement("span");
          t2.textContent = r.sous;
          const marque = document.createElement("i");
          marque.className = r.type === "dc" ? "ms-tag-dc" : "ms-tag-lieu";
          marque.textContent = r.type === "dc" ? (S.project ?? "") : (S.town ?? "");
          b.append(marque, t1, t2);
          li.appendChild(b);
          liste.appendChild(li);
        });
        liste.hidden = false;

        liste.onclick = (e) => {
          const b = (e.target as HTMLElement).closest("button");
          if (!b) return;
          const r = resultats[Number(b.dataset.i)];
          const url = new URL(location.href);
          if (r.type === "dc") {
            // Un projet : on vole dessus ET on ouvre sa bulle, exactement comme le lien
            // ?dc= du classement — une seule façon d'atteindre une fiche depuis la carte.
            // Sans la bulle, le lecteur arrive sur une pastille parmi d'autres et doit
            // deviner laquelle il a demandée.
            // Zoom 11,5 : au-delà du seuil de regroupement, sinon la cible reste fondue
            // dans un anneau et la bulle désigne un point qu'on ne voit pas.
            repereCourant?.remove();   // le « vous êtes ici » d'une recherche précédente
            repereCourant = null;
            map.flyTo({ center: r.c, zoom: 11.5, duration: 700 });
            const f = geo.features.find((ft: any) => ft.properties.id === r.id);
            if (f) {
              new maplibregl.Popup({ offset: 14, closeButton: false, maxWidth: "320px" })
                .setLngLat(f.geometry.coordinates)
                .setHTML(sitePopupHtml(f.properties))
                .addTo(map);
            }
            url.searchParams.set("dc", r.id);
            url.searchParams.delete("lieu"); url.searchParams.delete("nom");
          } else {
            cadrerSurLieu(r.lat, r.lon, r.titre, true);
            url.searchParams.set("lieu", `${r.lat},${r.lon}`);
            url.searchParams.set("nom", r.titre);
            url.searchParams.delete("dc");
          }
          // Toute vue a une adresse partageable — c'est la règle du site, et elle vaut
          // autant pour un cadrage de commune que pour un tri de classement.
          history.replaceState(null, "", url);
          champ.value = r.titre;
          fermer();
        };
      };

      champ.addEventListener("input", () => { void proposer(); });
      champ.addEventListener("keydown", (e) => { if (e.key === "Escape") fermer(); });
      // Un clic ailleurs referme : une liste de suggestions qui reste ouverte masque la
      // carte qu'on vient d'ouvrir.
      document.addEventListener("click", (e) => {
        if (!ctlRecherche.contains(e.target as Node)) fermer();
      });
      if (nomLieu) champ.value = nomLieu;
    }
  });
</script>
