---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// THE invariant component (pre-mortem fatal #1): the ONLY place a grade letter
// may be rendered, and a letter is never rendered without its documentation
// coupling. `confidence` is a required prop even for compact chips — compact
// usage is only legal inside a card whose header already displays it
// (renderConfidence=false acknowledges, never removes, the coupling).
interface Grade {
  grade: string; // "A".."E" | "insufficient_data"
  score?: number;
  reserved_from?: string; // A-25: set to "A" when the letter was capped down (proven, never granted)
}
interface Props {
  label: string;
  grade: Grade;
  confidence: "high" | "medium" | "low";
  confidenceLabel: string; // localized "confidence: high" wording
  renderConfidence?: boolean;
  renderLabel?: boolean; // false = label stays for screen readers only (compact chips whose label is drawn by the parent cell)
  showScore?: boolean;
  size?: "md" | "sm" | "lg";
  layout?: "row" | "lead"; // lead = big chip first, label + documentation stacked to its right (fiche badge)
  documentationLabel?: string; // the coupled documentation wording ("documentation moyenne") — replaces the confidence dot line when set
  naLabel?: string; // localized "insufficient data"
  reservedLabel?: string; // A-25: localized "A réservé — se prouve en exploitation", shown when grade.reserved_from is set
  enAttenteLabel?: string; // en-veille: localized "note en attente" (grade withheld pending publication)
  band?: { central: string; adjacent?: string | null; a_reserved?: boolean; wide?: boolean } | null; // loupe: provisional coverage band on a PIPELINE project (central = big letter, adjacent = small). Same invariant: never rendered without its confidence/provisional coupling.
  // `wide` (règle C-bis) : la fenêtre dépasse le plancher irréductible. La loupe s'affiche
  // quand même — « probable E · distribué E–C » dit min, max et tendance là où la puce muette
  // ne disait rien — mais elle doit SE VOIR comme plus incertaine. Même composant, trait
  // discontinu : deux composants jumeaux auraient divergé, et un rendu identique aurait fait
  // passer une fenêtre de 45 points pour une plage au plancher.
  provisionalLabel?: string; // localized "provisoire · se resserre" shown under the loupe
}
const {
  label,
  grade,
  confidence,
  confidenceLabel,
  renderConfidence = true,
  renderLabel = true,
  showScore = false,
  size = "md",
  layout = "row",
  documentationLabel,
  naLabel = "insufficient data",
  reservedLabel,
  enAttenteLabel,
  band = null,
  provisionalLabel,
} = Astro.props;
const isNa = grade.grade === "insufficient_data";
// En-veille sentinel: a site shown WITHOUT a published grade ("note en attente").
// The letter is never emitted — the chip is neutral, no A–E colour.
const isEnAttente = grade.grade === "en_attente";
const enAttenteText = enAttenteLabel ?? "Note en attente";
const chipClass = isNa ? "grade-na" : isEnAttente ? "grade-enveille" : `grade-${grade.grade.toLowerCase()}`;
const sizeClass = size === "sm" ? "sm" : size === "lg" ? "lg" : "";
const chipText = isNa ? "–" : isEnAttente ? "…" : grade.grade;
const chipAria = isNa ? naLabel : isEnAttente ? enAttenteText : `${label}: ${grade.grade}`;
// A-25: the letter was capped from A for want of third-party operational proof.
const reserved = !isNa && grade.reserved_from === "A" && reservedLabel;
// Loupe (provisional coverage band on a pipeline project): big central letter + the small
// endpoint letters around it. `edges` is the general form (a plage may touch 3 letters, e.g.
// E–C around a central D); `adjacent` is the older single-letter field, kept for safety.
// Bound by the same invariant as every letter here — it carries its confidence + "provisoire" coupling.
const bandEdges = band ? (band.edges ?? (band.adjacent ? [band.adjacent] : [])) : [];
// AXE A–E (Franck, 2026-10-16) — deux pastilles autour d'une grosse lettre n'expriment PAS une
// fourchette : ni axe, ni direction, ni « de… à ». Le lecteur devait deviner une convention que
// rien d'autre sur le site n'emploie, puisque la légende, l'anneau de la carte et le classement
// lisent tous A→E. L'axe porte le sens de lecture, réutilise cet ordre, et montre ce qui est
// EXCLU autant que ce qui est possible — un A éteint dit quelque chose qu'aucune pastille ne
// disait. Les lettres hors plage restent visibles, en retrait : c'est l'échelle entière qui
// donne sa mesure à la fenêtre.
const SCALE = ["A", "B", "C", "D", "E"];
const bandSpan = band ? [band.central, ...bandEdges].sort((a: string, b: string) => SCALE.indexOf(a) - SCALE.indexOf(b)) : [];
const inBand = (g: string) =>
  bandSpan.length > 0 && SCALE.indexOf(g) >= SCALE.indexOf(bandSpan[0]) && SCALE.indexOf(g) <= SCALE.indexOf(bandSpan[bandSpan.length - 1]);
const bandRange = bandSpan.length > 1 ? `${bandSpan[0]}–${bandSpan[bandSpan.length - 1]}` : (band ? band.central : "");
const bandAria = band
  ? `${label}: ${band.central}${bandEdges.length ? ` (${bandEdges.join("–")})` : ""}${band.a_reserved ? " (A réservé)" : ""}`
  : "";
---

{band ? (
  <div class="scorebadge scorebadge-band">
    <span class={`gradechip-loupe${band.wide ? " gradechip-loupe-wide" : ""}`} role="img" aria-label={bandAria}>
      <span class={`gradechip lg grade-${band.central.toLowerCase()}`} aria-hidden="true">{band.central}</span>
    </span>
    <span class="scorebadge-lead-text">
      <span class={renderLabel ? "scorebadge-label" : "sr-only"}>{label}</span>
      <span class="gradeaxis" aria-hidden="true">
        {SCALE.map((g: string) => (
          <span class={`gradeaxis-step grade-${g.toLowerCase()}${inBand(g) ? "" : " out"}${g === band.central ? " is-central" : ""}`}>{g}</span>
        ))}
      </span>
      {provisionalLabel && <span class="scorebadge-prov">{provisionalLabel}</span>}
      {band.a_reserved && reservedLabel && <span class="scorebadge-reserved">{reservedLabel}</span>}
      {/* « confiance : faible » sapait la note qu'elle accompagne — le mot porte sur ce qu'on
          vaut, pas sur ce qu'on sait. On dit donc ce qui est réellement mesuré : l'état du
          DOSSIER. Même formulation que les notes définitives, qui l'emploient déjà. */}
      {renderConfidence && (documentationLabel
        ? <span class="scorebadge-doc">{documentationLabel}</span>
        : (
        <span class={`confidence ${confidence}`}>
          <span class="dot" aria-hidden="true"></span>
          {confidenceLabel}
        </span>
      ))}
    </span>
  </div>
) : layout === "lead" ? (
  <div class="scorebadge scorebadge-lead">
    <span class={`gradechip ${sizeClass} ${chipClass}`} title={isNa ? naLabel : undefined} aria-label={chipAria}>{chipText}</span>
    <span class="scorebadge-lead-text">
      <span class={renderLabel ? "scorebadge-label" : "sr-only"}>{label}</span>
      {documentationLabel && <span class="scorebadge-doc">{documentationLabel}</span>}
      {reserved && <span class="scorebadge-reserved">{reservedLabel}</span>}
    </span>
  </div>
) : (
  <div class="scorebadge">
    <div class="scorebadge-row">
      <span class={renderLabel ? "scorebadge-label" : "sr-only"}>{label}</span>
      <span class="scorebadge-value">
        {showScore && !isNa && grade.score !== undefined && (
          <span class="scorebadge-score">{grade.score.toFixed(1)}/100</span>
        )}
        <span class={`gradechip ${sizeClass} ${chipClass}`} title={isNa ? naLabel : undefined} aria-label={chipAria}>{chipText}</span>
      </span>
    </div>
    {documentationLabel ? (
      <span class="scorebadge-doc">{documentationLabel}</span>
    ) : (
      renderConfidence && (
        <span class={`confidence ${confidence}`}>
          <span class="dot" aria-hidden="true"></span>
          {confidenceLabel}
        </span>
      )
    )}
    {reserved && <span class="scorebadge-reserved">{reservedLabel}</span>}
  </div>
)}
