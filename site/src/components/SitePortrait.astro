---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
//
// LE PORTRAIT DU SITE — la même donnée, l'autre persona.
//
// La fiche technique s'adresse à qui sait lire vingt-six indicateurs : un exploitant, un
// analyste, un assureur. Le portrait s'adresse à qui habite à côté, ou qui siège au conseil
// municipal. Mêmes faits, mêmes sources, aucune donnée de plus — mais l'ordre, la langue et
// la fin sont ceux d'une décision à prendre, pas d'un dossier à instruire. Les deux pages se
// renvoient l'une à l'autre : confondre les deux publics, c'est en perdre un.
//
// 🔴 RIEN N'EST RÉDIGÉ À LA MAIN ICI. Les trois points décisifs sortent du facteur dominant
// et des sous-notes ; les questions sortent de questions-derivees.ts (indicateur × état ×
// stade) ; la procédure sort du dossier procedure/, et son ABSENCE a son propre texte, qui
// dit ce qui reste vrai au lieu d'avouer notre retard. Une phrase écrite à la main ici
// serait une affirmation que personne ne pourrait vérifier.
import Base from "../layouts/Base.astro";
import type { NavNode } from "../config/nav";
import PillarIcon from "./PillarIcon.astro";
import type { PillarIconName } from "./PillarIcon.astro";
import methodologyData from "../../public/data/methodology.json";
import { libelleValeur, libelleUnite } from "../config/indicatorValues";
import { questionsPour } from "../content/questions-derivees";
import { resolveProcedure, windowFor, deadlinesFor, documentsFor } from "../content/procedure";
import { procedureAbsente } from "../content/procedure/absente";

import printer from "@phosphor-icons/core/assets/regular/printer.svg?raw";
import shareNetwork from "@phosphor-icons/core/assets/regular/share-network.svg?raw";
import linkSimple from "@phosphor-icons/core/assets/regular/link-simple.svg?raw";
import flagIcon from "@phosphor-icons/core/assets/regular/flag.svg?raw";
import envelope from "@phosphor-icons/core/assets/regular/envelope-simple.svg?raw";
import whatsappLogo from "@phosphor-icons/core/assets/regular/whatsapp-logo.svg?raw";
import facebookLogo from "@phosphor-icons/core/assets/regular/facebook-logo.svg?raw";
import linkedinLogo from "@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw";
import xLogo from "@phosphor-icons/core/assets/regular/x-logo.svg?raw";

interface Props {
  dc: any;
  lang: "fr" | "en";
  t: any;
  nav: NavNode[];
  altHref: string;
  altLabel: string;
}
const { dc, lang, t, nav, altHref, altLabel } = Astro.props as Props;
const L = (o: any) => (o && typeof o === "object" ? (lang === "fr" ? o.fr : o.en) : o);

const methodology = methodologyData as any;
const defs: any[] = methodology.indicators;
const defById = Object.fromEntries(defs.map((d) => [d.id, d]));
const pillars = methodology.pillars as any[];
const pillarIconName: Record<string, PillarIconName> = {
  energy: "energy", water: "water", land_biodiversity: "land",
  local_impact: "local", transparency_governance: "transparency",
};

// ── La note. Même contrat que la fiche : la bande prime quand elle existe, et elle se
// montre comme provisoire. Afficher la lettre définitive là où la fiche la retient serait
// la contradiction qu'on vient de corriger partout ailleurs.
const band = dc.provisional_band;
const probable = typeof band?.central === "string";
const lettre = probable ? band.central : dc.grades?.site?.grade;
const lettreAffichable = typeof lettre === "string" && /^[A-E]$/.test(lettre);
const fenetre: string | null = probable && band.band !== band.central ? band.band : null;
const SCALE = ["A", "B", "C", "D", "E"];
const bornes = fenetre ? fenetre.split("–") : null;
// 🔴 Les classes `grade-x` de global.css ne peignent qu'À L'INTÉRIEUR de `.gradechip`.
// Les poser seules donnait une pastille blanche sur blanc — invisible, et personne ne
// l'aurait vu sur une page de test. On lit la variable CSS, qui est la vraie source.
const fond = (g: string) => `background: var(--grade-${g.toLowerCase()})${g === "C" ? "; color:#4a3c00" : ""}`;
const dansFenetre = (g: string) =>
  !bornes || (SCALE.indexOf(g) >= SCALE.indexOf(bornes[0]) && SCALE.indexOf(g) <= SCALE.indexOf(bornes[1]));

// ── Les indicateurs, rangés par ce qu'ils disent.
const inds: any[] = (dc.indicators ?? []).map((i: any) => ({ ...i, block: defById[i.id]?.block ?? "base" }));
const pose = (i: any) => i.status === "measured" || i.status === "announced" || i.status === "estimated";
const poses = inds.filter(pose);
const parPilier = (p: string) => poses.filter((i) => i.pillar === p);
// Le compte doit décrire CE QUE LA LETTRE RÉSUME. Une sous-note de pilier est agrégée sur
// tous ses indicateurs MVP, bloc projet et process compris — c'est pour ça que la
// transparence de Fouju porte un A alors qu'elle n'a aucun indicateur de base. Compter la
// base seule donnait « 0 sur 0 » sous une lettre bien fondée.
const mvpParPilier = (p: string) => defs.filter((d: any) => d.mvp && d.pillar === p).length;

const valeur = (i: any) => {
  const d = defById[i.id];
  const u = d?.unit ? " " + libelleUnite(d.unit, lang) : "";
  return typeof i.value === "number" ? `${i.value}${u}` : libelleValeur(i.id, i.value, lang);
};

// ── LES TROIS POINTS QUI DÉCIDERONT. Choisis, pas rédigés : le pilier que le moteur
// désigne comme dominant d'abord, puis les piliers les mieux documentés. Un pilier sans
// aucune mesure n'a rien à dire et ne prend pas la place d'un qui en a.
const pilierDominant: string | null = dc.dominant_drag?.indicator
  ? (defById[dc.dominant_drag.indicator]?.pillar ?? null) : null;
const ordreDecisifs = [...pillars]
  .filter((p) => parPilier(p.id).length > 0)
  .sort((a, b) => {
    if ((a.id === pilierDominant) !== (b.id === pilierDominant)) return a.id === pilierDominant ? -1 : 1;
    return parPilier(b.id).length - parPilier(a.id).length;
  })
  .slice(0, 3);

// Trois faits par point, pas six : le portrait n'est pas le tableau de la fiche. L'ordre
// est dérivé — l'indicateur que le moteur désigne comme dominant d'abord, puis ce que le
// TERRITOIRE impose (bloc base) avant ce que le porteur ANNONCE (bloc projet), parce que
// c'est la distinction que le lecteur doit emporter.
const FAITS_MAX = 3;
const faitsDe = (p: string) =>
  [...parPilier(p)]
    .sort((a, b) => {
      const dom = (i: any) => (i.id === dc.dominant_drag?.indicator ? 0 : 1);
      if (dom(a) !== dom(b)) return dom(a) - dom(b);
      const bloc = (i: any) => (i.block === "base" ? 0 : 1);
      return bloc(a) - bloc(b);
    })
    .slice(0, FAITS_MAX);

// ── LES QUESTIONS. Indicateur × état × stade, plus l'affûtage par combinaison.
const questions = questionsPour(inds, dc.project_status, pilierDominant);

// ── CE QUE NOUS N'AVONS PAS MESURÉ. Bloc BASE seulement : ce sont nos trous, pas ceux du
// porteur, et les confondre ferait poser au lecteur une question qui n'a pas de destinataire.
const nonMesures = inds
  .filter((i) => i.block === "base" && (i.status === "not_collected" || i.status === "missing"))
  .map((i) => ({ id: i.id, label: L(defById[i.id]?.label), verifie: i.status === "missing" }));

// ── LA PROCÉDURE. Lue, ou bien son absence — qui n'est jamais un blanc.
const proc = resolveProcedure(dc.country, dc.admin_area);
const fenetreProc = proc ? windowFor(proc, dc.project_status) : null;
const delais = proc ? deadlinesFor(proc) : [];
const docs = proc ? documentsFor(proc) : [];
const absente = proc ? null : procedureAbsente(dc.country);

const STADES = ["announced", "permitting", "under_construction", "operational"];
const stadeIdx = STADES.indexOf(dc.project_status);

// ── LA PHOTO. La carte de contexte annotée, pas la vue brute : c'est elle qui porte
// l'emprise, le cours d'eau et les anneaux de distance — ce qu'un tableau ne montre pas.
const photo = dc.context_map?.urls?.[lang] ?? dc.satellite_image?.url ?? null;
const photoCredit = dc.context_map?.credit ?? dc.satellite_image?.credit ?? null;
// La mise en garde voyage avec l'image : les anneaux sont des tampons de distance, pas un
// zonage réglementaire. Elle n'était pas affichée — une image annotée sans sa mise en garde
// se lit comme une carte officielle.
const photoCaveat = L(dc.context_map?.caveat) ?? null;

const ficheHref = lang === "fr" ? `/fr/dc/${dc.id}/` : `/dc/${dc.id}/`;
// Le pied de page affichait le seul chemin (« /fr/dc/ch-cdrom-le-noirmont/ »). Un portrait
// est fait pour être IMPRIMÉ et posé sur une table : sur papier, un chemin sans domaine ne
// mène nulle part. L'adresse s'écrit donc en entier, celle qu'on peut recopier.
const ficheUrl = `https://scoremydatacenter.org${ficheHref}`;
const url = `https://scoremydatacenter.org${lang === "fr" ? "/fr" : ""}/dc/${dc.id}/portrait/`;
const titre = `${dc.name} — ${t.kicker}`;
const lieu = [dc.municipality, dc.admin_area].filter(Boolean).join(", ");

// 🔴 LE TITRE NE PORTAIT NI LA CATÉGORIE NI LE LIEU (audit de demande, 2026-10-26).
// « Campus IA Fouju — Portrait du site | ScoreMyDataCenter » : « portrait du site » est notre
// jargon — zéro recherche — et le suffixe de marque mangeait vingt caractères que Google
// affiche déjà sous le titre. Mesuré le même jour : la demande française est faite de noms de
// communes (huit des dix suggestions de Google sur « data center » sont des villes à projet),
// et « data center noise » vaut 37 au mondial, 34 aux États-Unis, sans qu'aucun de nos titres
// ne le porte.
//
// ⚠️ LE PORTRAIT NE PEUT PAS COPIER LE TITRE DE LA FICHE : deux URLs du même site avec le même
// titre se cannibalisent. Il porte donc le MÊME lieu et un angle DIFFÉRENT — celui que la page
// tient réellement, puisqu'elle a une section « Le bruit — continu, jour et nuit ». La note
// reste à la fiche, le vécu au portrait.
//
// Le lieu ne disparaît jamais : 65 caractères est une limite d'affichage, pas d'indexation.
// On dégrade dans l'ordre du moins coûteux — la région, puis l'angle.
const ptLieuCourt = dc.municipality
  ? (lang === "fr" ? `data center à ${dc.municipality}` : `data center in ${dc.municipality}`)
  : "data center";
const ptLieu = ptLieuCourt + (dc.municipality && dc.admin_area ? ` (${dc.admin_area})` : "");
const ptSep = lang === "fr" ? " : " : ": ";
const seoTitle = [
  `${dc.name} — ${ptLieu}${ptSep}${t.seoAngle}`,
  `${dc.name} — ${ptLieuCourt}${ptSep}${t.seoAngle}`,
  `${dc.name} — ${ptLieuCourt}`,
].find((s) => s.length <= 65) ?? `${dc.name} — ${ptLieuCourt}`;
---

<Base
  lang={lang}
  title={seoTitle}
  description={t.metaDescription.replace("{name}", dc.name).replace("{place}", ptLieu)}
  tagline={t.tagline}
  altHref={altHref}
  altLabel={altLabel}
  nav={nav}
>
  <article class="pt">
    <header class="pt-head">
      <div>
        <p class="pt-kicker">{t.kicker}</p>
        <h1>{dc.name}</h1>
        <p class="pt-where">
          {lieu}{dc.operator ? ` · ${dc.operator}` : ""} ·
          <strong>{t.status[dc.project_status] ?? dc.project_status}</strong>
        </p>
      </div>
      <p class="pt-mark">{t.tagline}</p>
    </header>

    <section class="pt-banner">
      <div class="pt-grade">
        <p class="pt-grade-label">{t.siteGrade}</p>
        {lettreAffichable ? (
          <span class={`pt-letter${probable ? " pt-letter-prob" : ""}`} style={fond(lettre)}>{lettre}</span>
        ) : (
          <span class="pt-letter pt-letter-none">—</span>
        )}
        {lettreAffichable && (
          <p class="pt-scale" aria-hidden="true">
            {SCALE.map((g) => (
              <span class={`pt-step${dansFenetre(g) ? "" : " out"}`} style={fond(g)}>{g}</span>
            ))}
          </p>
        )}
        <p class="pt-grade-note">
          {probable ? (fenetre ? t.probableWindow.replace("{w}", fenetre) : t.probable) : t.definitive}
        </p>
      </div>

      <div class="pt-lead">
        {dc.citable_quote && <p class="pt-quote">{L(dc.citable_quote)}</p>}
        <p>{t.leadHelp}</p>
      </div>

      {photo && (
        <figure class="pt-photo">
          {/* LA VUE EST TROP PETITE POUR ÊTRE LUE, et c'est inhérent : l'image fait
              1200 px de large, le bandeau lui en donne 240. Elle porte pourtant ce qu'aucun
              tableau ne montre — l'emprise, le cours d'eau, les premières maisons. La loupe
              rend sa résolution native au survol ; le clic ouvre l'image entière, pour le
              tactile et pour qui veut l'examiner vraiment. */}
          <a class="pt-photo-zone" href={photo} target="_blank" rel="noopener"
             data-zoom={photo} aria-label={t.photoOpen}>
            <img src={photo} alt={t.photoAlt.replace("{name}", dc.name)} loading="lazy" />
            <span class="pt-lens" aria-hidden="true"></span>
            <span class="pt-photo-hint" aria-hidden="true">{t.photoHint}</span>
          </a>
          <figcaption>
            {photoCaveat && <span class="pt-photo-caveat">{photoCaveat}</span>}
            {photoCredit}
          </figcaption>
        </figure>
      )}
    </section>

    <h2>{t.pillarsTitle}</h2>
    <ul class="pt-pillars">
      {pillars.map((p) => {
        const sous = dc.pillar_bands?.[p.id];
        const detail = dc.pillars?.[p.id];
        // MÊME RÈGLE QUE LA FICHE, mot pour mot : la sous-note probable quand elle existe,
        // sinon la lettre définitive du pilier. J'ai cru un instant devoir retenir la
        // seconde — à tort : sur Fouju la transparence porte un A fondé sur T1 et T2, qui
        // sont dans le bloc PROCESS. Mon dénominateur ne comptait que la base, affichait
        // « 0 sur 0 », et j'ai conclu de mon propre bug d'affichage que la lettre était
        // infondée. Le compte est corrigé plus bas ; la lettre n'avait pas à l'être.
        const g = sous?.central ?? (/^[A-E]$/.test(detail?.grade ?? "") ? detail.grade : null);
        const n = parPilier(p.id).length;
        const total = mvpParPilier(p.id);
        return (
          <li class="pt-pillar">
            <PillarIcon name={pillarIconName[p.id]} size={18} />
            <span class="pt-pillar-name">{L(p.label)}</span>
            {total > 0 && (
              <span class="pt-pillar-count">{t.ofMeasures.replace("{n}", String(n)).replace("{total}", String(total))}</span>
            )}
            {g ? (
              <span class={`pt-pg${sous ? " pt-letter-prob" : ""}`} style={fond(g)}>{g}</span>
            ) : (
              <span class="pt-pg pt-pg-none">{n > 0 ? "·" : "–"}</span>
            )}
          </li>
        );
      })}
    </ul>
    <p class="pt-note">{t.pillarsNote}</p>

    {ordreDecisifs.length > 0 && (
      <>
        <h2>{t.decisiveTitle}</h2>
        <div class="pt-cards">
          {ordreDecisifs.map((p) => {
            const mesures = faitsDe(p.id);
            const q = questions.find((x) => defById[x.id]?.pillar === p.id);
            return (
              <div class="pt-card">
                <PillarIcon name={pillarIconName[p.id]} size={20} />
                <div>
                  <p class="pt-card-title">{L(p.label)}</p>
                  <ul class="pt-facts">
                    {mesures.map((i) => (
                      <li><span class="pt-fact-label">{L(defById[i.id]?.label)} :</span> <strong>{valeur(i)}</strong></li>
                    ))}
                  </ul>
                  {q && (
                    <p class="pt-ask">
                      <strong>{L(q.amorce)} :</strong> <mark>{L(q.texte)}</mark>
                      <span class="pt-rule">{L(q.verbe)}</span>
                    </p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </>
    )}

    <h2>{t.streetTitle}</h2>
    <div class="pt-cards">
      <div class="pt-card">
        <PillarIcon name="noise" size={20} />
        <div>
          <p class="pt-card-title">{t.noiseTitle}</p>
          <p>{t.noiseBody}</p>
          <p class="pt-ask">
            {dc.nearest_dwelling?.distance_m != null
              ? t.noiseDistance.replace("{m}", String(Math.round(dc.nearest_dwelling.distance_m)))
              : t.noiseNoDistance}
          </p>
        </div>
      </div>
      <div class="pt-card">
        <PillarIcon name="fuel" size={20} />
        <div>
          <p class="pt-card-title">{t.fuelTitle}</p>
          <p>{t.fuelBody}</p>
        </div>
      </div>
    </div>
    <p class="pt-note">{t.healthDisclaimer}</p>

    <div class="pt-two">
      <section>
        <h2>{t.unknownTitle}</h2>
        {nonMesures.length > 0 ? (
          <ul class="pt-unknown">
            {nonMesures.map((m) => (
              <li>{m.label}<span class="pt-rule">{m.verifie ? t.verifiedAbsent : t.notCollected}</span></li>
            ))}
          </ul>
        ) : (
          <p>{t.unknownNone}</p>
        )}
        <p class="pt-note">{t.unknownNote}</p>
      </section>

      <section>
        <h2>{t.procedureTitle}</h2>
        <div class="pt-proc">
          <ol class="pt-stages" aria-label={t.procedureTitle}>
            {STADES.map((s, k) => (
              <li class={k === stadeIdx ? "on" : k < stadeIdx ? "done" : ""}>{t.status[s]}</li>
            ))}
          </ol>
          {proc ? (
            <>
              <p class="pt-auth">{L(proc.jurisdiction.authority)}</p>
              {fenetreProc && <p class="pt-window">{L(fenetreProc.text)}</p>}
              {delais.map((d: any) => <p class="pt-deadline">{L(d.text)}</p>)}
              {docs.map((d: any) => <p class="pt-doc">{L(d.text)}</p>)}
              <p class="pt-cites">
                {[...(fenetreProc ? [fenetreProc] : []), ...delais, ...docs].map((c: any, k: number) => (
                  <>{k > 0 ? " · " : ""}<a href={c.url} rel="noopener">{c.cite}</a></>
                ))}
              </p>
            </>
          ) : (
            <>
              <p>{L(absente!.cadre)}</p>
              <p>{L(absente!.levier)}</p>
              <p class="pt-window">{L(absente!.question)}</p>
            </>
          )}
        </div>
      </section>
    </div>

    {questions.length > 0 && (
      <>
        <h2>{t.writeInTitle}</h2>
        <div class="pt-writein">
          <ul>
            {questions.map((q) => (
              <li>
                <strong>{L(q.amorce)} :</strong> {L(q.texte)}
                <span class="pt-rule">{L(q.verbe)}</span>
              </li>
            ))}
          </ul>
          <p class="pt-note">{t.writeInNote}</p>
        </div>
      </>
    )}

    <div class="pt-actions">
      <p class="pt-cross">↔ <a href={ficheHref}>{t.technicalSheet}</a> — {t.technicalSheetSub}</p>
      <button type="button" class="pt-bt" id="pt-print" title={t.print} aria-label={t.print}><Fragment set:html={printer} /></button>
      <a class="pt-bt" href={`mailto:contact@scoremydatacenter.org?subject=${encodeURIComponent(t.signalSubject)}&body=${encodeURIComponent(url)}`} title={t.signal} aria-label={t.signal}><Fragment set:html={flagIcon} /></a>
      <details class="pt-share">
        <summary class="pt-bt" title={t.share} aria-label={t.share}><Fragment set:html={shareNetwork} /></summary>
        <div class="pt-menu">
          <a href={`mailto:?subject=${encodeURIComponent(titre)}&body=${encodeURIComponent(url)}`}><Fragment set:html={envelope} />{t.shareMail}</a>
          <a href={`https://wa.me/?text=${encodeURIComponent(titre + " " + url)}`} target="_blank" rel="noopener"><Fragment set:html={whatsappLogo} />WhatsApp</a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener"><Fragment set:html={facebookLogo} />Facebook</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener"><Fragment set:html={linkedinLogo} />LinkedIn</a>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(titre)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener"><Fragment set:html={xLogo} />X</a>
          <button type="button" id="pt-copy"><Fragment set:html={linkSimple} />{t.copyLink}</button>
        </div>
      </details>
    </div>

    <footer class="pt-foot">
      <p>{t.howToRead}</p>
      <p class="pt-src">{t.sourcesOn} <a href={ficheHref}>{ficheUrl}</a></p>
    </footer>
  </article>
</Base>

<script is:inline define:vars={{ url }}>
  // LOUPE SUR LA VUE AÉRIENNE. L'image est servie à 1 200 px et affichée à ~240 : la loupe
  // la rend à sa résolution native sous le curseur. Le facteur se CALCULE à partir des
  // dimensions réelles — le figer aurait menti le jour où une image sort dans un autre
  // format. Sans souris (tactile, clavier), le lien ouvre l'image entière : la loupe est un
  // confort, jamais le seul accès.
  document.querySelectorAll("[data-zoom]").forEach((zone) => {
    const img = zone.querySelector("img");
    const lens = zone.querySelector(".pt-lens");
    if (!img || !lens) return;
    lens.style.backgroundImage = `url("${zone.dataset.zoom}")`;
    const suivre = (e) => {
      const r = zone.getBoundingClientRect();
      const nw = img.naturalWidth, nh = img.naturalHeight;
      if (!nw || !nh || nw <= r.width) return;    // rien à agrandir
      // L'image est en `object-fit: cover` : elle est mise à l'échelle pour REMPLIR le
      // cadre, et débordée puis centrée sur l'axe le plus long. Tabler sur « l'image
      // occupe exactement le cadre » marche tant que les deux rapports coïncident — et
      // ment dès qu'une vue sort dans un autre format. On refait donc le calcul du
      // navigateur : échelle de couverture, décalage de centrage, puis position native.
      const s = Math.max(r.width / nw, r.height / nh);
      const ox = (r.width - nw * s) / 2, oy = (r.height - nh * s) / 2;
      const x = e.clientX - r.left, y = e.clientY - r.top;
      if (x < 0 || y < 0 || x > r.width || y > r.height) return;
      const d = lens.offsetWidth || 176;
      lens.style.backgroundSize = `${nw}px ${nh}px`;          // résolution native
      lens.style.backgroundPosition =
        `${-((x - ox) / s - d / 2)}px ${-((y - oy) / s - d / 2)}px`;
      lens.style.left = `${x - d / 2}px`;
      lens.style.top = `${y - d / 2}px`;
      zone.setAttribute("data-on", "1");
    };
    zone.addEventListener("mousemove", suivre);
    zone.addEventListener("pointermove", (e) => { if (e.pointerType !== "touch") suivre(e); });
    zone.addEventListener("mouseleave", () => zone.removeAttribute("data-on"));
    zone.addEventListener("pointerleave", () => zone.removeAttribute("data-on"));
  });

  document.getElementById("pt-print")?.addEventListener("click", () => window.print());
  document.getElementById("pt-copy")?.addEventListener("click", async (e) => {
    try {
      await navigator.clipboard.writeText(url);
      const b = e.currentTarget;
      b.setAttribute("data-copied", "1");
      setTimeout(() => b.removeAttribute("data-copied"), 1800);
    } catch { /* presse-papier refusé : le lien reste dans la barre d'adresse */ }
  });
</script>

