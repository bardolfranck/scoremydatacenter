---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// The landing is fed by the engine's artifacts (scores.json, methodology.json)
// generated at build time — no hand-written grade ever appears here.
import Base from "../layouts/Base.astro";
import ScoreBadge from "./ScoreBadge.astro";
import AboutSection from "./AboutSection.astro";
import FeedbackBand from "./FeedbackBand.astro";
import MapIsland from "./MapIsland.astro";
import PillarIcon from "./PillarIcon.astro";
import type { PillarIconName } from "./PillarIcon.astro";
import scoresData from "../../public/data/scores.json";
import methodologyData from "../../public/data/methodology.json";
import indicesData from "../../public/data/indices.json";
import showcaseData from "../../public/data/home_showcase.json";
import SatelliteWall from "./SatelliteWall.astro";
import ProjectsStrip from "./ProjectsStrip.astro";
import ActuStrip from "./ActuStrip.astro";
import CountryRing from "./CountryRing.astro";
import { COUNTRY_NAMES, countryFlag } from "../config/indices";

const showcase = showcaseData as any;

// Bloc home « Classement des pays » (brief indices §2.2) : top 5 éligibles.
const idxCountries = (indicesData as any).countries as Record<string, any>;
const idxTop5 = Object.entries(idxCountries)
  .filter(([, e]) => e.eligible)
  .sort(([, a], [, b]) => b.score - a.score)
  .slice(0, 5);
const idxTotal = Object.keys(idxCountries).length;

interface Props {
  lang: "en" | "fr";
  t: Record<string, any>;
}
const { lang, t } = Astro.props;

const scores = scoresData as any[];
const methodology = methodologyData as any;

// v2 hero (Franck GO 2026-07-15): the corpus at a glance — every figure computed
// from the build's own artifacts, never hand-written; no invented trends.
import { readFileSync } from "node:fs";
import { chiffresAccueil } from "../content/accueil";
import type { Langue } from "../content/langues";
const real = scores.filter((d: any) => !d.id.startsWith("zz-"));
const dcFiles = import.meta.glob("../../public/data/dc/*.json", { eager: true });
const dcAll = Object.values(dcFiles).map((m: any) => (m as any).default).filter((d: any) => !d.id.startsWith("zz-"));
const dcById: Record<string, any> = Object.fromEntries(dcAll.map((d: any) => [d.id, d]));
// 🔴 « PROJETS NOTÉS » COMPTAIT DES PROJETS QUI NE SONT PAS NOTÉS (corrigé 2026-10-17).
// Il affichait la taille du corpus — 2 198 — alors que 342 fiches ne portent aucune lettre :
// 339 en attente (note probable publiée en plage) et 3 en données insuffisantes. La page se
// contredisait elle-même à trois écrans d'intervalle, puisque sa propre FAQ dit qu'aux
// États-Unis on publie la veille et « jamais une note ».
// Le compteur dit donc ce que son libellé promet : les sites qui portent une lettre A–E.
const GRADES_SERVIS = ["A", "B", "C", "D", "E"];
const notedCount = real.filter((d: any) =>
  GRADES_SERVIS.includes(d?.grades?.site?.grade)).length;

// 🔴 CE COMPTEUR SOUS-DÉCLARAIT NOTRE PROPRE CONSTAT (corrigé 2026-10-17). Il cherchait
// `extremely_high` — une valeur qui n'existe PAS dans notre échelle, qui s'appelle
// `zre_or_crisis`. Zéro site trouvé dans une classe inexistante ressemble à une classe vide :
// rien n'a crié, et les 234 sites de la pire classe — zone de répartition des eaux, ou crise —
// n'étaient comptés nulle part. La home annonçait 521 là où la mesure en donne 755.
//
// Donc on ne RECOPIE plus les noms de classes : on les DÉRIVE du barème servi. « Sous tension »
// = les classes que la grille pénalise plus qu'elle ne récompense, c'est-à-dire sous la moitié
// de l'échelle. Renommer une classe ou en ajouter une suit tout seul ; se tromper de nom devient
// impossible, puisqu'on ne l'écrit plus.
const W1 = (methodology.indicators as any[]).find((i: any) => i.id === "W1");
const W1_CATEGORIES: Record<string, number> = W1?.normalization?.categories ?? {};
const CLASSES_SOUS_TENSION = Object.entries(W1_CATEGORIES)
  .filter(([, score]) => Number(score) < 50)
  .map(([nom]) => nom);
// Figer l'ATTENTE, pas le résultat du jour : si le barème change de forme et que la dérivation
// ne rend plus rien, le build casse au lieu d'afficher un zéro qui passerait pour une bonne
// nouvelle. C'est exactement l'échec qu'on vient de réparer.
if (CLASSES_SOUS_TENSION.length === 0) {
  throw new Error(
    "Landing: aucune classe de tension hydrique dérivée du barème W1 — le compteur de la home " +
    `afficherait 0. Catégories lues : ${JSON.stringify(W1_CATEGORIES)}`
  );
}
const w1Values = dcAll.map((d: any) =>
  (d.indicators || []).find((i: any) => i.id === "W1")?.value)
  .map((v: any) => (v == null ? null : String(v).toLowerCase()));
// Le dénominateur est le nombre de sites où l'eau est MESURÉE, pas le corpus entier : rapporter
// une mesure à des fiches qui ne l'ont pas diluerait le constat.
const stressBase = w1Values.filter((v: string | null) => v !== null).length;
const stressCount = w1Values.filter((v: string | null) => v !== null
  && CLASSES_SOUS_TENSION.includes(v)).length;
let watchCount = 0;
try { watchCount = JSON.parse(readFileSync(new URL("../../public/data/watchlist.geojson", import.meta.url), "utf8")).features.length; } catch { /* optional layer */ }
// L'anneau comptait les pays où nous NOTONS, et donnait donc du corpus une image bien plus
// européenne qu'il ne l'est : la veille suit 842 projets aux États-Unis, plus l'Algérie, le
// Maroc, la Tunisie et l'Islande. Il compte désormais les pays SUIVIS — notés ou en veille —
// ce qui est la vraie portée de l'observatoire, et ce que la statistique « projets en veille »
// posée juste à côté affirme déjà.
//
// EH (Sahara occidental) est volontairement écarté : y poser un drapeau serait prendre parti
// dans un conflit de souveraineté, et n'en pas poser afficherait un code en lettres. Un seul
// projet est concerné ; la décision appartient à Franck, pas à ce fichier.
let watchCountries: string[] = [];
try {
  watchCountries = JSON.parse(readFileSync(new URL("../../public/data/watchlist.geojson", import.meta.url), "utf8"))
    .features.map((f: any) => f.properties?.country);
} catch { /* couche optionnelle */ }
const ringCountries = [...new Set([...real.map((d: any) => d.country), ...watchCountries])]
  .filter((c: string) => Boolean(c) && c !== "EH");
const nCountries = ringCountries.length;
const noPowerCount = real.filter((d: any) => typeof d.power_mw !== "number").length;
const corpusStats = [
  { figure: String(notedCount), label: t.corpus.noted },
  { figure: String(nCountries), label: t.corpus.countries },
  { figure: String(stressCount), label: t.corpus.stress },
  { figure: String(watchCount), label: t.corpus.watch },
];
// The flag ring now MAKES the "N pays" statement, so the hero strip drops that
// stat and keeps the three figures the ring can't say (sites / stress / veille).
const heroStrip = corpusStats.filter((s) => s.label !== t.corpus.countries);
// Explore teasers — the strongest project and the two most exposed, percentile-framed
// (A-27 register: we situate, we never judge), plus the last scored fiches.
const graded = real.filter((d: any) => typeof d.grades.site.score === "number");
const sitePool = graded.map((d: any) => d.grades.site.score).sort((a: number, b: number) => a - b);
const bottomPct = (v: number) => Math.ceil((sitePool.filter((x: number) => x <= v).length / sitePool.length) * 100);
const byScore = [...graded].sort((a: any, b: any) => b.grades.site.score - a.grades.site.score);
const rankTeaser = [byScore[0], byScore[byScore.length - 1], byScore[byScore.length - 2]]
  .filter(Boolean).map((d: any) => ({ dc: d, p: Math.min(100, Math.max(1, bottomPct(d.grades.site.score))) }));
// "Latest scored" would need a real score_history — the bulk corpus has none yet,
// and we never invent a date. Until the audit history fills, the honest teaser is
// the highest DECLARED power (same MW story as the map).
const latest = [...real]
  .filter((d: any) => typeof d.power_mw === "number")
  .sort((a: any, b: any) => b.power_mw - a.power_mw)
  .slice(0, 5);
// Les trois chiffres de « pourquoi maintenant », calculés au build : la table porte les
// phrases, le module porte le remplissage (périmètre et format compris, qui diffèrent par
// langue). Les deux pages composaient la même chose, chacune chez elle.
const chiffres = chiffresAccueil(lang as Langue);
const ficheBase = t.chemins.fiche;
const rankPath = t.chemins.classement;
const pillarOrder = methodology.pillars.map((p: any) => p.id);

// The "money shot" (brief 2026-07-12 #3): a real published case whose fiche
// grades itself on scroll-in, now ON its own satellite photo (Franck 2026-07-20).
// WHICH site is an engine decision, not a filter accident: home_showcase.json
// ranks the most ORDINARY site (closest to the corpus median) and excludes every
// hot signal. The old rule here demanded all 5 pillars — only 2 fiches of 479
// qualify, and the home ended up on the most contested FR project by accident.
// We walk the ranked candidates and take the first one that has a photo.
const demoPick = (showcase.demo_candidates as any[])
  .map((c: any) => ({ candidate: c, dc: dcById[c.id], score: scores.find((s: any) => s.id === c.id) }))
  .find((x: any) => x.dc?.satellite_image?.url && x.score);
const demo = demoPick?.score ?? scores.find((d: any) => !d.id.startsWith("zz-") && d.grades.site.score != null);
const demoPhoto = demoPick?.dc?.satellite_image?.url ?? null;
const demoPlace = demoPick?.dc?.municipality ?? null;

const pillarIconName: Record<string, PillarIconName> = {
  energy: "energy", water: "water", land_biodiversity: "land",
  local_impact: "local", transparency_governance: "transparency",
};
// Distinct category colours for the weight donut (not the A–E grade palette).
const pillarColor: Record<string, string> = {
  energy: "#d98c1f", water: "#2a78d6", land_biodiversity: "#3b8a4f",
  local_impact: "#7a5bb0", transparency_governance: "#55677c",
};
// Weight donut as a conic-gradient — slices sum to exactly 100% (an honest
// part-of-whole, unlike a bar whose full track means nothing).
let _acc = 0;
const donutGradient = "conic-gradient(" + methodology.pillars.map((p: any) => {
  const start = Math.round(_acc * 100 * 10) / 10;
  _acc += p.weight;
  const end = Math.round(_acc * 100 * 10) / 10;
  return `${pillarColor[p.id]} ${start}% ${end}%`;
}).join(", ") + ")";
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  tagline={t.tagline}
  altHref={t.altHref}
  altLabel={t.altLabel}
  nav={t.nav}
>
  <section class="hero hero-v2">
    <div class="hero-copy">
      {t.heroEyebrow && <p class="hero-eyebrow">{t.heroEyebrow}</p>}
      <h1 set:html={t.heroTitle}></h1>
      <p class="hero-lede">{t.heroLede}</p>
      {t.heroStandards && (
        <p class="hero-standards" set:html={t.heroStandards.replace("{n}", real.length.toLocaleString(t.formes.locale))}></p>
      )}
      <ul class="hero-checks">
        {t.heroChecks.map((c: string) => <li set:html={c}></li>)}
      </ul>
      <div class="hero-actions">
        <a class="button button-primary" href="#scores">{t.ctaScores}</a>
        <a class="button button-secondary" href="#method">{t.ctaMethod}</a>
      </div>
    </div>
    <aside class="hero-corpus hero-ring-aside" aria-label={t.corpus.aria}>
      <p class="corpus-label">{t.corpus.label}</p>
      <CountryRing countries={ringCountries} lang={lang} />
      <div class="corpus-stats corpus-strip">
        {heroStrip.map((stat) => (
          <div class="stat">
            <b><span class="sr-only">{stat.figure}</span><span class="stat-anim" aria-hidden="true">{stat.figure}</span></b>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
      <div class="corpus-scale">
        <div class="hero-scale" role="img" aria-label={t.heroScaleLabel}>
          <span class="hs-cell hs-a">A</span>
          <span class="hs-cell hs-b">B</span>
          <span class="hs-cell hs-c">C</span>
          <span class="hs-cell hs-d">D</span>
          <span class="hs-cell hs-e">E</span>
        </div>
        <p set:html={t.corpus.scaleNote}></p>
      </div>
    </aside>
  </section>

  {/* Living-observatory block — moved UP under the hero/A–E line (Franck 2026-09-07: fill the
      empty space there, and let the strips lead over the big satellite wall). Newly flagged
      PIPELINE projects "en veille" (link to the map; no note here — the band/loupe lives on
      scored fiches) + latest sector news. Both self-hide when empty. */}
  <ProjectsStrip lang={lang} />
  <ActuStrip lang={lang} />

  {/* The corpus seen from space (Franck 2026-07-20) — now BELOW the living strips
      (Franck 2026-09-07: the rotating hero ring + this wall took too much room up top). */}
  <SatelliteWall lang={lang} dcById={dcById} />

  <section class="manifesto" aria-label={t.manifesto.aria}>
    <div class="manifesto-inner">
      <div class="manifesto-shield" aria-hidden="true">✓</div>
      <div>
        <p class="manifesto-motto">{t.whyMotto}</p>
        <p class="manifesto-body">{t.manifesto.line1}</p>
        <p class="manifesto-body"><strong>{t.manifesto.contractLead}</strong> {t.manifesto.contract} <a href="#faq">{t.manifesto.link} →</a></p>
      </div>
    </div>
  </section>

  <section class="why-now" aria-label={t.whyNowAria}>
    <div class="why-now-inner">
      <div class="why-stats">
        {chiffres.map((stat: any) => (
          <div class="stat">
            {/* Final value lives in the HTML (no-JS / SEO / reduced-motion baseline);
                the count-up only replays it once on scroll-in. Sources never animate. */}
            <b><span class="sr-only">{stat.figure}</span><span class="stat-anim" aria-hidden="true">{stat.figure}</span>
              {/litres?|liters?/i.test(stat.figure) && <span class="stat-bar" aria-hidden="true"><i></i></span>}</b>
            {stat.url
              ? <a href={stat.url} {...(stat.url.startsWith("/") ? {} : { target: "_blank", rel: "noopener" })}>{stat.attribution}</a>
              : <span>{stat.attribution}</span>}
          </div>
        ))}
      </div>
      <p class="why-punch" set:html={t.whyNowPunch}></p>
    </div>
  </section>

  <section class="section section-tinted" id="mission" aria-labelledby="mission-title">
    <div class="section-inner">
      <p class="mission-line" id="mission-title">{t.missionLine}</p>
      <div class="mission-grid">
        <div class="why-block">
          <h3>{t.whyTitle}</h3>
          <p class="why-lede">{t.whyLede}</p>
          <p class="why-body" set:html={t.whyBody}></p>
        </div>
        {t.demo && demo && (
          <div class={`score-demo${demoPhoto ? " score-demo-photo" : ""}`}>
            <p class="sr-only">{t.demo.sr.replace("{name}", demo.name)}</p>
            {demoPhoto && (
              <>
                <img class="demo-sat" src={demoPhoto} alt="" loading="lazy" decoding="async" />
                <span class="demo-veil" aria-hidden="true"></span>
              </>
            )}
            <div class="demo-anim" aria-hidden="true">
              <p class="demo-kicker">{t.demo.kicker}</p>
              <div class="demo-body">
                <div class="demo-pillars">
                  {pillarOrder.map((pid: string, i: number) => (
                    <div class="demo-cell demo-pop" style={`--pop-delay:${i * 260}ms`}>
                      <span class="demo-plabel">{t.pillarShort[pid]}</span>
                      <ScoreBadge
                        label={t.pillarShort[pid]}
                        grade={demo.pillars[pid]}
                        confidence={demo.confidence.level}
                        confidenceLabel={t.confidence[demo.confidence.level]}
                        renderConfidence={false}
                        renderLabel={false}
                        size="sm"
                        naLabel={t.insufficient}
                      />
                    </div>
                  ))}
                </div>
                <div class="demo-site">
                  <span class="demo-slabel">{t.siteScore}</span>
                  <span class="demo-score">{demo.grades.site.score.toFixed(1)}/100</span>
                  <span class="demo-bar"><i style={`--demo-score:${demo.grades.site.score / 100}`}></i></span>
                </div>
                <div class="demo-badge">
                  <ScoreBadge
                    label={t.siteScore}
                    grade={demo.grades.site}
                    confidence={demo.confidence.level}
                    confidenceLabel={t.confidence[demo.confidence.level]}
                    renderConfidence={false}
                    renderLabel={false}
                    size="lg"
                    naLabel={t.insufficient}
                  />
                </div>
              </div>
            </div>
            <p class="demo-caption">{t.demo.caption.replace("{name}", demo.name)}
              <button class="demo-replay" type="button">↻ {t.demo.replay}</button></p>
            {demoPhoto && t.demo.why && (
              // Why THIS site: the neutrality rule, stated where it is applied —
              // a front-page pick that hides its rule is an editorial choice in disguise.
              <p class="demo-why">{t.demo.why
                .replace("{place}", demoPlace ?? demo.country)
                .replace("{score}", String(demo.grades.site.score).replace(".", t.formes.decimale))
                .replace("{n}", String(showcase.n_scored))}</p>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="principles-section" aria-labelledby="principles-title">
    <h2 id="principles-title" class="principles-title">{t.principlesTitle}</h2>
    <div class="credibility-strip" aria-label={t.principlesAria}>
      {t.principles.map((p: any) => (
        <div>
          <strong>{p.title}</strong>
          <span>{p.body}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="scores" aria-labelledby="scores-title">
    <div class="section-inner">
      <div class="section-heading">
        <h2 id="scores-title">{t.exploreTitle}</h2>
        <p>{t.exploreSub}</p>
      </div>
      <div class="explore-grid">
        <div class="explore-map">
          <p class="explore-label">{t.exploreMapLabel}</p>
          <MapIsland
            variant="hero"
            labels={{
              site: t.siteScore,
              operator: t.operatorScore,
              confidence: t.confidence,
              insufficient: t.insufficient,
              fixture: t.fixtureTag,
              openMap: t.mapOpen,
              reserved: t.mapReserved,
              ficheBase: ficheBase,
              mapPath: t.chemins.carte,
              viewFiche: t.viewFiche,
              powerUnknown: t.powerUnknown,
            }}
          />
        </div>
        <div class="explore-col">
          <p class="explore-label">{t.exploreRankLabel}</p>
          {rankTeaser.map(({ dc, p }) => (
            <a class="teaser-row" href={`${ficheBase}/${dc.id}/`}>
              <ScoreBadge label={t.siteScore} grade={dc.grades.site} confidence={dc.confidence.level}
                confidenceLabel={t.confidence[dc.confidence.level]} renderConfidence={false} renderLabel={false}
                size="sm" naLabel={t.insufficient} />
              <span class="teaser-name">{dc.name}<small>{dc.country}{dc.power_mw ? ` — ${Math.round(dc.power_mw)} MW` : ""}{dc.grades.site.reserved_from ? ` — ${t.mapReserved.replace("· ", "")}` : ""}</small></span>
              <span class="teaser-pct">P{p}</span>
            </a>
          ))}
          <a class="teaser-more" href={rankPath}>{t.exploreRankMore} →</a>
        </div>
        <div class="explore-col">
          <p class="explore-label">{t.exploreLatestLabel}</p>
          {latest.map((dc: any) => (
            <a class="teaser-row" href={`${ficheBase}/${dc.id}/`}>
              <ScoreBadge label={t.siteScore} grade={dc.grades.site} confidence={dc.confidence.level}
                confidenceLabel={t.confidence[dc.confidence.level]} renderConfidence={false} renderLabel={false}
                size="sm" naLabel={t.insufficient} />
              <span class="teaser-name">{dc.name}<small>{dc.country} — {Math.round(dc.power_mw)} MW</small></span>
            </a>
          ))}
          <a class="teaser-more" href={rankPath}>{t.exploreLatestMore} →</a>
        </div>
      </div>
      <form class="explore-search" action={rankPath} method="get" role="search">
        <input type="search" name="q" placeholder={t.searchPlaceholder} aria-label={t.searchPlaceholder} />
      </form>
    </div>
  </section>

  <section class="section" id="indices" aria-labelledby="indices-title">
    <div class="section-inner">
      <div class="section-heading">
        <h2 id="indices-title">{t.indices.h2}</h2>
        <p>{t.indices.lead}</p>
      </div>
      <div class="home-idx-rows">
        {idxTop5.map(([iso, e]) => (
            <a class="home-idx-row" href={`${t.chemins.indicesPays}${iso}`}>
              <span class={`idx-chip idx-g${e.grade}`}>{e.grade}</span>
              <span class="home-idx-name">{countryFlag(iso)} {(COUNTRY_NAMES as any)[iso]?.[lang] ?? iso}
                <small>{e.reserved_from === "A" ? t.indices.reserve : ""}n = {e.n} · doc {e.documentation.band}</small>
              </span>
              <span class="home-idx-score">{String(e.score).replace(".", t.formes.decimale)}</span>
            </a>
        ))}
      </div>
      <p><a class="teaser-more" href={t.chemins.indices}>{t.indices.plus.replace("{n}", String(idxTotal))} →</a></p>
    </div>
  </section>

  <section class="section section-tinted" id="matters" aria-labelledby="matters-title">
    <div class="section-inner">
      <div class="section-heading">
        <h2 id="matters-title">{t.mattersTitle}</h2>
        <p>{t.mattersSub}</p>
      </div>
      <div class="matters-grid">
        {t.matters.map((m: any) => (
          <div class="matters-card">
            <span class="matters-ic" aria-hidden="true"><PillarIcon name={m.icon} size={20} /></span>
            <h3>{m.title}</h3>
            {/* `{mesures}` est le dénominateur de l'EAU : les sites où le stress hydrique est
                mesuré, pas le corpus entier. Rapporter une mesure à des fiches qui ne la
                portent pas diluerait le constat d'autant. `{total}` reste le corpus, qui est
                bien le bon dénominateur pour la puissance non communiquée. */}
            <p set:html={m.body
              .replace("{stress}", String(stressCount))
              .replace("{mesures}", String(stressBase))
              .replace("{total}", String(real.length))
              .replace("{noPower}", String(noPowerCount))}></p>
            <a href={m.href}>{m.link} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tinted" id="method" aria-labelledby="method-title">
    <div class="section-inner method-layout">
      <div class="method-copy">
        <h2 id="method-title">{t.methodTitle}</h2>
        <p class="prose" set:html={t.methodLede}></p>
        <ul class="dual-explain">
          <li>
            <strong>{t.siteScore}</strong>
            <span set:html={t.siteScoreExplain}></span>
          </li>
          <li>
            <strong>{t.operatorScore}</strong>
            <span set:html={t.operatorScoreExplain}></span>
          </li>
          <li>
            <strong>{t.confidenceTitle}</strong>
            <span>{t.confidenceExplain}</span>
          </li>
        </ul>
        {t.methodPedago && <a class="method-pedago" href={t.chemins.methodologie}>{t.methodPedago} →</a>}
      </div>
