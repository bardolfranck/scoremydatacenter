            <p set:html={item.a}></p>
          </details>
        ))}
      </div>
    </div>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: t.faq.map((item: any) => ({
          "@type": "Question",
          name: item.q.replace(/<[^>]+>/g, ""),
