const rc = (REPORT_COPY[report] ?? REPORT_COPY["big-tech"])[lang];
const t = { ...COMMON[lang], ...rc };
---

<Base
  lang={lang}
  title={t.title}
  description={t.metaDescription}
  tagline={t.tagline}
  altHref={altHref}
  altLabel={altLabel}
  nav={nav}
>
  <section class="section rd-section" aria-labelledby="rd-title">
    <div class="section-inner rd-grid">
      <!-- Left: the pitch + cover -->
      <div class="rd-pitch">
        <p class="hero-eyebrow">{t.kicker}</p>
        <h1 id="rd-title" class="rd-title">{t.h1}</h1>
        <p class="rd-lead">{t.lead}</p>

        <!-- The scoop: free, citable, on-page (SEO + press). The single number
             that makes the report worth reading. -->
        <figure class="rd-scoop">
          <figcaption class="rd-scoop-label">{t.scoopLabel}</figcaption>
          <blockquote set:html={t.scoop}></blockquote>
        </figure>

        <div class="rd-cover" aria-hidden="true">
          <span class="rd-cover-kicker">{t.coverKicker}</span>
          <span class="rd-cover-title">{t.coverTitle}</span>
          <span class="rd-cover-sub">{t.coverSub}</span>
          <span class="rd-cover-scale">
            <i class="s-a">A</i><i class="s-b">B</i><i class="s-c">C</i><i class="s-d">D</i><i class="s-e">E</i>
          </span>
        </div>

        <h2 class="rd-inside-title">{t.insideTitle}</h2>
        <ul class="rd-inside">
          {t.inside.map((li) => <li set:html={li} />)}
        </ul>

        <!-- Free, un-gated preview (pages 1-2). The best advertising circulates
             with no friction; the gate is only for the full report. -->
        <a class="button button-secondary rd-teaser" href={teaserHref} download>
          <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
            <path d="M10 3v9m0 0 3.2-3.2M10 12 6.8 8.8M4 15.5h12" fill="none"
                  stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{t.teaserBtn}</span>
        </a>
        <p class="rd-teaser-sub">{t.teaserSub}</p>
        <p class="rd-cliff">{t.cliff}</p>
      </div>

      <!-- Right: the email gate -->
      <div class="rd-form-col">
        <div class="rd-card">
          <h2 class="rd-form-title">{t.formTitle}</h2>
          <p class="rd-form-lead">{t.formLead}</p>

          <form class="rd-form" data-report-form data-report={report} data-lang={lang} novalidate>
            <label class="rd-label">
              <span>{t.emailLabel}</span>
              <input type="email" name="email" inputmode="email" autocomplete="email"
                     placeholder={t.emailPlaceholder} required />
            </label>

            <label class="rd-consent">
              <input type="checkbox" name="consent" required />
              <span>{t.consentLabel}</span>
            </label>

            <!-- honeypot: real visitors never fill this -->
            <input type="text" name="company" class="rd-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <button class="button button-primary rd-submit" type="submit">{t.submit}</button>
            <p class="rd-free">{t.freeNote}</p>

            <p class="rd-err" data-err-email hidden>{t.errEmail}</p>
            <p class="rd-err" data-err-consent hidden>{t.errConsent}</p>
            <p class="rd-err" data-err-generic hidden set:html={t.errGeneric}></p>

            <p class="rd-cnil" set:html={t.cnil}></p>
          </form>

          <div class="rd-sent" data-sent hidden>
            <p class="rd-sent-title">{t.sentTitle}</p>
            <p class="rd-sent-body">{t.sentBody}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The "silent salesperson": year-1 reports are free credibility tools; the
       revenue path is bespoke work. Every report page nudges toward it. -->
  <section class="section rd-svc-section" aria-labelledby="rd-svc-title">
    <div class="section-inner">
      <div class="rd-svc">
        <div class="rd-svc-text">
          <p class="hero-eyebrow">{t.svcKicker}</p>
          <h2 id="rd-svc-title" class="rd-svc-title">{t.svcTitle}</h2>
          <p class="rd-svc-body">{t.svcBody}</p>
          <ul class="rd-svc-items">
            {t.svcItems.map((li) => <li>{li}</li>)}
          </ul>
        </div>
        <div class="rd-svc-cta">
          <a class="button button-primary"
             href={`mailto:contact@scoremydatacenter.org?subject=${encodeURIComponent(t.svcSubject)}`}>
            {t.svcCta}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script
  define:vars={{ sendingLabel: t.sending, submitLabel: t.submit }}
  is:inline
>
  (function () {
    var form = document.querySelector("form[data-report-form]");
    if (!form) return;
    var card = form.closest(".rd-card");
    var btn = form.querySelector(".rd-submit");
    var errEmail = form.querySelector("[data-err-email]");
    var errConsent = form.querySelector("[data-err-consent]");
    var errGeneric = form.querySelector("[data-err-generic]");
    var sent = card.querySelector("[data-sent]");
    // A light client check only trims obvious junk; the Function re-validates
    // (format + MX) server-side — the browser is never the gatekeeper.
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function hide(el) { if (el) el.hidden = true; }

    form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      hide(errEmail); hide(errConsent); hide(errGeneric);

      if (form.company.value) return; // honeypot tripped → silently ignore (bot)

      var email = (form.email.value || "").trim();
      if (!EMAIL_RE.test(email)) { errEmail.hidden = false; form.email.focus(); return; }
      if (!form.consent.checked) { errConsent.hidden = false; return; }

      btn.disabled = true;
      btn.textContent = sendingLabel;

      fetch("/api/report/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: email,
          consent: true,
          report: form.getAttribute("data-report"),
          lang: form.getAttribute("data-lang"),
        }),
      })
        .then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }); })
        .then(function (data) {
          if (data && data.ok) {
            form.hidden = true;
            sent.hidden = false;
            card.classList.add("is-sent");
          } else {
            errGeneric.hidden = false;
            btn.disabled = false;
            btn.textContent = submitLabel;
          }
        })
        .catch(function () {
          errGeneric.hidden = false;
          btn.disabled = false;
          btn.textContent = submitLabel;
        });
    });
  })();
</script>

<style>
  .rd-section { padding-block: clamp(2rem, 5vw, 4rem); }
  .rd-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 860px) {
    .rd-grid { grid-template-columns: 1fr; }
  }

  .rd-title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0.35em 0 0.35em;
  }
  .rd-lead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-soft, #4a5568);
    max-width: 34ch;
  }

  /* The scoop callout — the one citable number */
  .rd-scoop {
    margin: 1.4rem 0 0; padding: 1rem 1.2rem;
    border-radius: 12px;
    background: #f2f6ff; border: 1px solid #d6e2ff;
  }
  .rd-scoop-label {
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: #2f6fed; font-weight: 700; margin-bottom: 0.35rem;
  }
  .rd-scoop blockquote {
    margin: 0; font-size: clamp(1.05rem, 1.7vw, 1.25rem); line-height: 1.4;
    color: var(--ink, #2d3748);
  }
  @media (prefers-color-scheme: dark) {
    .rd-scoop { background: #16213a; border-color: #2b3f66; }
    .rd-scoop blockquote { color: #e8edf5; }
  }

  /* CSS "cover" — no image asset, so we render a document-like card */
  .rd-cover {
    margin: 1.75rem 0 2rem;
    width: min(320px, 90%);
    aspect-ratio: 3 / 4;
    border-radius: 14px;
    padding: 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: #fff;
    background:
      radial-gradient(120% 90% at 15% 10%, #1e3a5f 0%, #16233a 55%, #0e1626 100%);
    box-shadow: 0 20px 45px -20px rgba(14, 22, 38, 0.7);
    position: relative;
    overflow: hidden;
  }
  .rd-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 78% 78%, rgba(255,255,255,0.10) 0, rgba(255,255,255,0) 42%);
    pointer-events: none;
  }
  .rd-cover-kicker {
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(255,255,255,0.62);
  }
  .rd-cover-title {
    font-size: 2.6rem; font-weight: 800; line-height: 0.98; letter-spacing: -0.02em;
    margin-top: auto;
  }
  .rd-cover-sub { font-size: 0.98rem; color: rgba(255,255,255,0.8); line-height: 1.3; }
  .rd-cover-scale { display: flex; gap: 5px; margin-top: 0.9rem; }
  .rd-cover-scale i {
    width: 26px; height: 26px; border-radius: 6px;
    display: grid; place-items: center;
    font-style: normal; font-weight: 700; font-size: 0.8rem; color: #0e1626;
  }
  .rd-cover-scale .s-a { background: #2f9e69; color: #fff; }
  .rd-cover-scale .s-b { background: #8ac14b; }
  .rd-cover-scale .s-c { background: #f2c14e; }
  .rd-cover-scale .s-d { background: #e08a3c; }
  .rd-cover-scale .s-e { background: #d1495b; color: #fff; }

  .rd-inside-title { font-size: 1.15rem; margin: 0 0 0.6rem; }
  .rd-inside {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 0.6rem;
  }
  .rd-inside li {
    position: relative; padding-left: 1.6rem; line-height: 1.45;
    color: var(--ink-soft, #4a5568);
  }
  .rd-inside li::before {
    content: "✓"; position: absolute; left: 0; top: 0;
    color: #2f9e69; font-weight: 800;
  }

  /* Free preview download (un-gated) */
  .rd-teaser {
    display: inline-flex; align-items: center; gap: 0.5rem;
    margin-top: 1.6rem;
  }
  .rd-teaser svg { flex: none; }
  .rd-teaser-sub {
    margin: 0.45rem 0 0; font-size: 0.82rem; color: var(--ink-soft, #718096);
  }
