//
// Email-gated report download (lead magnet). The visitor gives an email to get
// a free report; we DON'T hand the PDF over immediately — double opt-in: the
// email must be confirmed by clicking a link we mail. That keeps the list real
// (no "vatefairecuire@…" garbage) and CNIL-clean (explicit consent, stated
// purpose, one-click unsubscribe). Backend = the Pages Function /api/report/*,
// the address store = D1 (Franck's own exportable table). Sending = Resend
// (from no-reply@send.scoremydatacenter.org, reply-to contact@…). Honeypot for
// bots; no cookie, no tracker on this page.
import Base from "../layouts/Base.astro";
import type { NavNode } from "../config/nav";

interface Props {
  lang: "en" | "fr";
  nav: NavNode[];
  altHref: string;
  altLabel: string;
  report?: string; // report slug the Function keys on (default "big-tech")
}
const { lang, nav, altHref, altLabel, report = "big-tech" } = Astro.props;

// Pages 1-2 are the free, un-gated teaser (Franck 2026-07-28): never a gate
// before page 1 — the first pages are the best advertising, they must circulate
// freely (press citing, Google indexing). Served as a small static PDF from
// public/reports/teasers/ (no email, no Function). The FULL report is gated.
const teaserHref = `/reports/teasers/${report}-${lang}-2P.pdf`;

// Copy shared by every report (all "vous" — the site's register). Report-
// specific copy lives in REPORT_COPY and is merged over this.
const COMMON = {
