---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
//
// « Documents officiels » (2026-11-20) : pour chaque fait attesté, le lien vers l'autorité qui
// l'a publié et sa date — rien d'autre. « On ouvre la vérité, on vend le temps » (Franck) :
// pas de copie archivée, pas d'extraction, pas de chronologie. Hors note, comme tout ce qui se
// lit À CÔTÉ de la lettre. `authority` et `reference` sont des DONNÉES, servies telles que
// l'autorité les écrit (jamais traduites). L'ordre (plus récent d'abord) vient de l'artefact.
import { DOCUMENTS_OFFICIELS } from "../content/documents-officiels";
import { donnee, type LangueDeclaree } from "../content/langues";

// « Même adresse, autre activité » (Franck 2026-11-24) : sous-rubrique, après les actes sur le
// site. Chaque acte porte son libellé de contexte (`activity`) : ce qu'il vise À LA PLACE du
// data center. Jamais de « atteste : » ici — ces actes ne prouvent rien du data center.
const { documents = [], memeAdresse = [], lang = "fr" } = Astro.props;
const t = DOCUMENTS_OFFICIELS[lang as LangueDeclaree];
const fmt = (iso: string) => {
  const [a, m, j] = String(iso).split("-");
  return t.datePattern.replace("{a}", a).replace("{m}", m).replace("{j}", j);
};
// Date de l'ACTE au mois ou à l'année (2026-11-24, OFEN 12665) : « avril 2026 », jamais un jour
// inventé. Le 01 de `date` n'est qu'un marqueur (schéma, date_precision).
const fmtActe = (d: any) =>
  d.date_precision === "year" ? String(d.date).slice(0, 4)
  : d.date_precision === "month"
    ? new Intl.DateTimeFormat(t.locale, { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${d.date}T00:00:00Z`))
    : fmt(d.date);
const types: Record<string, string> = t.types;
const faits: Record<string, string> = t.supports;
const libelleType = (k: string) => types[k] ?? k;
const libelleFaits = (l: string[]) => l.map((k) => faits[k] ?? k).join(", ");
const etapes: Record<string, string> = t.siteEvents;
---
{(documents.length > 0 || memeAdresse.length > 0) && (
  <section class="fiche-docs" aria-labelledby="docs-title">
    <h2 id="docs-title" class="fiche-docs-kicker">{t.titre}</h2>
    {documents.length > 0 && <p class="fiche-docs-intro">{t.intro}</p>}
    {documents.length > 0 && (
    <ul class="fiche-docs-list">
      {documents.map((d: any) => (
        <li>
          {d.link_unavailable_since ? (
            <span class="fiche-docs-mort">{libelleType(d.type)}</span>
          ) : (
            <a href={d.url} target="_blank" rel="noopener" title={t.verifie.replace("{date}", fmt(d.accessed))}>
              {libelleType(d.type)}</a>
          )}
          <span class="fiche-docs-date">{fmtActe(d)}</span>
          <span class="fiche-docs-auth">{/* i18n:donnee */ d.authority}{d.reference ? /* i18n:donnee */ ` · ${t.reference} ${d.reference}` : ""}</span>
          {d.accessible_from && !d.link_unavailable_since && (
            <span class="fiche-docs-geo">{t.accessibleDepuis.replace("{pays}", t.paysAcces[d.accessible_from] ?? d.accessible_from)}</span>
          )}
          {d.link_unavailable_since && (
            <span class="fiche-docs-indispo">{t.indisponible.replace("{date}", fmt(d.link_unavailable_since))}</span>
          )}
          {d.supports?.length > 0 && (
            <span class="fiche-docs-sup">{`${t.atteste} ${libelleFaits(d.supports)}`}</span>
          )}
        </li>
      ))}
    </ul>
    )}
    {memeAdresse.length > 0 && (
      <div class="fiche-docs-sous">
        <h3 class="fiche-docs-sous-titre">{t.memeAdresse.titre}</h3>
        <p class="fiche-docs-intro">{t.memeAdresse.intro}</p>
        <ul class="fiche-docs-list">
          {memeAdresse.map((d: any) => (
            <li>
              {d.link_unavailable_since ? (
                <span class="fiche-docs-mort">{libelleType(d.type)}</span>
              ) : (
                <a href={d.url} target="_blank" rel="noopener" title={t.verifie.replace("{date}", fmt(d.accessed))}>
                  {libelleType(d.type)}</a>
              )}
              <span class="fiche-docs-date">{fmtActe(d)}</span>
              <span class="fiche-docs-auth">{/* i18n:donnee */ d.authority}{d.reference ? /* i18n:donnee */ ` · ${t.reference} ${d.reference}` : ""}</span>
              {d.accessible_from && !d.link_unavailable_since && (
                <span class="fiche-docs-geo">{t.accessibleDepuis.replace("{pays}", t.paysAcces[d.accessible_from] ?? d.accessible_from)}</span>
              )}
              {d.link_unavailable_since && (
                <span class="fiche-docs-indispo">{t.indisponible.replace("{date}", fmt(d.link_unavailable_since))}</span>
              )}
              <span class="fiche-docs-sup">{`${t.vise} ${donnee(d.activity, lang)} · ${t.etape} ${etapes[d.site_event] ?? d.site_event}`}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
)}
