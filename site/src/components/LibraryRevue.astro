---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// « La Revue » — the Intelligence Library LANDING (brief COWORK 2026-07-14),
// shared FR/EN (i18n §13: one template, per-language t objects).
//
// MOCKUP ONLY: every title/hook is lorem-Latin, every figure is tagged as a
// fictional example. Register = prestige periodical (nameplate, hairlines,
// numbered summary) carried by FORM — type, rules, layout — never by a foreign
// tint. The free/paid boundary is stated in the masthead band and repeated on
// every card. Purchase CTA is "order — contact us": no checkout exists.
import Base from "../layouts/Base.astro";
import LibraryCard from "./LibraryCard.astro";
import FeedbackBand from "./FeedbackBand.astro";
import PillarIcon from "./PillarIcon.astro";
import {
  COMING_SOON_COUNTRIES, COUNTRY_BRIEFS, COUNTRY_FLAGS, FLAGSHIP, LANG_FLAGS,
  THEME_BRIEFS, briefLanguages, coverField, hookText,
} from "../config/library";

const { lang, t } = Astro.props as { lang: "fr" | "en"; t: any };

const contactPath = lang === "fr" ? "/fr/contact" : "/contact";
const flagshipLangs = briefLanguages(FLAGSHIP);
const num = (i: number) => String(i + 1).padStart(2, "0");
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  tagline={t.tagline}
  altHref={t.altHref}
  altLabel={t.altLabel}
  nav={t.nav}
>
  <!-- REAL reports (free, open preview). Above the mockup note so the "maquette"
       label scopes only the placeholder briefs below. -->
  <section class="lib-real" aria-label={lang === "fr" ? "Nos rapports" : "Our reports"}>
    <p class="lib-section-kicker">{lang === "fr" ? "À la une · nos rapports" : "Featured · our reports"}</p>
    <div class="lib-real-grid">
      {(lang === "fr" ? [
        { title: "La France", sub: "L'électricité la plus verte d'Europe, la 12e note. 393 sites.", href: "/fr/rapports/france" },
        { title: "Les Pays-Bas", sub: "Le réseau le plus chargé d'Europe, et les 2 seules notes A. 134 sites.", href: "/fr/rapports/nederland" },
        { title: "Big Tech-AI", sub: "Les géants du cloud et de l'IA à l'épreuve du territoire.", href: "/fr/rapports/big-tech" },
        { title: "Les banques", sub: "Vos données, leur adresse — 10 sites bancaires notés.", href: "/fr/rapports/banques" },
      ] : [
        { title: "France", sub: "Europe's greenest electricity, the 12th grade. 393 sites.", href: "/reports/france" },
        { title: "Netherlands", sub: "Europe's most loaded grid, and its only two A grades. 134 sites.", href: "/reports/nederland" },
        { title: "Big Tech-AI", sub: "The cloud & AI giants against the territory.", href: "/reports/big-tech" },
        { title: "The banks", sub: "Your data, their address — 10 bank sites graded.", href: "/reports/banks" },
      ]).map((r) => (
        <a class="lib-real-card" href={r.href}>
          <span class="lib-real-free">{lang === "fr" ? "Gratuit · aperçu libre" : "Free · open preview"}</span>
          <span class="lib-real-title">{r.title}</span>
          <span class="lib-real-sub">{r.sub}</span>
          <span class="lib-real-cta">{lang === "fr" ? "Lire →" : "Read →"}</span>
        </a>
      ))}
    </div>
  </section>

  <p class="lib-mock-note">{t.mockupNote}</p>

  <!-- Nameplate — periodical masthead, form does the register -->
  <header class="lib-masthead">
    <h1 class="lib-title">{t.nameplateTitle}</h1>
  </header>

  <!-- À la une — the flagship -->
  <section class="lib-featured" aria-label={t.featuredKicker}>
    <p class="lib-section-kicker">{t.featuredKicker}</p>
    <div class="lib-featured-grid">
      <div class="lib-flag-cover" style={`background:${coverField(FLAGSHIP)}`}>
        {/* white wordmark variant of the house logo — the dark tile icon would
            vanish on the navy cover; the grade bars carry the identity */}
        <svg class="lib-flag-cover-logo" viewBox="0 0 448 42" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="ScoreMyDataCenter">
          {/* the house icon, cover variant: white rack + grade bars (no tile — it would vanish on the navy field) */}
          <g transform="translate(0,1)">
            <rect x="0" y="6" width="7" height="19" rx="1.8" fill="#ffffff" opacity="0.85"/>
            <rect x="25" y="6" width="7" height="19" rx="1.8" fill="#ffffff" opacity="0.85"/>
            <rect x="9.5" y="0" width="13" height="25" rx="2.2" fill="#ffffff"/>
            <rect x="12.5" y="4.5" width="7" height="1.8" rx="0.9" fill="#102A43"/>
            <rect x="12.5" y="9.5" width="7" height="1.8" rx="0.9" fill="#102A43"/>
            <rect x="12.5" y="14.5" width="7" height="1.8" rx="0.9" fill="#102A43"/>
            <rect x="12.5" y="19.5" width="7" height="1.8" rx="0.9" fill="#102A43"/>
            <rect x="0" y="28" width="5.4" height="3.8" rx="1.3" fill="#0B7A4B"/>
            <rect x="6.7" y="28" width="5.4" height="3.8" rx="1.3" fill="#6FA032"/>
            <rect x="13.4" y="28" width="5.4" height="3.8" rx="1.3" fill="#DFA918"/>
            <rect x="20.1" y="28" width="5.4" height="3.8" rx="1.3" fill="#CF6A1C"/>
            <rect x="26.8" y="28" width="5.4" height="3.8" rx="1.3" fill="#BF3B21"/>
          </g>
          <text x="44" y="25" font-family="'Avenir Next','Segoe UI',system-ui,sans-serif" font-size="26" font-weight="800" letter-spacing="-0.4" fill="#ffffff">Score<tspan fill="#9fb3c8">My</tspan>DataCenter</text>
          <g><rect x="45" y="33" width="50" height="4.5" rx="1.6" fill="#0B7A4B"/><rect x="98" y="33" width="50" height="4.5" rx="1.6" fill="#6FA032"/><rect x="151" y="33" width="50" height="4.5" rx="1.6" fill="#DFA918"/><rect x="204" y="33" width="50" height="4.5" rx="1.6" fill="#CF6A1C"/><rect x="257" y="33" width="50" height="4.5" rx="1.6" fill="#BF3B21"/></g>
        </svg>
        <p class="lib-flag-cover-title">{FLAGSHIP.title[lang]}</p>
        <p class="lib-flag-cover-year">{FLAGSHIP.date.slice(0, 4)}</p>
        <div class="hero-scale lib-flag-scale" role="img" aria-label={t.scaleAria}>
          <span class="hs-cell hs-a">A</span>
          <span class="hs-cell hs-b">B</span>
          <span class="hs-cell hs-c">C</span>
          <span class="hs-cell hs-d">D</span>
          <span class="hs-cell hs-e">E</span>
        </div>
      </div>
      <div class="lib-flag-copy">
        <h2 class="lib-flag-title">{FLAGSHIP.title[lang]}</h2>
        <p class="lib-flag-hook">{hookText(FLAGSHIP.hook, lang)}</p>
        <dl class="lib-stats">
          {t.flagshipStats.map((s: { value: string; label: string }) => (
            <div class="lib-stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
        <ul class="lib-pillars" aria-label={t.pillarsAria}>
          {t.pillars.map((p: { icon: any; label: string }) => (
            <li><PillarIcon name={p.icon} size={16} /> {p.label}</li>
          ))}
        </ul>
        <p class="lib-fictional">{t.fictionalTag}</p>
        <p class="lib-flag-langs" title={t.langTitle}>
          <span class="lib-langs-label">{t.editionsLabel}</span>
          <span class="lib-langs">
            {flagshipLangs.map((code) => (
              <span class="lib-flag-emoji" role="img" aria-label={code.toUpperCase()}>{LANG_FLAGS[code] ?? code.toUpperCase()}</span>
            ))}
          </span>
        </p>
        <div class="lib-dl" id="telechargement">
          <p class="lib-dl-kicker">{t.dlKicker}</p>
          <div class="lib-dl-row">
            <span class="lib-dl-name">{t.dlDigest}</span>
            <button class="button button-secondary" type="button" disabled title={t.dlSoon}>{t.dlBtn}</button>
          </div>
          <div class="lib-dl-row">
            <span class="lib-dl-name">{t.dlReport}</span>
            <button class="button button-secondary" type="button" disabled title={t.dlSoon}>{t.dlBtn}</button>
          </div>
        </div>
        <p class="lib-operator-note"><a href={contactPath}>{t.operatorNote}</a></p>
      </div>
    </div>
  </section>

  <!-- Au sommaire — numbered summary of the issue -->
  <section class="lib-toc" aria-label={t.tocKicker}>
    <div class="lib-toc-head">
      <p class="lib-section-kicker">{t.tocKicker}</p>
      <p class="lib-toc-note">{t.tocNote}</p>
    </div>
    <p class="lib-toc-group-label">{t.tocThemesLabel}</p>
    <div class="lib-toc-grid">
      {THEME_BRIEFS.map((brief, i) => (
        <LibraryCard
          brief={brief}
          lang={lang}
          num={num(i)}
          familyLabel={t.familyLabels[brief.family]}
          themeLabel={brief.theme ? t.themeLabels[brief.theme] : undefined}
          digestTag={t.digestTag}
          reportLabel={t.dlReport}
          soonLabel={t.dlSoon}
          langTitle={t.langTitle}
        />
      ))}
    </div>
    <p class="lib-toc-group-label">{t.tocCountriesLabel}</p>
    <div class="lib-toc-grid">
      {COUNTRY_BRIEFS.map((brief, i) => (
        <LibraryCard
          brief={brief}
          lang={lang}
          num={num(THEME_BRIEFS.length + i)}
          familyLabel={t.familyLabels[brief.family]}
          digestTag={t.digestTag}
          reportLabel={t.dlReport}
          soonLabel={t.dlSoon}
          fictionalTag={t.fictionalTag}
          langTitle={t.langTitle}
        />
      ))}
    </div>
    <p class="lib-soon">
      <span class="lib-soon-label">{t.comingSoonLabel}</span>
      {COMING_SOON_COUNTRIES.map((code) => (
        <span class="lib-flag-emoji" role="img" aria-label={code.toUpperCase()} title={`${code.toUpperCase()} — ${t.comingSoonWord}`}>{COUNTRY_FLAGS[code]}</span>
      ))}
    </p>
    <!-- Index link greyed: the full catalogue isn't live yet and an active link
         would signal our roadmap (Franck 2026-07-29). Re-enable when it ships. -->
    <p class="lib-index-link lib-index-soon" aria-disabled="true">{t.indexLink}</p>
  </section>

  <!-- Benchmark opérateur — bespoke, on request, confidential register -->
  <section class="lib-bespoke" aria-label={t.bespokeKicker}>
    <p class="lib-section-kicker lib-section-kicker-inverse">{t.bespokeKicker}</p>
    <h2>{t.bespokeTitle}</h2>
    <p class="lib-bespoke-body">{t.bespokeBody}</p>
    <div class="lib-cta-row">
      <a class="button lib-button-inverse" href={contactPath}>{t.bespokeCta}</a>
      <span class="lib-price lib-price-inverse">{t.onRequest}</span>
    </div>
  </section>

  <!-- Digest — the free tier, not a wall -->
  <section class="lib-digest" id="digest" aria-label={t.newsletterTitle}>
    <h2>{t.newsletterTitle}</h2>
    <p class="lib-digest-body">{t.newsletterBody}</p>
    <div class="lib-digest-form">
      <input type="email" inputmode="email" placeholder={t.newsletterPlaceholder} aria-label={t.newsletterPlaceholder} />
      <button type="button" class="button button-primary" title={t.mockupNote}>{t.newsletterCta}</button>
    </div>
    <p class="lib-digest-micro">{t.newsletterMicro}</p>
  </section>

  <p class="lib-footline">{t.footLine}</p>

  <FeedbackBand lang={lang} />
</Base>

<style>
  .lib-real { margin: 0 0 1.6rem; }
  .lib-real-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.6rem;
  }
  @media (max-width: 640px) { .lib-real-grid { grid-template-columns: 1fr; } }
  .lib-real-card {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1.15rem 1.3rem; border-radius: 14px; text-decoration: none;
    color: #fff; background: radial-gradient(130% 130% at 0% 0%, #16233a 0%, #1e3a5f 100%);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .lib-real-card:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -22px rgba(14,22,38,.6); }
  .lib-real-free {
    font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #8ac14b; font-weight: 700;
  }
  .lib-real-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.05; }
  .lib-real-sub { color: rgba(255,255,255,0.82); line-height: 1.4; font-size: 0.95rem; }
  .lib-real-cta { margin-top: 0.3rem; font-weight: 600; color: #fff; }
  .lib-index-soon { color: #9aa4b2; opacity: 0.65; cursor: not-allowed; user-select: none; }
</style>
