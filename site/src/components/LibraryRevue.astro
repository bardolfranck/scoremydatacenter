---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
//
// LA VITRINE DES RAPPORTS — et rien d'autre (Franck, 2026-11-27).
//
// 🔴 CETTE PAGE A SERVI UNE MAQUETTE PENDANT QUATRE MOIS. Du 2026-07-14 au 2026-11-27 elle
// affichait, sous les vrais rapports, une « revue » fictive : un rapport phare, cinq briefs
// thématiques, quatre briefs pays (« Data centers in Gallia — lorem ipsum patria »), des
// prix (500 €, 900 €), des boutons « Rapport complet » qui ne menaient à rien, et une Index
// filtrable du même catalogue. Le titre de la page disait « (maquette) ». Un lecteur y a vu
// du latin et conclu que le site n'était pas fini — et dix rapports annoncés pour trois
// servis. Présenter un rapport, c'est le servir (`config/reportStatus.ts`) : la règle valait
// pour un rapport retiré, elle vaut pour un rapport qui n'a jamais existé.
//
// Ne remettre ici une entrée que lorsque le PDF est en ligne. Une vitrine de ce qui viendra
// est une promesse, et une promesse datée se périme sous les yeux du lecteur.
import Base from "../layouts/Base.astro";
import FeedbackBand from "./FeedbackBand.astro";
import ReportEdition from "./ReportEdition.astro";
import { isWithdrawn } from "../config/reportStatus";

const { lang, t } = Astro.props as { lang: "fr" | "en" | "nl"; t: any };
// La page néerlandaise est hors du périmètre de traduction signé : elle se replie sur le
// français, cartes et ligne d'édition comprises (repli de fiche = français). Avant le
// 2026-11-27 ses cartes sortaient en anglais sous une copie française — deux langues par page.
const copie: "fr" | "en" = lang === "en" ? "en" : "fr";
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  tagline={t.tagline}
  altHref={t.altHref}
  altLabel={t.altLabel}
  nav={t.nav}
>
  <header class="lib-masthead">
    <h1 class="lib-title">{t.nameplateTitle}</h1>
    <p class="lib-lead">{t.lead}</p>
  </header>

  <section class="lib-real" aria-label={t.nameplateTitle}>
    <div class="lib-real-grid">
      {(copie === "fr" ? [
        { title: "La France", sub: "L'électricité la plus verte d'Europe, la 12e note. 393 sites.", href: "/fr/rapports/france/", slug: "france" },
        { title: "Big Tech-AI", sub: "Les géants du cloud et de l'IA à l'épreuve du territoire.", href: "/fr/rapports/big-tech/", slug: "big-tech" },
        { title: "Les banques", sub: "Vos données, leur adresse — 10 sites bancaires notés.", href: "/fr/rapports/banques/", slug: "banques" },
        { title: "Les Pays-Bas", sub: "Le réseau le plus chargé d'Europe. 134 sites.", href: "/fr/rapports/nederland/", slug: "nederland" },
      ] : [
        { title: "France", sub: "Europe's greenest electricity, the 12th grade. 393 sites.", href: "/reports/france/", slug: "france" },
        { title: "Big Tech-AI", sub: "The cloud & AI giants against the territory.", href: "/reports/big-tech/", slug: "big-tech" },
        { title: "The banks", sub: "Your data, their address — 10 bank sites graded.", href: "/reports/banks/", slug: "banques" },
        { title: "Netherlands", sub: "Europe's most loaded grid. 134 sites.", href: "/reports/nederland/", slug: "nederland" },
      ]).map((r) => (
        <a class="lib-real-card" href={r.href}>
          {isWithdrawn(r.slug) ? (
            /* Le rapport est retiré : la vitrine ne doit inviter ni à un téléchargement
               qui n'aura pas lieu, ni à un APERÇU qui n'existe plus. Ce qui est public,
               c'est la note. Dérivé de la table d'état, jamais écrit en dur ici. */
            <span class="lib-real-free lib-real-withdrawn">{t.withdrawnLabel}</span>
          ) : (
            <span class="lib-real-free">{t.freeLabel}</span>
          )}
          <span class="lib-real-title">{r.title}</span>
          <span class="lib-real-sub">{r.sub}</span>
          {!isWithdrawn(r.slug) && <ReportEdition slug={r.slug} lang={copie} compact />}
          <span class="lib-real-cta">{t.readCta}</span>
        </a>
      ))}
    </div>
    <p class="lib-real-note">{t.editionNote}</p>
  </section>

  <p class="lib-footline">{t.footLine}</p>

  <FeedbackBand lang={lang} />
</Base>

<style>
  .lib-real { margin: 0 0 1.6rem; }
  .lib-real-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.6rem;
  }
  @media (max-width: 640px) { .lib-real-grid { grid-template-columns: 1fr; } }
  .lib-real-card {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1.15rem 1.3rem; border-radius: 14px; text-decoration: none;
    color: #fff; background: radial-gradient(130% 130% at 0% 0%, #16233a 0%, #1e3a5f 100%);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .lib-real-card:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -22px rgba(14,22,38,.6); }
  .lib-real-withdrawn { color: #8a5a10; }
  .lib-real-free {
    font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #8ac14b; font-weight: 700;
  }
  .lib-real-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.05; }
  .lib-real-sub { color: rgba(255,255,255,0.82); line-height: 1.4; font-size: 0.95rem; }
  .lib-real-cta { margin-top: 0.3rem; font-weight: 600; color: #fff; }
  .lib-lead { max-width: 46rem; color: #52606d; line-height: 1.5; margin: 0.4rem 0 1.2rem; }
  .lib-real-note { margin: 1rem 0 0; font-size: 0.9rem; color: #52606d; max-width: 46rem; line-height: 1.5; }
</style>
