---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Franck Bardol and contributors — ScoreMyDataCenter
// https://scoremydatacenter.org · independent data center acceptability-risk score
// /fr/indices + /indices — the canonical SITE-index page (brief §2.1):
// OSM basemap (insert welded inside IndicesMap), full table view
// (accessibility), method footer (aggregation, thresholds, A-25 reserve,
// changelog link, operational/announced denominators, §1 bis dating),
// ?pays=XX shareable state. Letters render ONLY through the map component
// and the table chips (gate 7 extended).
import "@fontsource/bricolage-grotesque/700.css";
import type { NavNode } from "../config/nav";
import "@fontsource/bricolage-grotesque/800.css";
import Base from "../layouts/Base.astro";
import IndicesMap from "./IndicesMap.astro";
import indicesData from "../../public/data/indices.json";
import historyData from "../../public/data/indices_history.json";
import { COUNTRY_NAMES, countryFlag } from "../config/indices";

interface Props {
  lang: "fr" | "en";
  nav: NavNode[];
  altHref: string;
  altLabel: string;
}
const { lang, nav, altHref, altLabel } = Astro.props;
const INDICES = indicesData as any;
const HISTORY = historyData as any[];

// COUVERTURE DU COMPARATEUR, pays par pays (Franck 2026-10-02). Deux colonnes de cette page
// disaient déjà ce qu'on sait d'un pays — la documentation médiane et les piliers mesurés.
// Il manquait ce que cette connaissance PERMET : un pays peut être noté et rester trop mince
// pour qu'on y compare quoi que ce soit. Le dire ici, c'est refuser de laisser croire que le
// comparateur couvre uniformément les treize pays — et c'est ce qui tire la collecte.
// PAS un import statique : `site/public/data/` est généré, donc absent d'un clone frais.
// Sans le newsroom monté, `make build` retombe sur `score` (les 2 fixtures) et n'écrit AUCUN
// artefact de comparateur — un `import` direct fait alors échouer la compilation, ce que la
// CI a attrapé (« Could not resolve ../../public/data/comparator/index.json »).
// `import.meta.glob` tolère zéro correspondance : la colonne se vide, le build passe. Même
// idiome que ComparerPage.astro, qui lit les treize pays de la même façon.
//
// Et ce const vit APRÈS les imports, jamais entre eux : le compilateur Astro remonte les
// imports hors du frontmatter, et une déclaration insérée au milieu lui a fait émettre un
// fragment d'instruction (« i is not defined » au rendu, build vert jusqu'à la page).
const cmpGlob = import.meta.glob("../../public/data/comparator/index.json", { eager: true });
const CMP = ((Object.values(cmpGlob)[0] as any)?.default ?? {}) as any;
const cmpByCountry: Record<string, any> = {};
for (const p of CMP.pays ?? []) cmpByCountry[p.pays] = p;
const cmpTooThin: Record<string, number> = {};
for (const m of CMP.corpus_trop_mince ?? []) cmpTooThin[m.pays] = m.sites;

const T = {
  fr: {
    pageTitle: "Indice SITE par pays — ScoreMyDataCenter",
    metaDescription: "L'indice SITE par pays : la moyenne des notes de sites (réseau, eau, foncier, risques) agrégée pays par pays — avec sa documentation, ses seuils et son historique. Il ne note ni les opérateurs ni la conduite des projets.",
    tagline: "Observatoire indépendant",
    lede: "La moyenne équipondérée des notes de SITES publiées, pays par pays — le contexte que les projets subissent (réseau, eau, foncier, risques).",
    tableTitle: "Le classement (vue table)",
    th: { country: "Pays", index: "Indice", score: "Score", n: "n sites", doc: "Documentation", cov: "Ce qu'on a mesuré", cmp: "Comparateur", denom: "En service / annoncés", last: "Dernière évolution" },
    cmp: {
      ouvert: (v: number, n: number) => `jusqu'à ${n} comparables · ${v} variables communes`,
      mince: (n: number) => `corpus trop mince (${n} sites)`,
      absent: "—",
      note: "La colonne « comparateur » dit, pays par pays, jusqu'à combien de sites proches on affiche et sur combien de variables communes le rapprochement repose. Un pays sous le plancher n'a pas de comparateur du tout : c'est un trou de collecte, pas une absence de sites.",
      lien: "Ouvrir le comparateur",
    },
    comparability: {
      title: "Ces pays ne sont pas mesurés sur la même base",
      body: "Nos indicateurs dépendent des sources ouvertes de chaque pays, et elles sont très inégales. La France dispose d'un registre public de capacité du réseau électrique (Caparéseau) : ses sites sont donc notés sur la saturation du raccordement. L'Allemagne, l'Italie, l'Espagne ou la Suisse n'ont pas d'équivalent — cette dimension n'y est pas mesurée du tout. Il en va de même du profil des communes d'accueil, renseigné en France et presque nulle part ailleurs. Dernier ajout, le 30 septembre 2026 : la raccordabilité à un réseau de chaleur, que la France publie et dont aucun autre pays de notre corpus n'a l'équivalent ouvert. C'est notre mesure qui s'étend, pas la note des autres qui baisse — mais la France y devient le seul pays dont le pilier Énergie est mesuré « complet ».",
      consequence: "Conséquence : un pays richement documenté est noté sur ce qu'il révèle, y compris ses points faibles, quand un pays sans données y échappe. Ces indices se lisent donc comme des PROFILS, pas comme un classement — et la colonne « ce qu'on a mesuré » dit, pilier par pilier, sur quelle base chacun est noté.",
      why: "Pourquoi on le publie quand même : la couverture est elle-même une information. Un pilier « absent » ne dit pas qu'un pays va bien, il dit qu'on ne sait pas.",
    },
    covPillars: { energy: "Énergie", water: "Eau", land_biodiversity: "Foncier", local_impact: "Impact local" },
    veilleRow: "en veille — moyenne non calculée",
    reserved: "· A réservé",
    docBands: { solide: "solide", moyenne: "moyenne", faible: "faible" },
    asOf: "Indice au",
    lastEvo: "dernière évolution :",
    method: {
      title: "La méthode de l'indice",
      items: [
        "Agrégation : moyenne équipondérée des scores SITE continus publiés (tous les sites notés entrent dans la moyenne, y compris les sites annoncés — le score site mesure le territoire). L'agrégat pondéré par la puissance (MW) est publié à côté quand un pays communique assez de puissances.",
        "Seuils : A ≥ 80 · B ≥ 65 · C ≥ 50 · D ≥ 35 · E < 35 — la grille des fiches, inchangée.",
        "Réserve A-25 : un indice ≥ 80 s'affiche « B · A réservé » tant qu'aucun site du pays ne porte de vérification tierce en exploitation.",
        "Documentation : médiane des scores de documentation SITE — solide ≥ 0,75 · moyenne ≥ 0,5 · faible. Elle accompagne toujours la note, elle ne filtre jamais.",
        "Plancher : n ≥ 5 sites notés. En dessous, pays « en veille » — une moyenne de 2 n'est pas une moyenne.",
      ],
      changelog: "Méthodologie versionnée →",
    },
    ogTitle: (name: string) => `L'indice site de ${name}`,
  },
  en: {
    pageTitle: "Country SITE index — ScoreMyDataCenter",
    metaDescription: "The country SITE index: the mean of site grades (grid, water, land, hazards) aggregated per country — with its documentation, thresholds and history. It grades neither operators nor how projects are run.",
    tagline: "Independent observatory",
    lede: "The equal-weighted mean of published SITE grades, country by country — the context projects endure (grid, water, land, hazards).",
    tableTitle: "The ranking (table view)",
    th: { country: "Country", index: "Index", score: "Score", n: "n sites", doc: "Documentation", cov: "What we measured", cmp: "Comparator", denom: "Operational / announced", last: "Last change" },
    cmp: {
      ouvert: (v: number, n: number) => `up to ${n} comparables · ${v} shared variables`,
      mince: (n: number) => `corpus too thin (${n} sites)`,
      absent: "—",
      note: "The « comparator » column states, country by country, how many near sites we show at most and how many shared variables the match rests on. A country below the floor has no comparator at all: that is a collection gap, not an absence of sites.",
      lien: "Open the comparator",
    },
    comparability: {
      title: "These countries are not measured on the same basis",
      body: "Our indicators depend on each country's open data, and it is deeply uneven. France publishes a grid hosting-capacity register (Caparéseau), so its sites are graded on connection saturation. Germany, Italy, Spain and Switzerland have no equivalent — that dimension is simply not measured there. The same holds for the profile of host municipalities: recorded in France, almost nowhere else. Latest addition, 30 September 2026: connectability to a district heating network, which France publishes and no other country in our corpus has an open equivalent for. It is our measurement widening, not other countries' grades falling — but France thereby becomes the only country whose Energy pillar is measured « complete ».",
      consequence: "The consequence: a richly documented country is graded on what it discloses, weaknesses included, while a country without data escapes it. These indices therefore read as PROFILES, not as a ranking — and the « what we measured » column states, pillar by pillar, the basis each one is graded on.",
      why: "Why we publish them anyway: coverage is itself information. A pillar marked « none » does not say a country is doing well — it says we do not know.",
    },
    covPillars: { energy: "Energy", water: "Water", land_biodiversity: "Land", local_impact: "Local impact" },
    veilleRow: "on watch — no mean computed",
    reserved: "· A reserved",
    docBands: { solide: "solid", moyenne: "medium", faible: "weak" },
    asOf: "Index as of",
    lastEvo: "last change:",
    method: {
      title: "How this index is computed",
      items: [
        "Aggregation: equal-weighted mean of published continuous SITE scores (every scored site enters the mean, announced sites included — the site score measures the territory). An MW-weighted aggregate is published alongside where a country discloses enough capacities.",
        "Thresholds: A ≥ 80 · B ≥ 65 · C ≥ 50 · D ≥ 35 · E < 35 — the fiche grid, unchanged.",
        "A-25 reserve: an index ≥ 80 displays “B · A reserved” until a site in the country carries third-party operational verification.",
        "Documentation: median of SITE documentation scores — solid ≥ 0.75 · medium ≥ 0.5 · weak. It always ships with the grade, it never filters.",
        "Floor: n ≥ 5 scored sites. Below, the country is “on watch” — a mean of 2 is not a mean.",
      ],
      changelog: "Versioned methodology →",
    },
    ogTitle: (name: string) => `${name}'s site index`,
  },
}[lang];

const dateFmt = (iso: string | null) => {
  if (!iso) return "";
  const [y, m, d] = iso.split("-");
  return lang === "fr" ? `${d}/${m}/${y}` : `${y}-${m}-${d}`;
};

const name = (iso: string) => (COUNTRY_NAMES as any)[iso]?.[lang] ?? iso;
const lastEventByCountry: Record<string, any> = {};
for (const ev of HISTORY) lastEventByCountry[ev.country] = ev;

// PROFILS, PAS PALMARÈS (Franck 2026-09-30). Le tri était par score décroissant, ce qui
// faisait un classement — or les pays ne sont pas notés sur la même base : la France est
// mesurée sur ~88 % de son modèle, l'Allemagne sur ~44 %, la majorité sous la moitié.
// Ordonner par score revenait à publier un palmarès de la COUVERTURE DE DONNÉES en le
// présentant comme un palmarès de performance. L'ordre alphabétique retire cette lecture.
const countries = Object.entries(INDICES.countries as Record<string, any>)
  .sort(([isoA, a], [isoB, b]) => {
    if (a.eligible !== b.eligible) return a.eligible ? -1 : 1;
    return name(isoA).localeCompare(name(isoB), lang);
  });

const COV_LABEL: Record<string, Record<string, string>> = {
  complet: { fr: "complet", en: "full" },
  partiel: { fr: "partiel", en: "partial" },
  mince:   { fr: "mince",   en: "thin" },
  absent:  { fr: "absent",  en: "none" },
};
const COV_PILLARS = ["energy", "water", "land_biodiversity", "local_impact"];

const DOTS: Record<string, string> = { solide: "●●●", moyenne: "●●○", faible: "●○○" };
const fmtScore = (s: number) => (lang === "fr" ? String(s).replace(".", ",") : String(s));
const flag = (iso: string) => countryFlag(iso);
// Page-level OG = the top-ranked eligible country's card (the ranking's own
// headline; per-country cards live at /og/indices/{lang}-{cc}.png for shares).
const topIso = countries.find(([, e]) => e.eligible)?.[0];
const pageOg = topIso ? `https://scoremydatacenter.org/og/indices/${lang}-${topIso.toLowerCase()}.png` : undefined;
const denomTotal = countries.reduce((acc, [, e]) => [acc[0] + (e.n_operational ?? 0), acc[1] + (e.n_announced ?? 0)], [0, 0]);
---

<Base
  lang={lang}
  title={T.pageTitle}
  description={T.metaDescription}
  tagline={T.tagline}
  altHref={altHref}
  altLabel={altLabel}
  nav={nav}
  ogImage={pageOg}
>
  <div class="idx">
    <h1 class="idx-h1">{INDICES.labels.title[lang]}</h1>
    <p class="idx-lede">{T.lede}</p>
    <p class="idx-meta">
      {T.asOf} <b>{dateFmt(INDICES.computed_at)}</b> · {lang === "fr" ? "méthodologie" : "methodology"} <b>v{INDICES.methodology_version}</b>
    </p>

    <IndicesMap lang={lang} />

    <aside class="idx-comparability">
      <p class="idx-cmp-k">{(T as any).comparability.title}</p>
      <p>{(T as any).comparability.body}</p>
      <p>{(T as any).comparability.consequence}</p>
      <p class="idx-cmp-why">{(T as any).comparability.why}</p>
    </aside>

    <h2 class="idx-h2">{T.tableTitle}</h2>
    <div class="idx-tablewrap">
      <table class="idx-table">
        <thead>
          <tr>
            <th>{T.th.country}</th><th>{T.th.index}</th><th>{T.th.score}</th><th>{T.th.n}</th>
            <th>{T.th.doc}</th><th>{(T as any).th.cov}</th><th>{(T as any).th.cmp}</th>
            <th>{T.th.denom}</th><th>{T.th.last}</th>
          </tr>
        </thead>
        <tbody>
          {countries.map(([iso, e]) => {
            const ev = lastEventByCountry[iso];
            return (
              <tr id={`pays-${iso.toLowerCase()}`} class={e.eligible ? "" : "idx-row-veille"} data-cc={iso}>
                <td>{flag(iso)} {name(iso)}</td>
                {e.eligible ? (
                  <>
                    <td><span class={`idx-chip idx-g${e.grade}`}>{e.grade}</span>{e.reserved_from === "A" && <small> {T.reserved}</small>}</td>
                    <td class="idx-num">{fmtScore(e.score)}</td>
                    <td class="idx-num">{e.n}</td>
                    <td>{DOTS[e.documentation.band]} {(T.docBands as any)[e.documentation.band]}</td>
                    <td class="idx-cov">
                      {COV_PILLARS.map((pil) => {
                        const b = e.coverage_by_pillar?.[pil];
                        return b ? (
                          <span class={`idx-cov-chip idx-cov-${b}`}>
                            {(T as any).covPillars[pil]} <i>{COV_LABEL[b][lang]}</i>
                          </span>
                        ) : null;
                      })}
                    </td>
                    <td class="idx-cmp">
                      {cmpByCountry[iso]
                        ? (T as any).cmp.ouvert(cmpByCountry[iso].variables_medianes, cmpByCountry[iso].affiches)
                        : iso in cmpTooThin
                          ? <i class="idx-cmp-mince">{(T as any).cmp.mince(cmpTooThin[iso])}</i>
                          : (T as any).cmp.absent}
                    </td>
                    <td class="idx-num">{e.n_operational} / {e.n_announced}</td>
                    <td class="idx-ev">{ev && `→ ${ev.to.grade ?? "–"} · ${dateFmt(ev.date)}`}</td>
                  </>
                ) : (
                  <>
                    <td colspan="6">{T.veilleRow} (n={e.n})</td>
                    <td></td>
                    <td class="idx-ev">{ev && <>{dateFmt(ev.date)}</>}</td>
                  </>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="idx-denoms">
      {(T as any).cmp.note}{" "}
      {/* GRISÉ, PAS SUPPRIMÉ (Franck 2026-10-02) — le comparateur sort de la navigation mais
          la colonne reste, et sa mention aussi : elle dit ce que la couverture PERMET. Un
          <span> plutôt qu'un <a> désactivé : un lien qu'on neutralise au CSS reste cliquable
          au clavier et reste suivi par un robot d'indexation. Repasser en lien = restaurer la
          balise, le libellé n'a pas bougé. */}
      <span class="idx-cmp-lien-off">{(T as any).cmp.lien}</span>
    </p>
    <p class="idx-denoms">
      {lang === "fr"
        ? `Dénominateurs corpus : ${denomTotal[0]} sites en service · ${denomTotal[1]} sites annoncés entrent dans les moyennes — énoncé, jamais caché.`
        : `Corpus denominators: ${denomTotal[0]} operational · ${denomTotal[1]} announced sites enter the means — stated, never hidden.`}
    </p>

    <div class="idx-method">
      <h2 class="idx-h2">{T.method.title}</h2>
      <ul>
        {T.method.items.map((item) => <li>{item}</li>)}
      </ul>
      <a class="idx-cta" href={lang === "fr" ? "/fr/methodologie" : "/methodology"}>{T.method.changelog}</a>
    </div>
  </div>

  <script is:inline>
    // ?pays=XX — shareable per-country state: highlight on map + table. The
    // map markers mount asynchronously (MapLibre module script), so clicks go
    // through delegation and the initial highlight replays on the component's
    // "markers ready" signal.
    (function () {
      function apply(cc, scroll) {
        if (!cc) return;
        cc = cc.toUpperCase();
        document.querySelectorAll("[data-indices-map] [data-cc]").forEach(function (p) {
          p.classList.toggle("idx-focus", p.getAttribute("data-cc") === cc);
          p.classList.toggle("idx-dim", p.getAttribute("data-cc") !== cc);
        });
        var row = document.getElementById("pays-" + cc.toLowerCase());
        if (row) {
          document.querySelectorAll(".idx-row-focus").forEach(function (r) { r.classList.remove("idx-row-focus"); });
          row.classList.add("idx-row-focus");
          if (scroll) row.scrollIntoView({ block: "center", behavior: "smooth" });
        }
      }
      function fromUrl(scroll) {
        apply(new URLSearchParams(window.location.search).get("pays"), scroll);
      }
      fromUrl(true);
      document.addEventListener("smdc:idx-markers", function () { fromUrl(false); });
      document.addEventListener("click", function (e) {
        var mk = e.target.closest && e.target.closest("[data-indices-map] [data-cc]");
        if (!mk) return;
        var cc = mk.getAttribute("data-cc");
        history.replaceState(null, "", "?pays=" + cc);
        apply(cc, true);
      });
    })();
  </script>
</Base>
