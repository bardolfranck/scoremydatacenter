    weightWord: "poids", subnote: "sous-note", auditVerb: "Auditer", foldVerb: "Replier",
    indHead: "indicateurs", combined: "Combinés", arrowTo: "sous-note",
    youMove: "(à vous)",
    s3h: "Étage 2 — les piliers font la note du site",
    s3sub: "Les cinq sous-notes, chacune à son poids, se combinent en un score global — et en une lettre.",
    contribCap: "contribution de chaque pilier",
    finalLabel: "La note du site", scoreWord: "score global",
    philo: "La lettre est la note publiée ; le score la sous-tend.",
    hudLabel: "Note du site", hudScore: "score", hudHint: "bougez le curseur ↑",
    closeK: "Ce qu'on ne montre pas ici",
    closeH: "Voilà l'intuition. Le vrai calcul va plus loin.",
    closeP: "Un pilier faible pèse mais ne détruit pas. Il ne fait pas tout. Sous le capot, la méthode ajoute :",
    closeItems: ["Deux notes : site (subi) & projet (choisi)", "Couverture minimale d'indicateurs", "Niveau de confiance par note", "Plafonnement « annoncé ≤ prouvé »"],
    cta: "Lire la méthode complète →", ctaHref: "/fr/methodologie",
    foot: "Illustration pédagogique · chiffres volontairement simples sur une fixture <span class=\"mono\">zz-demo</span>. Les vrais seuils sont dans la méthode.",
    satWords: ["capacité libre", "marge correcte", "poste sous tension", "poste saturé"],
  },
  en: {
    eyebrow: "Method · illustration",
    h1: "A grade, step by step",
    dek: "How a data center's facts become a letter, from A to E. A grade is built in <b>two stages</b>: indicators make each pillar, pillars make the grade. <b>Expand a pillar</b> to audit its score.",
    honest: "<b>This is an illustration.</b> It shows the <b>intuition</b> of the calculation — the path from data to a letter — not its depths. The exact thresholds, the confidence level and the “announced ≤ proven” cap live in the <a href=\"/methodology\">full method</a>. The goal: <b>understand, not reproduce</b>. The numbers are deliberately simple.",
    storeys: ["indicators", "pillars", "grade A–E"],
    storeysTail: " — <b>two aggregations</b>, one stacked on the other.",
    s1h: "The example site", s1sub: "A fictional data center — the raw material of the calculation.",
    toyName: "Example Data Center",
    facts: ["grid · <b>under strain</b>", "carbon · <b>80 g/kWh</b>", "cooling · <b>water-cooled</b>", "land · <b>already built</b>", "protected area · <b>8 km</b>"],
    s2h: "Stage 1 — indicators make each pillar",
    s2sub: "Each pillar aggregates its indicators. We expand <b>just one</b> — Energy, the heaviest — to watch its score being built. <b>The principle is the same for all five</b>: expand them if you like.",
    play: "▶ The only lever on this page — move the saturation, watch the indicator, then the pillar drop, then the site grade (bar below) react.",
    sliderLabel: "Grid saturation",
    ends: ["free capacity", "saturated →"],
    weightWord: "weight", subnote: "sub-score", auditVerb: "Audit", foldVerb: "Collapse",
    indHead: "indicators", combined: "Combined", arrowTo: "sub-score",
    youMove: "(you)",
    s3h: "Stage 2 — pillars make the site grade",
    s3sub: "The five sub-scores, each at its weight, combine into a global score — and a letter.",
    contribCap: "each pillar's contribution",
    finalLabel: "The site grade", scoreWord: "global score",
    philo: "The letter is the published grade; the score underpins it.",
    hudLabel: "Site grade", hudScore: "score", hudHint: "move the slider ↑",
    closeK: "What we don't show here",
    closeH: "That's the intuition. The real calculation goes further.",
    closeP: "A weak pillar weighs but doesn't destroy. It isn't everything. Under the hood, the method adds:",
    closeItems: ["Two grades: site (endured) & project (chosen)", "Minimum indicator coverage", "A confidence level per grade", "The “announced ≤ proven” cap"],
    cta: "Read the full method →", ctaHref: "/methodology",
    foot: "Pedagogical illustration · deliberately simple numbers on a <span class=\"mono\">zz-demo</span> fixture. The real thresholds are in the method.",
    satWords: ["free capacity", "some margin", "under strain", "saturated"],
  },
};
const t = T[lang];
const L = (o: { fr: string; en: string }) => o[lang];
---

<section class="mw">
  <p class="mw-eyebrow">{t.eyebrow}</p>
  <h1 class="mw-h1">{t.h1}</h1>
  <p class="mw-dek" set:html={t.dek}></p>

  <div class="mw-honest"><span class="mw-mark" aria-hidden="true">i</span><p set:html={t.honest}></p></div>

  <div class="mw-storeys">
    <span class="mw-k">{t.storeys[0]}</span><span class="mw-ar">→</span><span class="mw-k">{t.storeys[1]}</span><span class="mw-ar">→</span><span class="mw-k">{t.storeys[2]}</span><span set:html={t.storeysTail}></span>
  </div>

  <!-- STEP 1 -->
  <div class="mw-step" data-n="1">
    <h2>{t.s1h}</h2><p class="mw-sub">{t.s1sub}</p>
    <div class="mw-toy">
      <div class="mw-toy-h"><strong>{t.toyName}</strong><span class="mw-id">fixture zz-demo</span></div>
      <div class="mw-facts">{t.facts.map((f) => <span class="mw-fact" set:html={f} />)}</div>
    </div>
  </div>

  <!-- STEP 2 -->
  <div class="mw-step" data-n="2">
    <h2>{t.s2h}</h2><p class="mw-sub" set:html={t.s2sub}></p>
    {PILLARS.map((p) => (
      <details class="mw-pcard" open={p.open} data-pid={p.id}>
        <summary class="mw-sum">
          <span class="mw-nm">{L(p.label)}</span>
          <span class="mw-w">{t.weightWord} {p.weight} %</span>
          <span class="mw-pnote">{t.subnote} <b class="mw-psub" data-pid={p.id}>{p.sub}</b> · <span class={`mw-chip g-${p.grade}`} data-pchip={p.id}>{p.grade.toUpperCase()}</span></span>
          <span class="mw-toggle" data-audit={t.auditVerb} data-fold={t.foldVerb}></span>
        </summary>
        <div class="mw-audit">
          {p.indicators.some((i) => i.live) && (
            <div class="mw-sliderbox">
              <p class="mw-play">{t.play}</p>
              <label><span>{t.sliderLabel}</span><span class="mw-hint" data-satlabel></span></label>
              <input type="range" id="mw-sat" min="0" max="100" value="60" aria-label={t.sliderLabel} />
              <div class="mw-ends"><span>{t.ends[0]}</span><span>{t.ends[1]}</span></div>
            </div>
          )}
          <div class="mw-audit-cap">{p.indicators.length} {t.indHead}</div>
          {p.indicators.map((i) => (
            <div class="mw-ind">
              <span class="mw-il"><span class="mw-iid">{i.id}</span> {L(i.label)}{i.val ? <> · <b>{L(i.val)}</b></> : null}{i.live ? <em> {t.youMove}</em> : null}</span>
              <span class="mw-iw">{i.w}</span>
              <span class="mw-inote">
                <span class="mw-minibar"><span data-mb={i.live ? "live" : ""} style={i.live ? "" : `width:${i.note}%;background:var(--grade-${i.note >= 80 ? "a" : i.note >= 65 ? "b" : i.note >= 50 ? "c" : i.note >= 35 ? "d" : "e"})`}></span></span>
                <span class="mw-nnum" data-nn={i.live ? "live" : ""}>{i.live ? 40 : i.note}</span>
              </span>
            </div>
          ))}
          <div class="mw-combine"><span class="mw-clbl"><b>{t.combined}</b></span><span class="mw-out">⇒ {t.arrowTo} {L(p.label)} <b class="mw-vsub" data-pid={p.id}>{p.sub}</b>/100 · <span class={`mw-chip g-${p.grade}`} data-pchip2={p.id}>{p.grade.toUpperCase()}</span></span></div>
        </div>
      </details>
    ))}
  </div>

  <!-- STEP 3 -->
  <div class="mw-step" data-n="3">
    <h2>{t.s3h}</h2><p class="mw-sub">{t.s3sub}</p>
    <div class="mw-agg">
      <div class="mw-agg-rows">
        <div class="mw-agg-cap">{t.contribCap}</div>
        {PILLARS.map((p) => (
          <div class="mw-agg-line"><span class="mw-anm">{L(p.label)} <span>×{p.weight} %</span></span><span class="mw-agg-bar"><span data-aggbar={p.id} style={p.open ? "" : `width:${p.sub}%;background:var(--grade-${p.grade})`}></span></span><span class="mw-an" data-aggn={p.id}>{p.sub}</span></div>
        ))}
      </div>
      <div class="mw-final">
        <div class="mw-glabel">{t.finalLabel}</div>
        <div class="mw-big g-c" data-final-chip>C</div>
        <div class="mw-score">{t.scoreWord} <b data-final-score>53</b>/100</div>
        <div class="mw-philo">{t.philo}</div>
      </div>
    </div>
  </div>

  <div class="mw-close">
    <p class="mw-ck">{t.closeK}</p>
    <h3>{t.closeH}</h3>
    <p>{t.closeP}</p>
    <ul>{t.closeItems.map((i) => <li>{i}</li>)}</ul>
    <a class="mw-cta" href={t.ctaHref}>{t.cta}</a>
  </div>

  <p class="mw-foot" set:html={t.foot}></p>
</section>

<div class="mw-hud" role="status">
  <div class="mw-hud-in">
    <span class="mw-hud-label">{t.hudLabel}</span>
    <span class="mw-hud-chip g-c" data-hud-chip>C</span>
    <span class="mw-hud-score">{t.hudScore} <b data-hud-score>53</b>/100</span>
    <span class="mw-hud-hint">{t.hudHint}</span>
  </div>
</div>

<script define:vars={{ satWords: t.satWords }}>
  (function () {
    const sat = document.getElementById("mw-sat");
    if (!sat) return;
    const q = (s) => document.querySelector(s);
    const qa = (s) => Array.from(document.querySelectorAll(s));
    function letter(v){ return v>=80?"a":v>=65?"b":v>=50?"c":v>=35?"d":"e"; }
    function gvar(v){ return "var(--grade-"+letter(v)+")"; }
    function setChip(node,l){ if(node) node.className=node.className.replace(/g-[a-e]/,"g-"+l); if(node) node.textContent=l.toUpperCase(); }

    // fixed pillar sub-scores + real weights (energy is live)
    const FIXED = { water:47, land:58, local:60, gov:50 };
    const W = { energy:0.25, water:0.20, land:0.20, local:0.20, gov:0.15 };

    const els = {
      satLabel: q("[data-satlabel]"),
      mbLive: q('[data-mb="live"]'), nnLive: q('[data-nn="live"]'),
      eChips: qa('[data-pchip="energy"], [data-pchip2="energy"]'),
      eSub: qa('.mw-psub[data-pid="energy"], .mw-vsub[data-pid="energy"]'),
      aggBarE: q('[data-aggbar="energy"]'), aggNE: q('[data-aggn="energy"]'),
      finalChip: q("[data-final-chip]"), finalScore: q("[data-final-score]"),
      hudChip: q("[data-hud-chip]"), hudScore: q("[data-hud-score]"),
    };
    function satWord(s){ return s<25?satWords[0]:s<50?satWords[1]:s<80?satWords[2]:satWords[3]; }

    let prev=null;
    function render(){
      const s=parseInt(sat.value,10);
      const cap=100-s;                                  // more saturated → lower capacity note
      const energie=Math.round(0.6*cap + 0.1*85 + 0.1*40 + 0.1*60 + 0.1*55);
      const global=Math.round(W.energy*energie + W.water*FIXED.water + W.land*FIXED.land + W.local*FIXED.local + W.gov*FIXED.gov);
      const lE=letter(energie), lG=letter(global);
      if(els.satLabel) els.satLabel.textContent=satWord(s);
      if(els.mbLive){ els.mbLive.style.width=cap+"%"; els.mbLive.style.background=gvar(cap); }
      if(els.nnLive) els.nnLive.textContent=cap;
      els.eChips.forEach((c)=>setChip(c,lE));
      els.eSub.forEach((n)=>{ if(n) n.textContent=energie; });
      if(els.aggBarE){ els.aggBarE.style.width=energie+"%"; els.aggBarE.style.background=gvar(energie); }
      if(els.aggNE) els.aggNE.textContent=energie;
      if(els.finalScore) els.finalScore.textContent=global;
      if(els.hudScore) els.hudScore.textContent=global;
      setChip(els.finalChip,lG); setChip(els.hudChip,lG);
      if(lG!==prev){ [els.finalChip,els.hudChip].forEach((n)=>{ if(n){ n.classList.remove("mw-flash"); void n.offsetWidth; n.classList.add("mw-flash"); } }); prev=lG; }
    }
    sat.addEventListener("input", render);
    render();

    // Keep the sticky HUD only while the walkthrough is on screen — never cover the footer.
    const sec=document.querySelector(".mw"), hud=document.querySelector(".mw-hud");
    if(sec && hud && "IntersectionObserver" in window){
      new IntersectionObserver((ents)=>{ ents.forEach((e)=>hud.classList.toggle("mw-hud--off", !e.isIntersecting)); }, { rootMargin:"0px 0px -40px 0px" }).observe(sec);
    }
  })();
</script>

<style>
  .mw{ max-width:960px; margin:0 auto; padding:8px 0 40px; }
  .mw-eyebrow{ font-family:var(--font-mono); font-size:11.5px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); margin:0 0 10px; }
  .mw-h1{ font-size:clamp(28px,5vw,42px); font-weight:800; letter-spacing:-.025em; line-height:1.05; margin:0 0 8px; }
  .mw-dek{ font-size:clamp(15px,1.7vw,17px); color:var(--ink-soft); max-width:62ch; margin:0 0 22px; }
  .mw-honest{ display:grid; grid-template-columns:auto 1fr; gap:14px; align-items:start; background:#eef3fb; border:1px solid #cddcf1; border-radius:14px; padding:16px 18px; margin:0 0 20px; }
  .mw-honest .mw-mark{ width:30px; height:30px; border-radius:8px; display:grid; place-items:center; background:var(--accent); color:#fff; font-weight:800; }
  .mw-honest p{ margin:0; font-size:14px; line-height:1.55; color:#264a78; }
  .mw-honest b{ color:var(--ink); } .mw-honest a{ color:var(--accent); }
  .mw-storeys{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:0 0 32px; font-size:12.5px; color:var(--muted); }
  .mw-storeys b{ color:var(--ink); }
  .mw-k{ font-family:var(--font-mono); font-size:11px; background:var(--wash); border:1px solid var(--line); border-radius:6px; padding:3px 8px; color:var(--ink-soft); }
  .mw-ar{ color:var(--accent); font-weight:800; }

  .mw-step{ position:relative; padding:0 0 4px 52px; margin:0 0 30px; }
  .mw-step::before{ content:attr(data-n); position:absolute; left:0; top:-2px; width:34px; height:34px; border-radius:50%; display:grid; place-items:center; font-family:var(--font-mono); font-weight:700; font-size:15px; color:var(--accent); background:var(--paper); border:1.5px solid var(--line); }
  .mw-step:not(:last-of-type)::after{ content:""; position:absolute; left:16.5px; top:36px; bottom:-30px; width:1.5px; background:linear-gradient(var(--line),transparent); }
  .mw-step h2{ font-size:19px; font-weight:800; letter-spacing:-.01em; margin:2px 0 3px; }
  .mw-sub{ font-size:13.5px; color:var(--muted); margin:0 0 16px; max-width:66ch; } .mw-sub b{ color:var(--ink-soft); }

  .mw-toy{ background:var(--paper); border:1px solid var(--line); border-radius:14px; padding:16px 18px; box-shadow:0 14px 34px -22px rgba(16,42,67,.35); }
  .mw-toy-h{ display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; margin-bottom:12px; } .mw-toy-h strong{ font-size:16px; }
