      { id: "E5", label: { fr: "Approvisionnement réel (PPA, % EnR)", en: "Actual supply (PPA, % renewables)" }, val: { fr: "partiel", en: "partial" }, w: "×10 %", note: 55 },
    ] },
  { id: "water", label: { fr: "Eau", en: "Water" }, weight: 20, sub: 47, grade: "d",
    note: { fr: "moyenne des indicateurs", en: "mean of indicators" },
    indicators: [
      { id: "W1", label: { fr: "Stress hydrique de la zone", en: "Local water stress" }, val: { fr: "modéré", en: "moderate" }, w: "", note: 45 },
      { id: "W2", label: { fr: "État de la masse d'eau", en: "Water body status" }, val: { fr: "moyen", en: "moderate" }, w: "", note: 50 },
      { id: "W4", label: { fr: "Refroidissement + volume d'eau", en: "Cooling + water volume" }, val: { fr: "à eau", en: "water-cooled" }, w: "", note: 40 },
      { id: "W5", label: { fr: "WUE / source d'eau (auto-déclarés)", en: "WUE / water source (self-reported)" }, val: { fr: "partiel", en: "partial" }, w: "", note: 55 },
    ] },
  { id: "land", label: { fr: "Foncier & biodiversité", en: "Land & biodiversity" }, weight: 20, sub: 58, grade: "c",
    note: { fr: "moyenne des indicateurs", en: "mean of indicators" },
    indicators: [
      { id: "F1", label: { fr: "Distance aux zones protégées", en: "Distance to protected areas" }, val: { fr: "8 km", en: "8 km" }, w: "", note: 60 },
      { id: "F2", label: { fr: "Statut du sol (déjà artificialisé)", en: "Soil status (already artificialized)" }, val: { fr: "réemploi", en: "reuse" }, w: "", note: 70 },
      { id: "F3", label: { fr: "Continuités écologiques (TVB)", en: "Ecological corridors" }, val: { fr: "préservées", en: "preserved" }, w: "", note: 55 },
      { id: "F5", label: { fr: "Mesures ERC / récupération de chaleur", en: "Avoid-reduce-offset / heat recovery" }, val: { fr: "partielles", en: "partial" }, w: "", note: 47 },
    ] },
  { id: "local", label: { fr: "Impact local", en: "Local impact" }, weight: 20, sub: 60, grade: "c",
    note: { fr: "moyenne des indicateurs", en: "mean of indicators" },
    indicators: [
      { id: "L1", label: { fr: "Profil socio-économique de la commune", en: "Municipality socio-economic profile" }, val: { fr: "—", en: "—" }, w: "", note: 60 },
      { id: "L3", label: { fr: "Aléa technologique (Seveso proche)", en: "Technological hazard (nearby Seveso)" }, val: { fr: "aucun", en: "none" }, w: "", note: 68 },
      { id: "L6", label: { fr: "Niveau de contestation observé", en: "Observed level of opposition" }, val: { fr: "faible", en: "low" }, w: "", note: 65 },
      { id: "L7", label: { fr: "Position des élus (faits votés)", en: "Elected officials' position (voted facts)" }, val: { fr: "neutre", en: "neutral" }, w: "", note: 55 },
    ] },
  { id: "gov", label: { fr: "Transparence & gouvernance", en: "Transparency & governance" }, weight: 15, sub: 50, grade: "c",
    note: { fr: "moyenne des indicateurs", en: "mean of indicators" },
    indicators: [
      { id: "T1", label: { fr: "Concertation / consentement / gouvernance", en: "Consultation / consent / governance" }, val: { fr: "partielle", en: "partial" }, w: "", note: 45 },
      { id: "T2", label: { fr: "Transparence documentaire / dossier", en: "Documentation transparency / file" }, val: { fr: "correcte", en: "adequate" }, w: "", note: 55 },
    ] },
];

const T = {
  fr: {
    eyebrow: "Méthode · illustration",
    h1: "La note, pas à pas",
    dek: "Comment les faits d'un data center deviennent une lettre, de A à E. La note se fabrique en <b>deux étages</b> : des indicateurs font chaque pilier, les piliers font la note. <b>Dépliez un pilier</b> pour auditer sa note.",
    honest: "<b>Ceci est une illustration.</b> On montre l'<b>intuition</b> du calcul — le trajet des données jusqu'à une lettre — pas ses profondeurs. Les seuils exacts, le niveau de confiance et le plafonnement « annoncé ≤ prouvé » vivent dans la <a href=\"/fr/methodologie\">méthode complète</a>. Objectif : <b>comprendre, pas reproduire</b>. Les chiffres sont volontairement simples.",
    storeys: ["indicateurs", "piliers", "note A–E"],
    storeysTail: " — <b>deux agrégations</b>, l'une empilée sur l'autre.",
    s1h: "Le site-exemple", s1sub: "Un data center fictif — la matière première du calcul.",
    toyName: "Data Center Exemple",
    facts: ["réseau · <b>poste sous tension</b>", "carbone · <b>80 g/kWh</b>", "refroidissement · <b>à eau</b>", "foncier · <b>déjà bâti</b>", "zone protégée · <b>8 km</b>"],
    s2h: "Étage 1 — les indicateurs font chaque pilier",
    s2sub: "Chaque pilier agrège ses indicateurs. On en déplie <b>un seul</b> — Énergie, le plus lourd — pour voir sa note se fabriquer. <b>Le principe est le même pour les cinq</b> : dépliez-les si vous voulez.",
