// https://scoremydatacenter.org · independent data center acceptability-risk score
//
// "La note, pas à pas" — a PEDAGOGICAL walkthrough of how a grade is built, on a
// FICTIONAL toy site (zz-demo). Deliberately an EXPLAINER, never a calculator:
// real pillar names + weights + indicator names (all public, from methodology.json),
// but ILLUSTRATIVE values. The intuition, not the calibration. It sits next to the
// formal /methodology page (the reference) and must not contradict it — hence the
// real 5-pillar / 24-indicator structure. Doctrine (Franck 2026-07-30): transparent
// about the METHOD's shape, opaque about the exact calibration and the corpus.
interface Props { lang: "fr" | "en"; }
const { lang } = Astro.props;

// Real A–E scale (methodology.json grade_thresholds): A≥80 B≥65 C≥50 D≥35 E≥0.
// Real pillars + weights. Indicator VALUES below are illustrative; names are real.
const PILLARS = [
  { id: "energy", label: { fr: "Énergie", en: "Energy" }, weight: 25, open: true, sub: 48, grade: "d",
    note: { fr: "moyenne pondérée des indicateurs", en: "weighted mean of indicators" },
    indicators: [
      { id: "E2", label: { fr: "Capacité de raccordement au réseau", en: "Grid connection capacity" }, live: true, w: "×60 %" },
      { id: "E1", label: { fr: "Intensité carbone du réseau", en: "Grid carbon intensity" }, val: { fr: "80 g/kWh", en: "80 g/kWh" }, w: "×10 %", note: 85 },
      { id: "E3", label: { fr: "File d'attente de raccordement", en: "Connection queue" }, val: { fr: "18 mois", en: "18 months" }, w: "×10 %", note: 40 },
